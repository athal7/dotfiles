{{ range .packages.github_releases -}}
{{ $url := "" -}}
{{ if index . "tag" -}}
{{ $url = gitHubReleaseAssetURL .repo .tag .asset -}}
{{ else -}}
{{ $url = gitHubLatestReleaseAssetURL .repo .asset -}}
{{ end -}}
{{ if eq .target "Applications" -}}
[{{ printf "Applications/%s" .app | quote }}]
    type = {{ .type | quote }}
    url = {{ $url | quote }}
    stripComponents = 1
    refreshPeriod = {{ .refresh_period | quote }}


{{ else -}}
[{{ .target | quote }}]
    type = {{ .type | quote }}
    url = {{ $url | quote }}
    {{- if eq .type "archive-file" }}
    path = {{ .path | quote }}
    {{- end }}
    {{- if index . "executable" }}
    executable = true
    {{- end }}
    refreshPeriod = {{ .refresh_period | quote }}

{{ end -}}
{{ end -}}

[".local/bin/kb-git-activity"]
    type = "file"
    url = "https://raw.githubusercontent.com/athal7/kb/743dab44271bdb040678e6c13f95aaec740c5e4d/collectors/git_activity.py"
    executable = true
    refreshPeriod = "24h"
    [".local/bin/kb-git-activity".checksum]
        sha256 = "c4f59af51d2fa790994baaf6b8a28d2aa7a6e1c4c1980c8e7128078a67bc16df"
