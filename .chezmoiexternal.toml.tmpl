{{ range .packages.github_releases -}}
{{ $url := "" -}}
{{ if index . "tag" -}}
{{ $url = gitHubReleaseAssetURL .repo .tag .asset -}}
{{ else -}}
{{ $url = gitHubLatestReleaseAssetURL .repo .asset -}}
{{ end -}}
{{ if eq .target "Applications" -}}
[{{ printf "Applications/%s" .app | quote }}]
    type = {{ .type | quote }}
    url = {{ $url | quote }}
    stripComponents = 1
    {{- if index . "checksum" }}
    [{{ printf "Applications/%s" .app | quote }}.checksum]
        sha256 = {{ .checksum | quote }}
    {{- end }}
    {{- if index . "refresh_period" }}
    refreshPeriod = {{ .refresh_period | quote }}
    {{- end }}

{{ else -}}
[{{ .target | quote }}]
    type = {{ .type | quote }}
    url = {{ $url | quote }}
    {{- if eq .type "archive-file" }}
    path = {{ .path | quote }}
    {{- end }}
    {{- if index . "executable" }}
    executable = true
    {{- end }}
    {{- if index . "checksum" }}
    [{{ .target | quote }}.checksum]
        sha256 = {{ .checksum | quote }}
    {{- end }}
    {{- if index . "refresh_period" }}
    refreshPeriod = {{ .refresh_period | quote }}
    {{- end }}

{{ end -}}
{{ end -}}
{{ range .packages.github_files -}}
{{ $url := printf "https://raw.githubusercontent.com/%s/%s/%s" .repo .ref .path -}}
[{{ .target | quote }}]
    type = "file"
    url = {{ $url | quote }}
    {{- if index . "checksum" }}
    [{{ .target | quote }}.checksum]
        sha256 = {{ .checksum | quote }}
    {{- end }}

{{ end -}}
