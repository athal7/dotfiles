providers:
  otari:
    baseUrl: https://api.otari.ai/api/v1
    api: openai-completions
    apiKey: OTARI_API_KEY
    discovery:
      type: openai-models-list
      injectV1: false
  openjev:
    baseUrl: http://127.0.0.1:8091
    api: typesafe
    auth: none
    models:
      - id: openjev-latest
        name: OpenJev
        reasoning: false
        input: [text, image]
        contextWindow: 32768
        maxTokens: 1
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
