{{- $servers := dict -}}
{{- range $server := .mcp_servers -}}
{{-   if or (not (hasKey $server "kb_enrich")) $server.kb_enrich -}}
{{-     $entry := dict -}}
{{-   $_ := set $entry "enabled" true -}}
{{-   if eq $server.transport "local" -}}
{{-     $_ := set $entry "command" (first $server.command) -}}
{{-     $_ := set $entry "args" (rest $server.command) -}}
{{-   else -}}
{{-     $_ := set $entry "type" "http" -}}
{{-     $url := $server.url -}}
{{-     if kindIs "map" $url -}}{{- $url = printf "${%s}" (index $url "name") -}}{{- end -}}
{{-     $_ := set $entry "url" $url -}}
{{-     if hasKey $server "headers" -}}
{{-       $headers := dict -}}
{{-       range $headerName, $headerSpec := $server.headers -}}
{{-         $value := "" -}}
{{-         if hasKey $headerSpec "value" -}}
{{-           $value = $headerSpec.value | toString -}}
{{-         else -}}
{{-           $value = output "sh" "-c" $headerSpec.cmd | trim -}}
{{-           if ne $value "" -}}
{{-             $value = printf $headerSpec.format $value -}}
{{-           end -}}
{{-         end -}}
{{-         if ne $value "" -}}
{{-           $_ := set $headers $headerName $value -}}
{{-         end -}}
{{-     end -}}
{{- if gt (len $headers) 0 -}}
{{- $_ := set $entry "headers" $headers -}}
{{- end -}}
{{-   end -}}
{{- end -}}
{{-   $_ := set $servers $server.name $entry -}}
{{-   end -}}
{{- end -}}
{{ dict "mcpServers" $servers | toJson }}
