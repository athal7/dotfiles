extensions: {{ if .omp_approval_extension_paths }}{{ toJson .omp_approval_extension_paths }}{{ else }}["{{ .chezmoi.homeDir }}/.local/share/omp/extensions/agent-of-empires.ts"]{{ end }}
advisor:
  enabled: true
  immuneTurns: 0
  maxNotesPerUpdate: 1
astGrep:
  enabled: true
autoResume: false
autolearn:
  enabled: false
bash:
  autoBackground:
    enabled: true
  allowCompoundCommands: false
  patterns:
    # Approval policy: prompt only when the command reaches another person
    # (comments, reviews, ready or merged PRs, releases, deploys) or destroys
    # shared state. Read-only, local, and draft-scoped GitHub work runs
    # unattended. First match wins; unmatched commands keep the `bash: allow`
    # baseline in tools.approval, so this list is the whole prompt surface.
    #
    # Native approvals cannot inspect arguments or remote PR state, so
    # draft-scoped shapes are matched by their flags. Push is always allowed.
    - match: "gh pr create*--draft*"
      approval: allow
    - match: "gh stack submit*--auto*"
      approval: allow
    # Person-visible GitHub writes notify reviewers, assignees, or watchers.
    - match: "gh pr create*"
      approval: prompt
    - match: "gh pr comment*"
      approval: prompt
    - match: "gh pr review*"
      approval: prompt
    - match: "gh pr merge*"
      approval: prompt
    - match: "gh pr ready*"
      approval: prompt
    - match: "gh pr edit*"
      approval: prompt
    - match: "gh pr close*"
      approval: prompt
    - match: "gh pr reopen*"
      approval: prompt
    - match: "gh issue comment*"
      approval: prompt
    - match: "gh issue edit*"
      approval: prompt
    - match: "gh issue close*"
      approval: prompt
    - match: "gh issue reopen*"
      approval: prompt
    - match: "gh issue transfer*"
      approval: prompt
    - match: "gh release create*"
      approval: prompt
    - match: "gh release edit*"
      approval: prompt
    - match: "gh release delete*"
      approval: prompt
    - match: "gh workflow run*"
      approval: prompt
    - match: "gh secret set*"
      approval: prompt
    - match: "gh secret delete*"
      approval: prompt
    - match: "gh repo edit*"
      approval: prompt
    - match: "gh repo delete*"
      approval: prompt
    # gh api writes are argument-shaped; only the read shapes stay silent.
    - match: "gh api*--method *"
      approval: prompt
    - match: "gh api*-X *"
      approval: prompt
    - match: "gh api*--field*"
      approval: prompt
    - match: "gh api*-f *"
      approval: prompt
    - match: "gh api*-F *"
      approval: prompt
    - match: "gh api*--input*"
      approval: prompt
    # Interactive submit defaults new PRs to ready; --auto keeps them draft.
    - match: "gh stack submit*"
      approval: prompt
    - match: "gh stack merge*"
      approval: prompt
    # The dotfiles ship command eventually pushes main.
    - match: "chezmoi-deploy*"
      approval: prompt
    - match: "gh *"
      approval: allow
