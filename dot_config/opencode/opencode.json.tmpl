{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "127.0.0.1"
  },
  "plugin": [
    ["./lib/skill-inject.ts", {
      "architecture": ["code-quality"],
      "communication": ["knowledge-base"],
      "elasticsearch": [{"skill": "xh", "context": "All requests use xh --ignore-stdin --session=agent for auth"}],
      "pagerduty": [{"skill": "xh", "context": "All requests use xh --ignore-stdin --session=agent for auth"}],
      "push": ["commit"]
    }],
    "@tarquinen/opencode-dcp@3.1.12",
    "opencode-permission-log"
  ],
  {{- /* default_agent, agent, tools, mcp, model, small_model, and the
  permission.{bash,read,edit,write,task,skill,webfetch} leaves are all
  managed by `agentcfg apply --target opencode`
  (.chezmoiscripts/run_onchange_after_agentcfg-apply.sh.tmpl), sourced from
  dot_config/agentcfg/. grep/glob/lsp/websearch have no registry-level
  concept in agentcfg (see internal/render/opencode/vocab.go's
  unsupportedCanonicals) and external_directory has no *global* registry
  field (only per-agent) — see dot_config/agentcfg/agents.yaml.tmpl's
  `&extdirs` anchor for the per-agent equivalent that superseded this
  file's old global external_directory default. */ -}}
  "permission": {
    "grep": {{ .permissions.grep | quote }},
    "glob": {{ .permissions.find | quote }},
    "lsp": "allow",
    "websearch": "allow"
  },
  "compaction": {
    "prune": true
  },
  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-5": {
          "options": {
            "thinking": {
              "type": "adaptive",
              "display": "summarized"
            }
          }
        },
        "claude-sonnet-5": {
          "options": {
            "thinking": {
              "type": "adaptive",
              "display": "summarized"
            }
          }
        }
      }
    },
    {{ .local_model.provider | quote }}: {
      "npm": "@ai-sdk/openai-compatible",
      "name": "mlx-lm",
      "options": {
        "baseURL": "http://{{ .local_model.host }}:{{ .local_model.port }}/v1"
      },
      "models": {
        {{ .local_model.id | quote }}: {
          "name": {{ .local_model.name | quote }}
        }
      }
    }
  },
  "formatter": {
    "rubocop": { "disabled": true },
    "ruff": { "disabled": true }
  },
  "lsp": {
    "ruby-lsp": {
      "command": ["ruby", "-S", "ruby-lsp"],
      "extensions": [".rb", ".rake", ".gemspec", ".ru"]
    }
  }
}
