#!/usr/bin/env python3
# Preserve Freebuff's other settings while choosing an unlimited model.
import json
import sys

contents = sys.stdin.read()
settings = json.loads(contents) if contents.strip() else {}
settings["freebuffModel"] = "upstage/solar-mini4"
settings.pop("freebuffModelKey", None)
print(json.dumps(settings, indent=2))
