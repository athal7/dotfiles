#!/usr/bin/env python3
# Prefer the catalog's DeepSeek Flash Slow row; keep a standard Flash fallback.
import json
import sys

contents = sys.stdin.read()
settings = json.loads(contents) if contents.strip() else {}
settings["freebuffModel"] = "deepseek/deepseek-v4-flash"
settings["freebuffModelKey"] = "m-61c26317cc"
print(json.dumps(settings, indent=2))
