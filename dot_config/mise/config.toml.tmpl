[tools]
{{- range .packages.mise }}
{{- $spec := .version | quote -}}
{{- $extra := "" -}}
{{- if hasKey . "allow_builds" -}}
{{- $extra = printf ", allow_builds = %s" (.allow_builds | toJson) -}}
{{- end -}}
{{- if hasKey . "trust_policy_excludes" -}}
{{- $extra = printf "%s, trust_policy_excludes = %s" $extra (.trust_policy_excludes | toJson) -}}
{{- end -}}
{{- if hasKey . "postinstall" -}}
{{- $extra = printf "%s, postinstall = %s" $extra (.postinstall | quote) -}}
{{- end -}}
{{- if ne $extra "" -}}
{{- $spec = printf "{ version = %s%s }" $spec $extra -}}
{{- end }}
{{ if contains ":" .name }}{{ .name | quote }}{{ else }}{{ .name }}{{ end }} = {{ $spec }}
{{- end }}

[settings]
idiomatic_version_file_enable_tools = ["ruby"]
