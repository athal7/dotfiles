wtf:
  colors:
    background: "black"
    border:
      focusable: "darkslateblue"
      focused: "orange"
      normal: "gray"
    text: "white"
    title: "white"
  grid:
    # 4 columns, each 40 terminal characters wide
    columns: [40, 40, 40, 40]
    # 2 rows, each 12 lines high
    rows: [12, 12]
  navigation:
    shortcuts: true

  # WTF modules must be nested under the `mods` block
  mods:
    # Build-in GitHub Module
    github:
      enabled: true
      apiKey: "" # Falls back to WTF_GITHUB_TOKEN or GITHUB_TOKEN env var
      username: "{{- if and (hasKey . "wtf") (hasKey .wtf "github") (hasKey .wtf.github "username") }}{{ .wtf.github.username }}{{- else if hasKey . "githubUsername" }}{{ .githubUsername }}{{- else if hasKey . "email" }}{{ .email | splitList "@" | first }}{{- else }}athal7{{- end }}"
      repositories:
        {{- if and (hasKey . "wtf") (hasKey .wtf "github") (hasKey .wtf.github "repositories") }}
        {{- range .wtf.github.repositories }}
        - "{{ . }}"
        {{- end }}
        {{- else if hasKey . "githubRepositories" }}
        {{- range .githubRepositories }}
        - "{{ . }}"
        {{- end }}
        {{- else }}
        - "athal7/dotfiles"
        - "athal7/kb"
        {{- end }}
      {{- if and (hasKey . "wtf") (hasKey .wtf "github") (hasKey .wtf.github "customQueries") }}
      customQueries:
        {{- range $key, $value := .wtf.github.customQueries }}
        {{ $key }}:
          title: "{{ $value.title }}"
          filter: "{{ $value.filter }}"
          enabled: {{ if hasKey $value "enabled" }}{{ $value.enabled }}{{ else }}true{{ end }}
        {{- end }}
      {{- else }}
      customQueries:
        openPRs:
          title: "My PRs"
          filter: "is:open is:pr author:{{- if and (hasKey . "wtf") (hasKey .wtf "github") (hasKey .wtf.github "username") }}{{ .wtf.github.username }}{{- else if hasKey . "githubUsername" }}{{ .githubUsername }}{{- else if hasKey . "email" }}{{ .email | splitList "@" | first }}{{- else }}athal7{{- end }}"
          enabled: true
        myIssues:
          title: "Assigned Issues"
          filter: "is:open is:issue assignee:{{- if and (hasKey . "wtf") (hasKey .wtf "github") (hasKey .wtf.github "username") }}{{ .wtf.github.username }}{{- else if hasKey . "githubUsername" }}{{ .githubUsername }}{{- else if hasKey . "email" }}{{ .email | splitList "@" | first }}{{- else }}athal7{{- end }}"
          enabled: true
      {{- end }}
      refreshInterval: 15m
      position:
        top: 0
        left: 0
        height: 1
        width: 2

    # Calendar Widget via cmdrunner
    calendar:
      enabled: true
      type: "cmdrunner"
      title: "📅 Calendar"
      cmd: "wtf-calendar"
      args: []
      refreshInterval: 5m
      position:
        top: 0
        left: 2
        height: 1
        width: 2

    # Linear Widget via cmdrunner
    linear:
      enabled: true
      type: "cmdrunner"
      title: "🎯 Linear"
      cmd: "wtf-linear"
      args: []
      refreshInterval: 5m
      position:
        top: 1
        left: 0
        height: 1
        width: 2

    # Reminders Widget via cmdrunner
    reminders:
      enabled: true
      type: "cmdrunner"
      title: "📝 Reminders"
      cmd: "wtf-reminders"
      args: []
      refreshInterval: 5m
      position:
        top: 1
        left: 2
        height: 1
        width: 2
