{{- $runlayerEnvironment := list -}}
{{- if hasKey . "runlayer" -}}
{{-   range $key := keys .runlayer | sortAlpha -}}
{{-     $url := index $.runlayer $key -}}
{{-     if and (hasSuffix "_mcp_url" $key) (kindIs "string" $url) (ne $url "") -}}
{{-       $name := upper (trimSuffix "_mcp_url" $key) -}}
{{-       $runlayerEnvironment = append $runlayerEnvironment (printf "RUNLAYER_%s_MCP_URL=%s" $name $url) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $environment := append $runlayerEnvironment (printf "PI_CODING_AGENT_DIR=%s/.config/omp/agent" .chezmoi.homeDir) -}}
environment = {{ $environment | toToml }}
default_profile = ""

[acp]
allow_agent_install = false
allowed_agents = ["omp"]
auto_stop_idle_secs = 0
compaction_reminder = false
compaction_reminder_percent = 75
default_agent = "omp"
max_concurrent_workers = 10
node_path = ""
notice_display = "persistent"
notice_timeout_secs = 10
rate_limit_auto_resume = false
replay_events = 0
restrict_agents = false
show_tool_durations = true
silent_orphan_grace_secs = 120
# Use the terminal TUI for new sessions and disable the structured-view option.
structured_view = "off"
wrap_tool_output = false

[auth]
persist_sessions = true

[diff]
context_lines = 3
split_view = false

[hooks]

[host_hooks]
before_session = ['if [ "$AOE_TOOL" = omp ]; then "$HOME/.local/bin/aoe-omp-environment"; fi', '"$HOME/.local/bin/aoe-pr-track"']
before_start = ['"$HOME/.local/bin/aoe-pr-track"']

[logging]
default_level = "info"
file_path = "debug.log"
keep_count = 5
max_size_mib = 50
output = "file"
rotation = "size"
show_spans = false

[logging.targets]

# Manage portable plugin declarations; preserve local plugins and approval receipts.
{{ $plugins := dict "aoe.web" (dict "enabled" true) -}}
{{ range .packages.aoe_plugins -}}
{{ $_ := set $plugins .id (dict "enabled" true "source" .source) -}}
{{ end -}}
# Ignore bot-authored review-state signals, not unresolved-thread counts.
{{ $ignoredCommenters := list "coderabbitai" "codecov" "chatgpt-codex-connector" "github-code-quality" -}}
{{ range $org := (get . "orgs" | default dict) -}}
{{ $bot := dig "automated_review" "bot_login" "" $org | trim | lower | trimSuffix "[bot]" -}}
{{ if ne $bot "" }}{{ $ignoredCommenters = append $ignoredCommenters $bot }}{{ end -}}
{{ end -}}
{{ $linearSettings := dict "include_snoozed" true -}}
{{ $configPath := joinPath .chezmoi.homeDir ".config/agent-of-empires/config.toml" -}}
{{ if stat $configPath -}}
{{ $existing := include $configPath | fromToml -}}
{{ range $id, $plugin := $existing.plugins -}}
{{ if hasKey $plugins $id -}}
{{ if hasKey $plugin "grant" -}}
{{ $_ := set (index $plugins $id) "grant" $plugin.grant -}}
{{ end -}}
{{ if hasKey $plugin "settings" -}}
{{ if eq $id "community.linear" -}}
{{ $linearSettings = mergeOverwrite (deepCopy $plugin.settings) $linearSettings -}}
{{ else if eq $id "agent-of-empires.github" -}}
{{ else -}}
{{ $_ := set (index $plugins $id) "settings" $plugin.settings -}}
{{ end -}}
{{ end -}}
{{ if eq $id "agent-of-empires.github" -}}
{{ range $login := regexSplit "[,[:space:]]+" (dig "settings" "ignored_commenters" "" $plugin) -1 -}}
{{ $bot := $login | trim | lower | trimSuffix "[bot]" -}}
{{ if ne $bot "" }}{{ $ignoredCommenters = append $ignoredCommenters $bot }}{{ end -}}
{{ end -}}
{{ end -}}
{{ else -}}
{{ $_ := set $plugins $id $plugin -}}
{{ end -}}
{{ end -}}
{{ end -}}
{{ $_ := set (index $plugins "community.linear") "settings" $linearSettings -}}
{{ $githubSettings := dict -}}
{{ if stat $configPath -}}
{{ $githubSettings = deepCopy (dig "plugins" "agent-of-empires.github" "settings" (dict) (include $configPath | fromToml)) -}}
{{ end -}}
# Keep PR state (and its row glyph) on snoozed rows. Opt-in upstream in #143, merged
# 2026-11-06 but not in a release yet, so the installed plugin ignores the key until
# the next update; leave it on so the first release that honours it needs no edit.
{{ $_ := set (index $plugins "agent-of-empires.github") "settings" (mergeOverwrite $githubSettings (dict "ci_required_checks_only" true "dense_row_badge_glyphs" true "ignore_bot_approval_recommendations" true "include_snoozed_sessions" true "ignored_commenters" ($ignoredCommenters | uniq | sortAlpha | join ", "))) -}}
{{ dict "plugins" $plugins | toToml }}


[sandbox]
allow_image_pull = true
auto_cleanup = true
container_runtime = "apple_container"
default_image = "ghcr.io/agent-of-empires/aoe-sandbox:latest"
default_terminal_mode = "host"
enabled_by_default = false
environment = ["TERM", "COLORTERM", "FORCE_COLOR", "NO_COLOR"]
extra_volumes = []
mount_ssh = false
privileged = false
selinux_relabel = false
volume_ignores = []
volume_ignores_strategy = "anonymous"

[session]
agent_status_hooks = true
auto_resume_on_restart = true
auto_stop_idle_secs = 0
click_action = "live_send"
confirm_before_quit = true
confirm_delete = false
conversation_summary = true
default_attach_mode = "tmux"
default_tool = "omp"
delete_to_trash = false
favorites_first = true
host_tab_title = true
inherit_host_environment = false
live_send_exit_chord = "C-q"
live_send_leader = "C-b"
live_send_on_view_switch = true
merge_hooks_into_selected_agent = true
mouse_capture = true
name_agent_session = false
opencode_preassign_session_id = false
pre_trust_agent_folders = false
prevent_sleep_idle_grace_minutes = 15
new_session_mode = "live_send"
prevent_sleep_when_active = true
preview_link_prefixes = []
restart_wake_message = "wake up: pick up what you were doing"
row_tag = "none"
scratch_smart_rename = "inherit"
session_id_poller_max_threads = 50
show_activity_age = true
show_session_colors = false
show_diagnostics_pane = false
show_shortcut_bar = false
show_tips = false
snooze_duration_minutes = 30
sidebar_position = "left"
smart_rename = true
smart_rename_agent = ""
# The paired terminal split is unwanted. It renders only when the whole window is at
# least this tall and wide, so both thresholds at the documented maximum keep it hidden
# at any window size while Terminal view and the toggle keep working; lower them to
# bring it back. split_terminal_height_percent is moot while it cannot render.
split_terminal_min_height = 1000
split_terminal_min_width = 1000
startup_recovery_wake = false
strict_hotkeys = false
tie_workdir_to_name = true
trash_retention_minutes = 43200
unread_indicator = true
yolo_mode_default = false

[session.custom_agents]
freebuff = "freebuff"

[skills]
auto_propagate = false

[sound]
browser_approval_enabled = true
browser_enabled = true
browser_error_enabled = true
browser_idle_enabled = true
browser_waiting_enabled = true
enabled = false
server_enabled = true
server_error_enabled = true
server_idle_enabled = true
server_running_enabled = true
server_start_enabled = true
server_waiting_enabled = true

[status_hooks]
enabled = false

[systemd]
enabled = true
slice = "background-aoe-{profile}.slice"
survive_daemon_restart = true
tasks_max = 0

[telemetry]
enabled = false

[theme]
color_mode = "truecolor"
idle_decay_minutes = 0
name = "zinc"

[tmux]
clipboard = "auto"
mouse = "auto"
status_bar = "auto"
vt_live = true

[updates]
auto_update_plugins = true
update_check_mode = "notify"
[web]
mcp_enabled = true
notifications_enabled = true
notify_on_error = true
notify_on_idle = true
notify_on_waiting = true
notify_on_wake_fire = true

[worktree]
auto_cleanup = true
bare_repo_path_template = "./{branch}"
delete_branch_on_cleanup = true
enabled = true
init_submodules = true
path_template = "{{ .chezmoi.homeDir }}/code/.worktrees/{repo-name}/{branch}"
workspace_path_template = "{{ .chezmoi.homeDir }}/code/.worktrees/workspaces/{branch}-workspace-{session-id}"
