# launchd LaunchAgent definitions — single source of truth for all plists.
#
# Each entry's value is the plist payload expressed as YAML, using $HOME and
# $USER placeholders (substituted with the real home directory and username at
# apply time). The source template `.chezmoiscripts/run_onchange_after_zz-launch-agents.sh.tmpl`
# is rendered and run by chezmoi during apply. It delegates to `launchd-yaml apply`,
# which renders plist files, writes each plist to
# ~/Library/LaunchAgents/<name>.plist, reloads only agents whose plist content
# changed, and removes agents that were deleted from this file. The individual
# plists are NOT individually chezmoi-managed.
#
# Typing matters — YAML integers become plist <integer>, YAML booleans become
# <true/>/<false/>. ProgramArguments are always strings, so numeric args
# (timeouts, ports) must be quoted.
launchagents:
  aoe-serve:
    Label: com.$USER.aoe-serve
    ProgramArguments:
      - $HOME/.local/bin/aoe-serve
    RunAtLoad: true
    KeepAlive: true
    ProcessType: Interactive
    StandardOutPath: $HOME/Library/Logs/aoe-serve.log
    StandardErrorPath: $HOME/Library/Logs/aoe-serve.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
{{ template "omp-launchd-env" . }}


  aoe-daily-maintenance:
    Label: com.$USER.aoe-daily-maintenance
    ProgramArguments:
      - $HOME/.local/bin/aoe-scheduled-session
      - daily-maintenance
      - $HOME/.agents/prompts/daily-maintenance.md
    StartCalendarInterval:
      - Weekday: 1
        Hour: 20
        Minute: 0
      - Weekday: 2
        Hour: 20
        Minute: 0
      - Weekday: 3
        Hour: 20
        Minute: 0
      - Weekday: 4
        Hour: 20
        Minute: 0
      - Weekday: 5
        Hour: 20
        Minute: 0
    StandardOutPath: $HOME/Library/Logs/aoe-daily-maintenance.log
    StandardErrorPath: $HOME/Library/Logs/aoe-daily-maintenance.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
      AOE_OMP_PROJECT_MCP_CONFIG: $HOME/.config/omp/agent/kb-enrich-mcp.json
      AOE_OMP_MODEL: "@smol"
{{ template "omp-launchd-env" . }}

  brew-maintenance:
    Label: com.$USER.brew-maintenance
    ProgramArguments:
      - $HOME/.local/bin/brew-maintenance
    StartCalendarInterval:
      Hour: 4
      Minute: 0
    StandardOutPath: $HOME/Library/Logs/brew-maintenance.log
    StandardErrorPath: $HOME/Library/Logs/brew-maintenance.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

  babysitter-check:
    Label: com.$USER.babysitter-check
    ProgramArguments:
      - $HOME/.local/share/mise/shims/cal-automation
      - babysitter
    StartCalendarInterval:
      Hour: 8
      Minute: 0
    StandardOutPath: $HOME/Library/Logs/babysitter-check.log
    StandardErrorPath: $HOME/Library/Logs/babysitter-check.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

  check-error-logs:
    Label: com.$USER.check-error-logs
    ProgramArguments:
      - $HOME/.local/bin/check-error-logs
      - $HOME/.agents/prompts/fix-launchagent-errors.md
    StartCalendarInterval:
      Hour: 9
      Minute: 0
    StandardOutPath: $HOME/Library/Logs/check-error-logs.log
    StandardErrorPath: $HOME/Library/Logs/check-error-logs.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin


  family-scheduler:
    Label: com.$USER.family-scheduler
    ProgramArguments:
      - $HOME/.local/share/mise/shims/cal-automation
      - family
    StartCalendarInterval:
      Weekday: 2
      Hour: 8
      Minute: 0
    StandardOutPath: $HOME/Library/Logs/family-scheduler.log
    StandardErrorPath: $HOME/Library/Logs/family-scheduler.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin


  git-worktree-sync:
    Label: com.$USER.git-worktree-sync
    ProgramArguments:
      - $HOME/.local/bin/git-worktree-sync
    StartInterval: 900
    StandardOutPath: $HOME/Library/Logs/git-worktree-sync.log
    StandardErrorPath: $HOME/Library/Logs/git-worktree-sync.error.log
    EnvironmentVariables:
      PATH: /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

  homebridge:
    Label: com.$USER.homebridge
    ProgramArguments:
      - $HOME/.local/share/mise/installs/node/24.14.0/bin/homebridge
      - -U
      - $HOME/.config/homebridge
    RunAtLoad: true
    KeepAlive: true
    WorkingDirectory: $HOME/.config/homebridge
    StandardOutPath: $HOME/Library/Logs/homebridge.log
    StandardErrorPath: $HOME/Library/Logs/homebridge.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
      HOME: $HOME
      UIX_STORAGE_PATH: $HOME/.config/homebridge


  openjev:
    Label: com.$USER.openjev
    ProgramArguments:
      - $HOME/.local/share/openjev/venv/bin/python
      - -m
      - openjev
    RunAtLoad: true
    KeepAlive: true
    ProcessType: Interactive
    StandardOutPath: $HOME/Library/Logs/openjev.log
    StandardErrorPath: $HOME/Library/Logs/openjev.error.log
    EnvironmentVariables:
      HOME: $HOME
      HF_HUB_DISABLE_XET: "1"
      OPENJEV_BACKEND: mlx
      OPENJEV_HOST: 127.0.0.1
      OPENJEV_PORT: "8091"
      OPENJEV_MLX_CACHE_LIMIT_GB: "4"

  naya-sync:
    Label: com.$USER.naya-sync
    ProgramArguments:
      - $HOME/.local/bin/naya-sync
    WatchPaths:
      - $HOME/Library/Application Support/NayaFlow/user-data.db
      - $HOME/Library/Application Support/NayaFlow-Beta/user-data-beta.db
    StandardOutPath: $HOME/Library/Logs/naya-sync.log
    StandardErrorPath: $HOME/Library/Logs/naya-sync.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
      HOME: $HOME


  setenv-gui-path:
    Label: com.$USER.setenv-gui-path
    ProgramArguments:
      - /bin/launchctl
      - setenv
      - PATH
      - $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
    RunAtLoad: true
    LimitLoadToSessionType: Aqua

  setenv-gui-omp-config:
    Label: com.$USER.setenv-gui-omp-config
    ProgramArguments:
      - /bin/launchctl
      - setenv
      - PI_CODING_AGENT_DIR
      - $HOME/.config/omp/agent
    RunAtLoad: true
    LimitLoadToSessionType: Aqua
  setenv-gui-omp-root:
    Label: com.$USER.setenv-gui-omp-root
    ProgramArguments:
      - /bin/launchctl
      - setenv
      - PI_CONFIG_DIR
      - .config/omp
    RunAtLoad: true
    LimitLoadToSessionType: Aqua
  setenv-gui-xdg-data:
    Label: com.$USER.setenv-gui-xdg-data
    ProgramArguments:
      - /bin/launchctl
      - setenv
      - XDG_DATA_HOME
      - $HOME/.local/share
    RunAtLoad: true
    LimitLoadToSessionType: Aqua


  colima:
    Label: com.$USER.colima
    ProgramArguments:
      - /opt/homebrew/bin/colima
      - start
      - --foreground
      - --activate=false
      - --memory
      - "4"
      - --disk
      - "30"
    RunAtLoad: true
    KeepAlive: true
    StandardOutPath: $HOME/Library/Logs/colima.log
    StandardErrorPath: $HOME/Library/Logs/colima.error.log
    EnvironmentVariables:
      HOME: $HOME
      PATH: /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

  sync-calendars:
    Label: com.$USER.sync-calendars
    ProgramArguments:
      - $HOME/.local/share/mise/shims/cal-automation
      - sync
    StartInterval: 3600
    RunAtLoad: true
    StandardOutPath: $HOME/Library/Logs/sync-calendars.log
    StandardErrorPath: $HOME/Library/Logs/sync-calendars.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

  workspace-cleanup:
    Label: com.$USER.workspace-cleanup
    ProgramArguments:
      - $HOME/.local/bin/workspace-cleanup
      - --apply
    StartCalendarInterval:
      Weekday: 0
      Hour: 3
      Minute: 30
    StandardOutPath: $HOME/Library/Logs/workspace-cleanup.log
    StandardErrorPath: $HOME/Library/Logs/workspace-cleanup.error.log
    EnvironmentVariables:
      PATH: $HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin
