{{- /* Renders Attention config from shared calendar/reminder data. Only
   reminder lists flagged attention_check: true are included.
   The Linear API token is baked in from the macOS keychain at apply time
   (never persisted anywhere else); the Attention tool itself has no
   keychain dependency, it just reads linear.apiToken from this file.
   Session and lumen hotkeys were removed from the bundled plugins upstream
   (hardcoded tool deps) and are restored here as configured actions. */ -}}
{{- $remLists := list -}}
{{- if hasKey . "reminders" -}}
{{- range $k, $v := .reminders -}}
{{- if and (kindIs "map" $v) (dig "attention_check" false $v) -}}
{{- $remLists = append $remLists (dig "name" "" $v) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $workReminderLists := list -}}
{{- if and (hasKey . "reminders") (kindIs "map" .reminders) -}}
{{- $workReminder := get .reminders "work" -}}
{{- if and (kindIs "map" $workReminder) (dig "attention_check" false $workReminder) -}}
{{- $workReminderLists = append $workReminderLists (dig "name" "" $workReminder) -}}
{{- end -}}
{{- end -}}
{{- $linearToken := output "/bin/sh" "-c" "security find-generic-password -s chezmoi -a linear_api_key -w 2>/dev/null || true" | trim -}}
{{- $workGitHubPrefixes := list -}}
{{- $sessionAgents := list -}}
{{- if hasKey . "orgs" -}}
{{- range $org, $settings := .orgs -}}
{{- if kindIs "map" $settings -}}
{{- if eq (dig "attention" "" $settings) "Work" -}}
{{- $workGitHubPrefixes = append $workGitHubPrefixes (printf "%s/" $org) -}}
{{- else -}}
{{- $sessionAgents = append $sessionAgents (dict "repo" (printf "%s/*" $org) "tool" "freebuff") -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $workMatches := list (dict "plugins" (list "linear")) -}}
{{- if gt (len $workGitHubPrefixes) 0 -}}
{{- $workMatches = append $workMatches (dict "plugins" (list "github") "contextPrefixes" $workGitHubPrefixes) -}}
{{- end -}}
{{- if gt (len $workReminderLists) 0 -}}
{{- $workMatches = append $workMatches (dict "plugins" (list "reminders") "contexts" $workReminderLists) -}}
{{- end -}}
{{- $workMatch := dict "any" $workMatches -}}
{{- $groups := list
      (dict "name" "Work" "match" $workMatch)
      (dict "name" "Open source" "match" (dict "plugins" (list "github")))
      (dict "name" "Everything else" "fallback" true) -}}
{{- $config := dict
      "codeDir" .codeDir
      "session" (dict "agents" $sessionAgents)
      "plugins" (list "reminders" "github" "linear")
      "dashboard" (dict "groups" $groups)
      "reminders" (dict "lists" $remLists "actions" (list
        (dict "key" "s" "label" "session" "background" true
              "command" (list "attention-session" "scratch" "{title}" "{input}")
              "input" (dict "prompt" "Session message" "default" "Help me do the work to complete reminder {title}"))))
      "github" (dict "actions" (list
        (dict "key" "s" "label" "session" "background" true
              "command" (list "attention-session" "github" "{repo_path}" "{id}" "{slug}" "{slug}" "For issue/PR {id} in this repo, {session_prompt}" "{input}" "{repo}")
              "input" (dict "prompt" "Additional session content (optional)" "default" ""))
        (dict "key" "l" "label" "lumen"
              "command" (list "lumen" "diff" "{url}"))))
      "linear" (dict
        "apiToken" $linearToken
        "actions" (list
          (dict "key" "s" "label" "session" "background" true
                "command" (list "attention-session" "scratch" "{identifier_lower}" "{input}")
                "input" (dict "prompt" "Session message" "default" "Work on Linear issue {identifier}"))))
-}}
{{ $config | toPrettyJson }}
