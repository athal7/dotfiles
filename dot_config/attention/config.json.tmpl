{{- /* Renders the attention CLI's config from the same calendars/reminders
   data other tools share (see local.yaml.example) -- only entries flagged
   attention_check: true contribute a calendar/reminder-list name here.
   The Linear API token is baked in from the macOS keychain at apply time
   (never persisted anywhere else); the attention tool itself has no
   keychain dependency, it just reads linear.apiToken from this file.
   Session and lumen hotkeys were removed from the bundled plugins upstream
   (hardcoded tool deps) and are restored here as configured actions. */ -}}
{{- $calNames := list -}}
{{- if hasKey . "calendars" -}}
{{- range $k, $v := .calendars -}}
{{- if and (kindIs "map" $v) (dig "attention_check" false $v) -}}
{{- $calNames = append $calNames (dig "name" "" $v) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $remLists := list -}}
{{- if hasKey . "reminders" -}}
{{- range $k, $v := .reminders -}}
{{- if and (kindIs "map" $v) (dig "attention_check" false $v) -}}
{{- $remLists = append $remLists (dig "name" "" $v) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $githubuser := output "gh" "api" "user" "--jq" ".login" | trim -}}
{{- $config := dict
      "codeDir" .codeDir
      "plugins" (list "calendar" "reminders" "github" "linear")
      "dashboard" (dict "groups" (list
        (dict "name" "Time sensitive" "match" (dict "statuses" (list "NOW" "SOON" "OVERDUE" "DUE TODAY")))
        (dict "name" "Personal GitHub" "match" (dict
          "plugins" (list "github")
          "contextPrefixes" (list (printf "%s/" $githubuser))))
        (dict "name" "Work reviews" "match" (dict
          "plugins" (list "github")
          "statuses" (list "REVIEW REQUESTED" "NEEDS ATTENTION")))
        (dict "name" "Work queue" "match" (dict "plugins" (list "github" "linear")))
        (dict "name" "Schedule and reminders" "match" (dict "plugins" (list "calendar" "reminders")))
        (dict "name" "Other" "fallback" true)))
      "calendar" (dict "names" $calNames "actions" (list
        (dict "key" "alt-s" "label" "session" "background" true
              "command" (list "/bin/sh" "-c"
                "aoe add --scratch --title \"$1\" --tool omp --launch >/dev/null && aoe send \"$1\" \"$2\""
                "attention-session" "{title}" "{input}")
              "input" (dict "prompt" "Session message" "default" "Prepare for calendar event {display_text}"))))
      "reminders" (dict "lists" $remLists "actions" (list
        (dict "key" "alt-s" "label" "session" "background" true
              "command" (list "/bin/sh" "-c"
                "aoe add --scratch --title \"$1\" --tool omp --launch >/dev/null && aoe send \"$1\" \"$2\""
                "attention-session" "{title}" "{input}")
              "input" (dict "prompt" "Session message" "default" "Help me do the work to complete reminder {title}"))))
      "github" (dict "actions" (list
        (dict "key" "alt-s" "label" "session" "background" true
              "command" (list "/bin/sh" "-c"
                "aoe add \"$1\" --title \"$2\" --tool omp --worktree \"$3\" --new-branch --launch >/dev/null && aoe send \"$2\" \"$4\""
                "attention-session" "{repo_path}" "{slug}" "{slug}" "{input}")
              "input" (dict "prompt" "Session message" "default" "For issue/PR {id} in this repo, checkout the existing branch if exists, and work on or review it"))
        (dict "key" "alt-l" "label" "lumen"
              "command" (list "lumen" "diff" "{url}"))))
      "linear" (dict
        "apiToken" (output "security" "find-generic-password" "-s" "chezmoi" "-a" "linear_api_key" "-w" | trim)
        "actions" (list
          (dict "key" "alt-s" "label" "session" "background" true
                "command" (list "/bin/sh" "-c"
                  "aoe add . --title \"$1\" --tool omp --launch >/dev/null && aoe send \"$1\" \"$2\""
                  "attention-session" "{identifier_lower}" "{input}")
                "input" (dict "prompt" "Session message" "default" "Work on Linear issue {identifier}"))))
-}}
{{ $config | toPrettyJson }}
