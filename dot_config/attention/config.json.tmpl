{{- /* Renders Attention config from shared calendar/reminder data. Only
   reminder lists flagged attention_check: true are included.
   The Linear API token is baked in from the macOS keychain at apply time
   (never persisted anywhere else); the Attention tool itself has no
   keychain dependency, it just reads linear.apiToken from this file.
   Session and lumen hotkeys were removed from the bundled plugins upstream
   (hardcoded tool deps) and are restored here as configured actions.
   Session model preferences come from the selected agent's configuration.
   session.agents names the AoE agent each organization's items start, using the
   same attention: Work split as the dashboard groups (work -> omp, personal ->
   freebuff), so a dispatched session and automation.maxSessions agree.
   automation rules split reviewing from own work by what the item *is*, not
   by provider: github's "REVIEW REQUESTED" status is a review of someone
   else's PR and "NEEDS ATTENTION" is your own PR needing fixes, so reviews
   get the larger pool (3) and own work the smaller one (2). A rule's maxWip
   is counted per rule, which the section-level caps cannot express.
   Every automation start is bounded four ways: the rule's own maxWip, the
   global maxWip (8), maxWipByProvider, and maxSessions per AoE agent.
   maxSessions counts every live session of that agent, manual ones included,
   so automation only ever uses the slots you leave free; freebuff's 6 is the
   product's own concurrency ceiling. Setting automation.maxWip to 0 is the
   kill switch: rules stay configured and nothing starts. cooldownMinutes
   keeps a still-open item to one automated session per day instead of one
   per refresh. maxSessions needs session.agents to know which agent a
   dispatch starts, so an item whose repository matches no entry is dispatched
   by AoE's own default agent and the per-agent cap cannot see it coming:
   every organization you want automated belongs in .orgs (see the
   local.yaml example), and the rules here only match github for that reason.
   There is no per-item exemption here yet: selectors match inclusively and a
   WIP mark does not suppress a dispatch, so a draft pull request still gets
   picked up once its cooldown passes. attention 3.28 (unreleased) adds automation.skip
   (item keys like "github:owner/repo#123", dropped before rules match); wire
   it from gitignored local data once the installed version understands the
   key, because 3.27 rejects an unknown automation field and disables every
   rule instead of ignoring just that one.
   Keep provider opening in the browser: gh-dash 4.26.2 and linear-tui 0.12.0
   have no item/repository CLI targeting flags; both remain standalone TUIs. */ -}}
{{- $remLists := list -}}
{{- if hasKey . "reminders" -}}
{{- range $k, $v := .reminders -}}
{{- if and (kindIs "map" $v) (dig "attention_check" false $v) -}}
{{- $remLists = append $remLists (dig "name" "" $v) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $workReminderLists := list -}}
{{- if and (hasKey . "reminders") (kindIs "map" .reminders) -}}
{{- $workReminder := get .reminders "work" -}}
{{- if and (kindIs "map" $workReminder) (dig "attention_check" false $workReminder) -}}
{{- $workReminderLists = append $workReminderLists (dig "name" "" $workReminder) -}}
{{- end -}}
{{- end -}}
{{- $openSourceReminderLists := list -}}
{{- if and (hasKey . "reminders") (kindIs "map" .reminders) -}}
{{- $aoeReminder := get .reminders "aoe" -}}
{{- if and (kindIs "map" $aoeReminder) (dig "attention_check" false $aoeReminder) -}}
{{- $openSourceReminderLists = append $openSourceReminderLists (dig "name" "" $aoeReminder) -}}
{{- end -}}
{{- end -}}
{{- $linearToken := output "/bin/sh" "-c" "security find-generic-password -s chezmoi -a linear_api_key -w 2>/dev/null || true" | trim -}}
{{- $workGitHubPrefixes := list -}}
{{- if hasKey . "orgs" -}}
{{- range $org, $settings := .orgs -}}
{{- if kindIs "map" $settings -}}
{{- if eq (dig "attention" "" $settings) "Work" -}}
{{- $workGitHubPrefixes = append $workGitHubPrefixes (printf "%s/" $org) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $sessionAgents := list -}}
{{- if hasKey . "orgs" -}}
{{- range $org, $settings := .orgs -}}
{{- if kindIs "map" $settings -}}
{{- $tool := "freebuff" -}}
{{- if eq (dig "attention" "" $settings) "Work" -}}
{{- $tool = "omp" -}}
{{- end -}}
{{- $sessionAgents = append $sessionAgents (dict "repo" (printf "%s/*" $org) "tool" $tool) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $workMatches := list (dict "plugins" (list "linear")) -}}
{{- if gt (len $workGitHubPrefixes) 0 -}}
{{- $workMatches = append $workMatches (dict "plugins" (list "github") "contextPrefixes" $workGitHubPrefixes) -}}
{{- end -}}
{{- if gt (len $workReminderLists) 0 -}}
{{- $workMatches = append $workMatches (dict "plugins" (list "reminders") "contexts" $workReminderLists) -}}
{{- end -}}
{{- $workMatch := dict "any" $workMatches -}}
{{- $openSourceMatches := list (dict "plugins" (list "github")) -}}
{{- if gt (len $openSourceReminderLists) 0 -}}
{{- $openSourceMatches = append $openSourceMatches (dict "plugins" (list "reminders") "contexts" $openSourceReminderLists) -}}
{{- end -}}
{{- $groups := list
      (dict "name" "Dependencies" "match" (dict "plugins" (list "github") "kinds" (list "pull_request") "authors" (list "dependabot[bot]" "renovate[bot]")))
      (dict "name" "Work" "match" $workMatch)
      (dict "name" "Open source" "match" (dict "any" $openSourceMatches))
      (dict "name" "Everything else" "fallback" true) -}}
{{- $config := dict
      "codeDir" .codeDir
      "plugins" (list "reminders" "github" "linear")
      "dashboard" (dict "autoExpand" true "groups" $groups)
      "reminders" (dict "lists" $remLists "actions" (list
        (dict "key" "s" "label" "session" "background" true
              "command" (list "attention-session" "scratch" "{title}" "{input}")
              "input" (dict "prompt" "Session message" "default" "Help me do the work to complete reminder {title}"))))
      "github" (dict "actions" (list
        (dict "key" "s" "label" "session" "background" true
              "command" (list "attention-session" "github" "{repo_path}" "{id}" "{slug}" "{slug}" "For issue/PR {id} in this repo, {session_prompt}" "{input}" "{repo}")
              "input" (dict "prompt" "Additional session content (optional)" "default" ""))
        (dict "key" "l" "label" "lumen"
              "command" (list "lumen" "diff" "{url}"))))
      "linear" (dict
        "apiToken" $linearToken
        "actions" (list
          (dict "key" "s" "label" "session" "background" true
                "command" (list "attention-session" "scratch" "{identifier_lower}" "{input}")
                "input" (dict "prompt" "Goal (interview first)" "default" "/guided-goal Work on Linear issue {identifier}"))))
      "session" (dict "agents" $sessionAgents)
      "automation" (dict
        "maxWip" 8
        "maxWipByProvider" (dict "github" 6 "linear" 2)
        "maxSessions" (dict "freebuff" 6 "omp" 8)
        "rules" (list
          (dict
            "name" "review-requests"
            "type" "session"
            "match" (dict
              "plugins" (list "github")
              "statuses" (list "REVIEW REQUESTED"))
            "maxWip" 3
            "cooldownMinutes" 1440)
          (dict
            "name" "own-pr-fixes"
            "type" "session"
            "match" (dict
              "plugins" (list "github")
              "statuses" (list "NEEDS ATTENTION"))
            "maxWip" 2
            "cooldownMinutes" 1440)))
-}}
{{ $config | toPrettyJson }}
