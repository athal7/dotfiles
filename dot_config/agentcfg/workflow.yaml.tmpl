{{- /* Prompt bodies are inlined via
       chezmoi's `include` (raw file read, not re-templated) so this file
       stays the single source of truth without duplicating
       dot_agents/prompts/*.md's content.

       The core four steps (plan/verify/implement/research) each set
       `opencode: {agent: <name>}`, pointing at a same-named entry under
       opencode_agents: below, rather than rendering directly from the
       step's own name/prompt/permissions (agentcfg#29). Why the split:
       step names are semantic/action-oriented (what discipline the
       workflow needs), decoupled from opencode's own vocabulary — "plan"
       is the step, "planner" is opencode's name for the persona that
       implements it (also dodges omp's reserved "plan" name), and the
       same persona (e.g. "qa") could back more than one step without
       duplicating its prompt/permissions/mcp. omp's task-dispatch model
       needs no standing persona for these: its primary session already
       has full tools (no lever exists to gate write/edit there) and its
       subagent dispatch carries ad hoc, step-specific instructions
       inline at call time — so every step below sets targets: [opencode],
       and Agent.Opencode makes omp render nothing for any of them. The
       portable `implement`/`merge-request` workflow commands
       (dot_config/agentcfg/commands.yaml.tmpl) separately phrase their
       guidance from the session's own tool inventory, so the same
       command reads correctly whether a fully-tooled omp session or a
       gapped opencode lead runs it — that's the actual cross-harness
       delivery mechanism for step-specific guidance, not this file.

       "lead" (the primary step) deliberately does NOT use this split:
       it has no naming collision to dodge and backs exactly one step,
       so the override buys nothing — and omp's primary session needs
       lead.md's orchestration policy (issue-refs-first, KB-before-
       remote, remote-write approval gate) as much as opencode's does.
       role: primary renders correctly on both harnesses without an
       override: opencode's default_agent, omp's APPEND_SYSTEM.md body.
       An opencode: override on a primary step suppresses BOTH of those
       — omp gets nothing at all in that case (confirmed against
       agentcfg's omp.go Render()) — which is what left omp's own lead
       running with zero of this policy until this fix. */ -}}
opencode_agents:
  - name: planner
    description: "Deep analysis and architectural thinking subagent. Dispatched by lead for design decisions, complex tradeoffs, and architectural review. Read-only."
    class: slow
    prompt:
      text: |
        {{ include "dot_agents/prompts/plan.md" | indent 8 | trim }}
    permissions:
      edit: deny
      write: deny
      bash: deny
      external_directory: &extdirs
        "*": ask
        "~/code/**": allow
        "~/.local/**": allow
        "~/.agents/skills/**": allow
        "~/.config/**": allow
        "~/.cache/**": allow
        "~/.agent-of-empires/**": allow
        "~/Downloads/**": allow
        "~/Library/LaunchAgents/**": allow
        "~/Library/Logs/**": allow
        "/tmp/**": allow
        "/private/tmp/**": allow
        "/var/folders/*/*/T/**": allow
        "/private/var/folders/*/*/T/**": allow
    mcp:
      - server: context7
  - name: qa
    description: "Functional QA — drives the running app in a browser (Firefox MCP) to verify UI/behavior, and compares against a linked Figma design (figma-desktop MCP) when one exists. Read-only re: code."
    class: default
    prompt:
      text: |
        {{ include "dot_agents/prompts/qa.md" | indent 8 | trim }}
    permissions:
      edit: deny
      write: deny
      bash: deny
      external_directory: *extdirs
    mcp:
      - server: firefox-devtools
      - server: figma-desktop

  - name: build
    description: "Focused worker subagent dispatched by lead. Executes implementation work under TDD discipline. Has edit/write access and local dev tooling. Returns a tight summary when done."
    class: default
    prompt:
      text: |
        {{ include "dot_agents/prompts/build.md" | indent 8 | trim }}
    permissions:
      edit: allow
      write: allow
      bash:
        profile: build
      external_directory: *extdirs
    mcp:
      - server: figma-desktop
      - server: context7

  - name: scout
    description: "External research — library/framework docs, dependency source, changelogs. Read-only; uses webfetch and context7."
    class: default
    prompt:
      text: |
        {{ include "dot_agents/prompts/scout.md" | indent 8 | trim }}
    permissions:
      edit: deny
      write: deny
      bash: deny
      external_directory: *extdirs
    mcp:
      - server: context7

workflow:
  steps:
    - name: lead
      description: "Primary orchestrator — plans, decides, dispatches, and verifies."
      role: primary
      class: default
      prompt:
        text: |
          {{ include "dot_agents/prompts/lead.md" | indent 10 | trim }}
      permissions:
        task: allow
        edit: deny
        write: deny
        bash:
          profile: lead
        external_directory: *extdirs

    - name: plan
      description: "Deep analysis and architectural thinking — read-only."
      role: delegate
      class: slow
      targets: [opencode]
      opencode:
        agent: planner
      prompt:
        text: "Compiles to opencode's \"planner\" persona (see opencode_agents: above). omp dispatches this discipline ad hoc via task() with inline instructions instead of a standing agent file."

    - name: verify
      description: "Functional QA — drives a running app in a browser to verify UI/behavior against acceptance criteria and a linked design. Read-only re: code."
      role: delegate
      class: default
      targets: [opencode]
      opencode:
        agent: qa
      prompt:
        text: "Compiles to opencode's \"qa\" persona (see opencode_agents: above). omp dispatches this discipline ad hoc via task() with inline instructions instead of a standing agent file."

    - name: implement
      description: "Implementation work under TDD discipline — full read/write and local dev tooling."
      role: delegate
      class: default
      steps: 30
      targets: [opencode]
      opencode:
        agent: build
      prompt:
        text: "Compiles to opencode's \"build\" persona (see opencode_agents: above). omp dispatches this discipline ad hoc via task() with inline instructions instead of a standing agent file."

    - name: research
      description: "External research — library/framework docs, dependency source, changelogs. Read-only."
      role: delegate
      class: default
      targets: [opencode]
      opencode:
        agent: scout
      prompt:
        text: "Compiles to opencode's \"scout\" persona (see opencode_agents: above). omp dispatches this discipline ad hoc via task() with inline instructions instead of a standing agent file."

    - name: general
      description: "Multi-step research and read-only work that doesn't fit scout/plan/qa — the reads catch-all."
      role: delegate
      class: default
      targets: [opencode]
      prompt:
        text: |
          You are opencode's general-purpose research and read-only
          subagent, dispatched for multi-step research and read-only work
          that doesn't fit scout/plan/qa. You have no edit or write access:
          investigate, synthesize, and report findings back without
          modifying anything.
      permissions:
        edit: deny
        write: deny
        external_directory: *extdirs

    - name: zoom
      description: "Reaches Zoom via Runlayer MCP (OAuth). Dispatched to fetch meeting summaries, transcripts, recordings. Returns a tight distilled summary, never raw dumps."
      role: delegate
      class: default
      targets: [opencode]
      prompt:
        text: |
          {{ include "dot_agents/prompts/zoom.md" | indent 10 | trim }}
      permissions:
        skill: deny
        bash: deny
        external_directory: *extdirs
      mcp:
        - server: runlayer-zoom

    - name: slack
      description: "Reaches Slack via Runlayer MCP (OAuth). Dispatched to search, read, and post messages, threads, canvases, and files. Returns a tight distilled summary, never raw dumps."
      role: delegate
      class: default
      targets: [opencode]
      prompt:
        text: |
          {{ include "dot_agents/prompts/slack.md" | indent 10 | trim }}
      permissions:
        skill: deny
        bash: deny
        external_directory: *extdirs
      mcp:
        - server: runlayer-slack
          ask: ["slack_send_*", "slack_schedule_*", "slack_add_*", "slack_create_*"]

    - name: atlassian
      description: "Reaches Confluence and Jira via Runlayer MCP (OAuth). Dispatched to search and read pages, spaces, and issues; write actions (create/update/transition/comment) require explicit confirmation. Returns a tight distilled summary, never raw dumps."
      role: delegate
      class: default
      targets: [opencode]
      prompt:
        text: |
          {{ include "dot_agents/prompts/atlassian.md" | indent 10 | trim }}
      permissions:
        skill: deny
        bash: deny
        external_directory: *extdirs
      mcp:
        - server: runlayer-atlassian
          ask: ["create*", "update*", "edit*", "transition*", "add*"]

    - name: github
      description: "Reaches GitHub via its official remote MCP server. Dispatched to search and read issues, pull requests, and repos; write actions (create/update/merge/comment) require explicit confirmation. Returns a tight distilled summary, never raw dumps."
      role: delegate
      class: default
      targets: [opencode]
      prompt:
        text: |
          {{ include "dot_agents/prompts/github.md" | indent 10 | trim }}
      permissions:
        skill: deny
        bash: deny
        external_directory: *extdirs
      mcp:
        - server: github
          ask:
            - "create_*"
            - "update_*"
            - "delete_*"
            - "merge_*"
            - "push_*"
            - "fork_*"
            - "add_*"
            - "assign_*"
            - "request_*"
            - "dismiss_*"
            - "mark_*"
            - "manage_*"
            - "star_repository"
            - "unstar_repository"
            - "actions_run_trigger"
            - "*_write"

    - name: google
      description: "Reaches Gmail, Calendar, Drive, Docs, and Sheets via Runlayer MCP (OAuth). Dispatched to search and read messages, events, and files; write actions (send/create/update/delete) require explicit confirmation. Returns a tight distilled summary, never raw dumps."
      role: delegate
      class: default
      targets: [opencode]
      prompt:
        text: |
          {{ include "dot_agents/prompts/google.md" | indent 10 | trim }}
      permissions:
        skill: deny
        bash: deny
        external_directory: *extdirs
      mcp:
        - server: runlayer-gmail
          # Exact enumeration, not a shared glob: "*send*/*create*/*update*/
          # *delete*/*schedule*" (this list's prior shape) missed add_labels,
          # mark_as_read, and reply_to_message entirely — verified live
          # against the actual runlayer-gmail tool set 2026-08-10.
          ask: ["add_labels", "create_draft", "create_label", "mark_as_read", "reply_to_message", "send_draft", "send_email"]
        - server: runlayer-gcalendar
          # move_event, quick_add, and respond_to_event were uncovered by
          # the prior shared glob — verified live 2026-08-10.
          ask: ["create_calendar", "create_event", "move_event", "quick_add", "respond_to_event", "update_calendar", "update_event"]
        - server: runlayer-gdrive
          # copy_file, move_file, rename_file, and share_file (grants
          # access — high sensitivity) were uncovered — verified live 2026-08-10.
          ask: ["copy_file", "create_doc_from_markdown", "create_file", "create_folder", "move_file", "rename_file", "share_file", "update_doc_from_markdown", "update_file"]
        - server: runlayer-gdocs
          # add_comment, format_paragraphs, format_text, insert_break,
          # insert_text, link_text, replace_text, and resolve_comment were
          # all uncovered — verified live 2026-08-10. replace_text was
          # previously in Tools: unmarked, as if read-only; it is not.
          ask: ["add_comment", "create_file", "format_paragraphs", "format_text", "insert_break", "insert_text", "link_text", "replace_text", "resolve_comment"]
        - server: runlayer-gsheets
          # add_sheet, append, autofill, format_cells, group_rows,
          # insert_rows, and set_row_visibility were all uncovered —
          ask: ["add_sheet", "append", "autofill", "create", "format_cells", "group_rows", "insert_rows", "set_row_visibility", "update", "update_ranges"]

    - name: linear
      description: "Reaches Linear via its official remote MCP (OAuth). Dispatched to search and read issues, projects, and documents; write actions (create/update issues, projects, documents) require explicit confirmation. Returns a tight distilled summary, never raw dumps."
      role: delegate
      class: default
      targets: [opencode]
      prompt:
        text: |
          {{ include "dot_agents/prompts/linear.md" | indent 10 | trim }}
      permissions:
        skill: deny
        bash: deny
        external_directory: *extdirs
      mcp:
        - server: linear
          # "save_*" alone missed every delete_*/merge_*/resolve_*/submit_*
          # write tool and create_attachment* — verified against this
          # session's own live linear MCP tool routes 2026-08-10.
          ask: ["save_*", "delete_*", "merge_diff", "resolve_diff_thread", "submit_diff_review",
            "create_attachment", "create_attachment_from_upload", "create_initiative_label",
            "create_issue_label", "prepare_attachment_upload"]
