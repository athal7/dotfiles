version: 1
imports:
  - bash.yaml
  - mcp_servers.yaml
  - workflow.yaml
  - commands.yaml

{{- /* model_classes and contexts are inline rather than imported files:
       agentcfg merges the root agentcfg.yaml with the same mergeFileInto
       every import uses (internal/registry/load.go), so an import buys
       nothing here but two more files, two more `imports:` entries, and
       two more hash lines in run_onchange_after_agentcfg-apply.sh.tmpl.
       Both render from the same two data sources, so they belong together.

       Model literals and per-org overrides come from untracked
       .chezmoidata/local.yaml, so organization names and billing choices
       remain private. Each context is a PARTIAL override merged over the
       private defaults.

       Routing a context's `default` to the local model REQUIRES the
       exclude_for_models entries in mcp_servers.yaml; without them omp's
       unconditional MCP surface overflows the local window and silently
       falls back to a cloud model. See agentcfg ADR-0005. */ -}}
{{- $classes := .model_class }}
model_classes:
{{- range $class := (keys $classes | sortAlpha) }}
  {{ $class }}: {{ index $classes $class }}
{{- end }}
{{- $orgs := dict }}
{{- if hasKey . "orgs" }}{{ $orgs = .orgs }}{{ end }}
{{- $ctx := dict }}
{{- range $org, $cfg := $orgs }}
{{-   if hasKey $cfg "model_class" }}{{ $ctx = set $ctx $org (index $cfg "model_class") }}{{ end }}
{{- end }}
{{- if $ctx }}
contexts:
{{- range $org := (keys $ctx | sortAlpha) }}
  - match:
      git_remote_host: github.com
      git_remote_owner: {{ $org }}
    model_classes:
{{-   range $class := (keys (index $ctx $org) | sortAlpha) }}
      {{ $class }}: {{ index (index $ctx $org) $class }}
{{-   end }}
{{- end }}
{{- end }}
harnesses:
  opencode:
    out: ~/.config/opencode/opencode.json
    # Everything below is opencode.json's static skeleton: no registry
    # field models it (server/plugin/provider/formatter/lsp aren't
    # agent/mcp/model/permission concepts), so agentcfg owns it verbatim
    # here instead of chezmoi separately templating opencode.json itself
    # — two writers on one chezmoi-tracked target used to fight (chezmoi
    # only knows what IT last wrote, so every apply after this
    # onchange-script's own JSON merge saw the live file "changed outside
    # chezmoi" and either prompted forever or hard-failed under
    # --error-on-conflict). agentcfg's own JSON merge (Render's managed
    # keys: default_agent, agent, tools, mcp, model, small_model, and the
    # permission.{bash,read,edit,write,task,skill,webfetch} leaves) still
    # layers on top of this every apply, keyed by the dotted paths below.
    extra:
      server:
        hostname: 127.0.0.1
      plugin:
        - ["./lib/skill-inject.ts", {
            architecture: [code-quality],
            communication: [knowledge-base],
            elasticsearch: [{skill: xh, context: "All requests use xh --ignore-stdin --session=agent for auth"}],
            pagerduty: [{skill: xh, context: "All requests use xh --ignore-stdin --session=agent for auth"}],
            push: [commit],
          }]
        - "@tarquinen/opencode-dcp@3.1.12"
        - opencode-permission-log
      permission.grep: {{ .permissions.grep | quote }}
      permission.glob: {{ .permissions.find | quote }}
      permission.lsp: allow
      permission.websearch: allow
      compaction:
        prune: true
      provider:
        anthropic:
          models:
            claude-opus-5:
              options:
                thinking: {type: adaptive, display: summarized}
            claude-sonnet-5:
              options:
                thinking: {type: adaptive, display: summarized}
{{- if hasKey . "local_model" }}
        {{ (index .local_model "provider") | default "mlx" }}:
          npm: "@ai-sdk/openai-compatible"
          name: mlx-lm
          options:
            baseURL: "http://{{ (index .local_model "host") | default "127.0.0.1" }}:{{ (index .local_model "port") | default 8091 }}/v1"
          models:
            {{ (index .local_model "id") | default "default_model" }}:
              name: {{ .local_model.name | quote }}
              # Without an explicit limit, this unregistered custom model
              # resolves to limit.context=0 in opencode's provider registry
              # (provider.ts falls back to models.dev, which doesn't know
              # this model). overflow.ts's isOverflow() treats
              # limit.context===0 as "never overflow", so opencode's
              # built-in auto-compaction silently never engages for mlx
              # sessions without this — the opencode-side counterpart to
              # omp's contextWindow/agent_max_tokens in models.yml.tmpl.
              limit:
                context: {{ .local_model.context_window }}
                output: {{ (index .local_model "agent_max_tokens") | default 4096 }}
{{- end }}
      formatter:
        rubocop: {disabled: true}
        ruff: {disabled: true}
      lsp:
        ruby-lsp:
          command: [ruby, -S, ruby-lsp]
          extensions: [.rb, .rake, .gemspec, .ru]
  omp:
    agents_dir: ~/.omp/agent/agents
    bash_profile: global
    # tools.approvalMode/task.disabledAgents/compaction.strategy have no
    # registry-level concept (they're not agent/mcp/model/bash policy);
    # tools.approval is layered with agentcfg's own registry-derived MCP
    # tool grants (see docs/schema.md's harnesses.omp.extra section) —
    # this list is the built-in, non-MCP tools that should always be
    # pre-approved rather than prompted under the always-ask default.
    extra:
      tools.approvalMode: always-ask
      task.disabledAgents: []
      compaction.strategy: shake
      plan.defaultOnStartup: true
      retry.fallbackChains:
        default: [anthropic/claude-sonnet-5]
{{- if hasKey . "local_model" }}
        {{ (index .local_model "provider") | default "mlx" }}/{{ (index .local_model "id") | default "default_model" }}: []
{{- end }}
      tools.approval:
        task: allow
        write: allow
        edit: allow
        ast_edit: allow
        ask: allow
        eval: allow
        hub: allow
        bash: ask
