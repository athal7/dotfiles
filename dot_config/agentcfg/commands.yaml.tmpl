{{- /* Structured multi-step commands, portable across every harness (both
       opencode and omp discover the identical rendered ~/.agents/skills/
       <name>/SKILL.md path — see agentcfg's docs/schema.md commands:
       section). Prompt bodies are inlined via chezmoi's `include` (raw
       file read, not re-templated), same idiom as workflow.yaml.tmpl,
       from dot_agents/prompts/commands/<command>/<step>.md.

       Deliberately NOT a per-harness split: a step whose behavior
       genuinely differs by which tools the current session has (e.g.
       omp's primary can edit directly, opencode's lead can't) is phrased
       once, conditioned on tool availability ("with edit/write tools...
       otherwise dispatch build") rather than duplicated per harness — see
       agentcfg's harness_prompts revert rationale (that mechanism doesn't
       port cleanly; conditioning the shared prompt on the session's own
       tool inventory does). */ -}}
commands:
  - name: implement
    description: "The full implementation loop — issue, workspace, plan, build, review, ship. Load when starting or resuming work on a change, or when the user invokes the implement workflow."
    steps:
      - name: issue
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/implement/issue.md" | indent 12 | trim }}
      - name: workspace
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/implement/workspace.md" | indent 12 | trim }}
      - name: plan
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/implement/plan.md" | indent 12 | trim }}
      - name: build
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/implement/build.md" | indent 12 | trim }}
      - name: review
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/implement/review.md" | indent 12 | trim }}
      - name: ship
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/implement/ship.md" | indent 12 | trim }}

  - name: merge-request
    description: "Maintain your own merge request — triage review threads, batch fixes, resolve conflicts, re-request review. Load when addressing feedback or conflicts on a request you own."
    steps:
      - name: draft
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/merge-request/draft.md" | indent 12 | trim }}
      - name: triage
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/merge-request/triage.md" | indent 12 | trim }}
      - name: fix
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/merge-request/fix.md" | indent 12 | trim }}
      - name: conflicts
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/merge-request/conflicts.md" | indent 12 | trim }}
      - name: re-request
        prompt:
          text: |
            {{ include "dot_agents/prompts/commands/merge-request/re-request.md" | indent 12 | trim }}
