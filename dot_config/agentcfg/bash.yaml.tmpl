bash:
  default_lists: []
  lists:
    # Destructive system commands — prompt the human everywhere these apply.
    guardrails:
      "rm -rf /*": ask
      "rm -fr /*": ask
      "rm -rf ~*": ask
      "rm -fr ~*": ask
      "rm -rf $HOME*": ask
      "sudo *": ask
      "dd if=*": ask
      "dd of=*": ask
      "mkfs*": ask
      "diskutil *": ask
      "shutdown*": ask
      "reboot*": ask
      "curl * -X POST*": ask
      "curl * -X PUT*": ask
      "curl * -X DELETE*": ask
      "curl * -X PATCH*": ask
      "curl * -d *": ask
      "curl * --data*": ask
      "curl * -T *": ask
      "curl * --upload-file*": ask
      "wget *": ask
    packages:
{{- range $package := .packages.brews }}
{{- if hasKey $package "permissions" }}
{{- range $pattern, $decision := $package.permissions }}
      {{ $pattern | toJson }}: {{ $decision }}
{{- end }}
{{- end }}
{{- end }}
{{- range $package := .packages.github_releases }}
{{- if hasKey $package "permissions" }}
{{- range $pattern, $decision := $package.permissions }}
      {{ $pattern | toJson }}: {{ $decision }}
{{- end }}
{{- end }}
{{- end }}
    lead:
      "xh --ignore-stdin --session-read-only=agent POST \"$ES_URL/*/_search\" 'Content-Type:application/json' --raw \"$PAYLOAD\"": allow
      "gh *": ask
      "aoe *": ask
    build:
      "git commit*": deny
      "git -C * commit*": deny
    readonly:
      "ls*": allow
      "pwd": allow
      "cd *": allow
      "echo *": allow
      "grep *": allow
      "find *": allow
      "fd *": allow
      "cat *": allow
      "head *": allow
      "tail *": allow
      "wc *": allow
      "sed *": allow
      "sed -i*": deny
  profiles:
    global:
      base: allow
      lists: [guardrails, packages]
    lead:
      base: ask
      lists: [lead]
    build:
      base: allow
      lists: [guardrails, packages, build]
