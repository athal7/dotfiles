# Managed by chezmoi. Source only from a trusted project .envrc or command.
# Keychain uses service "chezmoi"; ACCOUNT is explicit, not inferred from VAR.
keychain_env() {
  if [ "$#" -ne 2 ] || [ -z "$2" ]; then
    printf "keychain_env: expected VAR ACCOUNT\n" >&2
    return 2
  fi
  case $1 in
    ""|[!A-Za-z_]*|*[!A-Za-z0-9_]*)
      printf "keychain_env: invalid environment variable name\n" >&2
      return 2
      ;;
  esac
  local keychain_value
  if ! keychain_value=$(security find-generic-password -s chezmoi -a "$2" -w 2>/dev/null); then
    printf "keychain_env: Keychain account %s unavailable\n" "$2" >&2
    return 1
  fi
  export "$1=$keychain_value"
}
