# Version managers
eval "$(mise activate zsh)"

# XDG Base Directory compliance (XDG_STATE_HOME/XDG_CACHE_HOME asserted in .zshenv)
export HISTFILE="$XDG_STATE_HOME/zsh/history"
mkdir -p "$(dirname "$HISTFILE")"
export ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump"
mkdir -p "$(dirname "$ZSH_COMPDUMP")"

export EDITOR="nvim"
export GPG_TTY=$(tty)
_brew_prefix="$(brew --prefix)"

# aliases
  alias cat='bat'
  alias e=$EDITOR
  alias g='git'
  alias k="kubectl"
  alias less="less -R"
  alias lf="less +F"
  alias ll="ls -la"
  # macos-trash's `trash` doesn't understand rm flags, so strip them and
  # trash whatever paths are left — covers plain `rm` and `rm -rf` alike.
  rm() {
    local args=()
    for arg in "$@"; do
      [[ "$arg" == -* ]] || args+=("$arg")
    done
    "$_brew_prefix/opt/macos-trash/bin/trash" "${args[@]}"
  }
  alias tf='tofu'
  alias watch='watch -c '

# completions
  autoload -Uz compinit && compinit -d "$ZSH_COMPDUMP"
  # gcloud SDK shell integration (completions + PATH)
  [[ -f "$_brew_prefix/share/google-cloud-sdk/path.zsh.inc" ]] && source "$_brew_prefix/share/google-cloud-sdk/path.zsh.inc"
  [[ -f "$_brew_prefix/share/google-cloud-sdk/completion.zsh.inc" ]] && source "$_brew_prefix/share/google-cloud-sdk/completion.zsh.inc"
  # kubectl completions
  command -v kubectl >/dev/null 2>&1 && source <(kubectl completion zsh)

# Private shell config (not tracked in dotfiles)
[[ -f ~/.config/zsh/private.zsh ]] && source ~/.config/zsh/private.zsh

# plugins
  eval "$(starship init zsh)"
  export DIRENV_LOG_FORMAT=
  eval "$(direnv hook zsh)"
  [[ -s "$_brew_prefix/etc/profile.d/autojump.sh" ]] && source "$_brew_prefix/etc/profile.d/autojump.sh"
  command -v wt >/dev/null 2>&1 && eval "$(wt config shell init zsh)"
  command -v git-spice >/dev/null 2>&1 && eval "$(git-spice shell completion zsh)"

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Enable reverse search (ctrl-r)
bindkey '^R' history-incremental-search-backward

# 4-pane tmux dashboard composing dedicated, independently-maintained TUIs
# for everything that needs triage: GitHub (gh dash), Linear (linear-tui),
# Reminders (nag), and aoe's session view. Attaches to an existing session
# if one's already running instead of rebuilding the layout every time.
attention() {
  local session="attention"
  # 2x2 grid split percentages, adjustable in one place. left_col_pct is the
  # width of the gh-dash/nag column; top_row_pct is the height of the
  # gh-dash/linear-tui row.
  local left_col_pct=50
  local top_row_pct=50

  if tmux has-session -t "$session" 2>/dev/null; then
    if [[ -n "$TMUX" ]]; then
      tmux switch-client -t "$session"
    else
      tmux attach-session -t "$session"
    fi
    return
  fi

  # linear-tui reads LINEAR_API_KEY from its environment, so pull it from
  # the keychain at launch time instead of requiring an interactive OAuth
  # login (`linear-tui auth login`) on every fresh session.
  local linear_cmd='export LINEAR_API_KEY=$(security find-generic-password -s chezmoi -a linear_api_key -w 2>/dev/null); exec linear-tui'

  # Capture pane IDs (not indices) from each split so later splits target
  # the right pane regardless of how tmux renumbers panes as the grid fills in.
  local gh_pane linear_pane
  gh_pane=$(tmux new-session -d -s "$session" -n dashboard -P -F '#{pane_id}' "gh dash")
  linear_pane=$(tmux split-window -h -t "$gh_pane" -p $((100 - left_col_pct)) -P -F '#{pane_id}' "$linear_cmd")
  tmux split-window -v -t "$gh_pane" -p $((100 - top_row_pct)) "nag"
  tmux split-window -v -t "$linear_pane" -p $((100 - top_row_pct)) "aoe"

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}
alias att=attention
