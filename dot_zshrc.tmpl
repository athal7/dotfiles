# Version managers
eval "$(mise activate zsh)"

# XDG Base Directory compliance (XDG_STATE_HOME/XDG_CACHE_HOME asserted in .zshenv)
export HISTFILE="$XDG_STATE_HOME/zsh/history"
mkdir -p "$(dirname "$HISTFILE")"
export ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump"
mkdir -p "$(dirname "$ZSH_COMPDUMP")"

export EDITOR="nvim"
export GPG_TTY=$(tty)
_brew_prefix="$(brew --prefix)"

# aliases
  alias cat='bat'
  alias e=$EDITOR
  alias g='git'
  alias k="kubectl"
  alias less="less -R"
  alias lf="less +F"
  alias ll="ls -la"
  # macos-trash's `trash` doesn't understand rm flags, so strip them and
  # trash whatever paths are left — covers plain `rm` and `rm -rf` alike.
  rm() {
    local args=()
    for arg in "$@"; do
      [[ "$arg" == -* ]] || args+=("$arg")
    done
    "$_brew_prefix/opt/macos-trash/bin/trash" "${args[@]}"
  }
  alias tf='tofu'
  alias watch='watch -c '

# completions
  autoload -Uz compinit && compinit -d "$ZSH_COMPDUMP"
  # gcloud SDK shell integration (completions + PATH)
  [[ -f "$_brew_prefix/share/google-cloud-sdk/path.zsh.inc" ]] && source "$_brew_prefix/share/google-cloud-sdk/path.zsh.inc"
  [[ -f "$_brew_prefix/share/google-cloud-sdk/completion.zsh.inc" ]] && source "$_brew_prefix/share/google-cloud-sdk/completion.zsh.inc"
  # kubectl completions
  command -v kubectl >/dev/null 2>&1 && source <(kubectl completion zsh)

# Private shell config (not tracked in dotfiles)
[[ -f ~/.config/zsh/private.zsh ]] && source ~/.config/zsh/private.zsh

# plugins
  eval "$(starship init zsh)"
  export DIRENV_LOG_FORMAT=
  eval "$(direnv hook zsh)"
  [[ -s "$_brew_prefix/etc/profile.d/autojump.sh" ]] && source "$_brew_prefix/etc/profile.d/autojump.sh"
  command -v wt >/dev/null 2>&1 && eval "$(wt config shell init zsh)"
  command -v git-spice >/dev/null 2>&1 && eval "$(git-spice shell completion zsh)"

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Enable reverse search (ctrl-r)
bindkey '^R' history-incremental-search-backward

# Prioritized interactive multi-service attention/inbox triage via fzf.
# Single fzf screen: hotkeys act immediately on the highlighted row, with
# their availability shown live in the footer as the cursor moves.
attention() {
  local out key row
  # Loop back to the dashboard after each action so triage continues until
  # the user backs all the way out (Esc at the dashboard) -- that's the
  # only quit path now. --height/--layout=reverse keep fzf off the
  # alt-screen so action output (e.g. "Copied to clipboard!") stays visible
  # on the terminal instead of being wiped before the dashboard re-renders.
  while true; do
    out=$(attention-list 2>/dev/null | fzf --ansi --height ~60% --layout=reverse \
      --header "Hotkeys act immediately on this row · Enter = primary action · Esc = quit" \
      -d '\t' --with-nth 1 \
      --expect="$(attention-list expect-keys)" \
      --footer-border=line --bind 'start,focus:transform-footer:printf "%s\n" {3}')
    [[ -z "$out" ]] && break
    key=${out%%$'\n'*}
    row=${out#*$'\n'}
    attention-list act "$key" "$row"
  done
}
alias att=attention
