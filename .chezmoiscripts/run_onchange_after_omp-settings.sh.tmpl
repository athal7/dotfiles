#!/bin/sh
# Pushes a small set of omp global settings via `omp config set`. omp's own
# CLI does a safe read-modify-write on ~/.omp/agent/config.yml, so this is
# idempotent and preserves TUI-authored keys (theme, modelRoles, etc.) that
# aren't set here.
#
#   bash.patterns          — reuses the same composed permission map opencode
#                             gets, rendered via the omp-bash-patterns partial
#                             (batch 1), so the two tools stay in parity.
#   tools.approvalMode      — always-ask: this is an attended harness (a
#                             human is present to answer prompts), so the
#                             global default is "ask" for every write/exec
#                             tier tool. bash is the one exception — its own
#                             bash.patterns-derived policy overrides
#                             approvalMode regardless of this setting, so it
#                             keeps its existing granular allow/ask/deny
#                             behavior unchanged.
#   task.disabledAgents     — omp's own bundled "reviewer"/"security-reviewer"
#                             subagents: this repo runs no inline code-review
#                             subagent by design, that happens automatically
#                             post-push instead.
#   compaction.strategy     — context-full: the locally-configured model
#                             (mlx/default_model) is text-only, but omp's
#                             "snapcompact" strategy requires vision, so
#                             leaving it at the TUI default fires a warning
#                             notice every compaction. Pinning it here
#                             silences that.
#   tools.approval           — pure allow-list: every MCP tool id in
#                             .chezmoidata/mcp.yaml's per-server `tools`
#                             list (rendered via the omp-tools-approval
#                             partial), plus the built-in-tool allow-list
#                             from .chezmoidata/permissions.yaml top-level
#                             ompToolsApproval.allow. Nothing else is
#                             listed — MCP tools all declare tier "write",
#                             so an unlisted one already prompts under
#                             always-ask with zero bookkeeping; no need to
#                             enumerate every non-allowed tool just to mark
#                             it "prompt" (an earlier version of this did,
#                             back when the global mode was "yolo" and an
#                             unset tool auto-allowed — dead weight now).
#                             Subagents run headless with tools.
#                             approvalMode: yolo hardcoded by omp itself —
#                             not configurable — so an omitted entry
#                             auto-allows for them via that forced-yolo
#                             fallback but prompts for the interactive lead
#                             session under always-ask. mcp.yaml's `tools`
#                             list doubles as each subagent's frontmatter
#                             visibility grant, so every MCP tool a
#                             subagent can actually reach is already
#                             listed here — never relying on that implicit
#                             yolo fallback. task/write/edit/ast_edit/hub/
#                             bash get an explicit entry (verified
#                             empirically for task/write/edit/ast_edit;
#                             hub/bash added for a drift-proof guarantee —
#                             hub was already tier-exempt, and bash's own
#                             tool-level gate is bash.patterns below, not
#                             this map, so its entry here is a no-op).
#                             read/grep/glob/lsp/web_search/todo auto-
#                             approve under every mode regardless (tier
#                             "read" or approval-exempt) and need none.
#
# bash-permissions.yaml hash: {{ include ".chezmoidata/bash-permissions.yaml" | sha256sum }}
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# permissions.yaml hash: {{ include ".chezmoidata/permissions.yaml" | sha256sum }}
# mcp.yaml hash: {{ include ".chezmoidata/mcp.yaml" | sha256sum }}
# omp-bash-patterns hash: {{ include ".chezmoitemplates/omp-bash-patterns" | sha256sum }}
# opencode-bash hash: {{ include ".chezmoitemplates/opencode-bash" | sha256sum }}
# omp-tools-approval hash: {{ include ".chezmoitemplates/omp-tools-approval" | sha256sum }}
# omp-mcp-tool-ids hash: {{ include ".chezmoitemplates/omp-mcp-tool-ids" | sha256sum }}

set -eu

if ! command -v omp >/dev/null 2>&1; then
  echo "omp not found on PATH — skipping omp settings sync" >&2
  exit 0
fi

{{- $globalBash := dict }}
{{- range $list := .packages }}
{{- if kindIs "slice" $list }}
{{- range $entry := $list }}
{{- if kindIs "map" $entry }}
{{- $perms := index $entry "permissions" }}
{{- if $perms }}
{{- range $pattern, $action := $perms }}
{{- $_ := set $globalBash $pattern $action }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- $bp := .bashPermissions }}

omp config set bash.patterns '{{ includeTemplate "omp-bash-patterns" (dict "spec" $bp.agents.global "lists" $bp.lists "guardrails" $bp.guardrails "packages" $globalBash) }}'
omp config set tools.approval '{{ includeTemplate "omp-tools-approval" (dict "servers" .mcp.servers "builtinAllow" .ompToolsApproval.allow) }}'
omp config set tools.approvalMode always-ask
omp config set task.disabledAgents '["reviewer","security-reviewer"]'
omp config set compaction.strategy context-full
