#!/bin/sh
set -eu

registry_hash='{{ include "dot_config/agentcfg/agentcfg.yaml" | sha256sum }}{{ include "dot_config/agentcfg/models.yaml.tmpl" | sha256sum }}{{ include "dot_config/agentcfg/bash.yaml" | sha256sum }}{{ include "dot_config/agentcfg/mcp.yaml" | sha256sum }}{{ include "dot_config/agentcfg/workflow.yaml" | sha256sum }}{{ include "dot_agents/prompts/plan.md" | sha256sum }}{{ include "dot_agents/prompts/build.md" | sha256sum }}{{ include "dot_agents/prompts/scout.md" | sha256sum }}'
: "$registry_hash"

registry="$HOME/.config/agentcfg"
target="$HOME/.omp/agent/agents"
sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT HUP INT TERM

HOME="$sandbox" agentcfg apply --registry "$registry" --target omp --scope global
mkdir -p "$target"
rm -f "$target"/*.md
cp "$sandbox/.omp/agent/agents/"*.md "$target"/
