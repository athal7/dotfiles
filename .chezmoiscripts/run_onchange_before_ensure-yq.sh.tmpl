#!/bin/sh
{{ template "brewenv" . }}

# The LaunchAgent plists are rendered from dot_config/launchd-yaml/agents.yaml
# by launchd-yaml, which needs yq. On a fresh machine the main package install
# runs only *after* files are applied, so ensure yq exists first.
if ! command -v yq >/dev/null 2>&1; then
  echo "Installing yq (required to render LaunchAgent plists)..."
  brew install yq
fi
