#!/bin/bash
{{ template "brewenv" . }}

# Homebrew 6.x requires explicit trust before it will load formulae/casks/
# commands from third-party taps (HOMEBREW_REQUIRE_TAP_TRUST is default-on).
# Trust every declared tap so `brew bundle` can install their artifacts —
# their third-party cask/formula artifacts, which silently failed to install before this.
{{ range .packages.taps -}}
brew trust --tap {{ . | quote }}
{{ end }}

# OMP follows the tap's current release. Retire the formulae and tap left
# behind by the retired version pin so they cannot shadow the linked formula.
for installed in $(brew list --formula --full-name); do
  case "$installed" in
    athal7/versions/omp@*)
      brew uninstall --formula "$installed" || exit 1
      ;;
  esac
done
brew untap athal7/versions >/dev/null 2>&1 || true

# Homebrew Bundle won't switch an installed stable formula to HEAD.
if installed_aoe="$(brew list --formula --versions aoe 2>/dev/null)"; then
  case "$installed_aoe" in
    "aoe HEAD"*)
      if [ ! -x "$(brew --prefix aoe)/bin/aoe" ]; then
        brew uninstall --formula aoe || exit 1
        brew install --HEAD aoe || exit 1
      fi
      ;;
    *)
      brew uninstall --formula aoe || exit 1
      brew install --HEAD aoe || exit 1
      ;;
  esac
fi

brew bundle --file=/dev/stdin <<'EOF' || exit 1
{{ range .packages.taps -}}
tap {{ . | quote }}
{{ end -}}

cask_args appdir: "/Applications"

{{ range .packages.brews -}}
brew {{ .name | quote }}{{ if hasKey . "args" }}, args: [{{ range $i, $a := .args }}{{ if $i }}, {{ end }}{{ $a | quote }}{{ end }}]{{ end }}
{{ end -}}

{{ range .packages.casks -}}
cask {{ .name | quote }}
{{ end -}}
EOF

# Install every tool declared in the mise: list (rendered into
# ~/.config/mise/config.toml by dot_config/mise/config.toml.tmpl). Listing
# versions here as comments makes this script's rendered content change
# whenever the mise: list changes, which is what makes chezmoi re-run it.
{{ range .packages.mise -}}
# - {{ .name }}@{{ .version }}
{{ end -}}
mise install
mise reshim
