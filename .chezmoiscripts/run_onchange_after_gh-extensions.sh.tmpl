#!/bin/bash
# Install/update declared gh CLI extensions.
# Rerun triggers (chezmoi reruns run_onchange_* scripts whenever their
# rendered content changes):
# gh_extensions: {{ .packages.gh_extensions | toJson | sha256sum }}

# Deliberately not -e: an individual extension install/update failure
# (missing host capability, gh not yet authenticated, upstream outage) must
# never abort the rest of chezmoi apply. See run_onchange_after_plugins-aoe
# for the same rationale.
set -uo pipefail

{{ template "brewenv" . }}

if ! command -v gh >/dev/null 2>&1; then
  echo "gh not found on PATH — skipping gh extension install/update" >&2
  exit 0
fi

{{ range .packages.gh_extensions -}}
if gh extension list 2>/dev/null | grep -q {{ .repo | quote }}; then
  echo "updating gh extension {{ .repo }}..."
  if ! gh extension upgrade {{ .name | quote }} < /dev/null; then
    echo "WARN: gh extension upgrade {{ .name }} failed" >&2
  fi
else
  echo "installing gh extension {{ .repo }}..."
  if ! gh extension install {{ .repo | quote }} < /dev/null; then
    echo "WARN: gh extension install {{ .repo }} failed" >&2
  fi
fi
{{ end -}}
