#!/bin/bash
set -euo pipefail

# The broker's package.json tracks the published @mozilla/firefox-devtools-mcp;
# npm ci installs exactly what the committed lockfile resolved.
# manifest: {{ include "dot_local/share/firefox-mcp-broker/package.json" | sha256sum }}
# lockfile: {{ include "dot_local/share/firefox-mcp-broker/package-lock.json" | sha256sum }}
# Run from the target: npm ci --prefix misidentifies the lockfile package root.
cd "$HOME/.local/share/firefox-mcp-broker"
npm ci --omit=dev
