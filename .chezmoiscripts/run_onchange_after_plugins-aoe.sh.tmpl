#!/bin/bash
# Install/update declared aoe (Agent of Empires) plugins.
# Rerun triggers (chezmoi reruns run_onchange_* scripts whenever their
# rendered content changes):
# aoe_plugins: {{ .packages.aoe_plugins | toJson | sha256sum }}
{{- range .packages.aoe_plugins }}
# plugin-present: {{ .id }}={{ if (joinPath $.chezmoi.homeDir ".config/agent-of-empires/plugins" .id | stat) }}1{{ else }}0{{ end }}
{{- end }}

# Deliberately not -e: individual plugin install/update failures (missing
# host capability or incompatible aoe version) must never abort chezmoi apply.
# Every plugin in the managed inventory is updated with --yes. Capability
# grants and approved manifest hashes stay in the local AoE configuration.
set -uo pipefail

{{ template "brewenv" . }}
# Prepend mise shims so the python3 aoe shells out to for its build step is
# the repo-managed mise one, not a stray system Python.
export PATH="$HOME/.local/share/mise/shims:$PATH"
export XDG_CONFIG_HOME="$HOME/.config"

if ! command -v aoe >/dev/null 2>&1; then
  echo "aoe not found on PATH — skipping aoe plugin install/update" >&2
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 not found on PATH — skipping aoe plugin install/update" >&2
  exit 0
fi
plugin_synced=false

{{ range .packages.aoe_plugins -}}
PLUGIN_DIR="$XDG_CONFIG_HOME/agent-of-empires/plugins/{{ .id }}"
if [ -d "$PLUGIN_DIR" ]; then
  echo "updating aoe plugin {{ .id }}..."
  if aoe plugin update {{ .id }} --yes < /dev/null; then
    plugin_synced=true
  else
    echo "WARN: aoe plugin update {{ .id }} failed" >&2
  fi
else
  echo "installing aoe plugin {{ .id }} from {{ .source }}..."
  if aoe plugin install {{ .source }} --yes < /dev/null; then
    plugin_synced=true
  else
    echo "WARN: aoe plugin install {{ .source }} failed" >&2
  fi
fi
{{ end -}}

# A running daemon may have loaded its pane registry before these plugins
# were installed. Reload once, only when its LaunchAgent is already running.
if [ "$plugin_synced" = true ] && aoe serve --status > /dev/null 2>&1; then
  serve_job="gui/$(id -u)/com.$(id -un).aoe-serve"
  if launchctl print "$serve_job" > /dev/null 2>&1; then
    launchctl kickstart -k "$serve_job" ||
      echo "WARN: could not reload AoE Serve after plugin sync" >&2
  fi
fi
