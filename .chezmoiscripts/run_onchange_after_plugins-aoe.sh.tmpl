#!/bin/bash
# Install/update declared aoe (Agent of Empires) plugins.
# Rerun triggers (chezmoi reruns run_onchange_* scripts whenever their
# rendered content changes):
# aoe_plugins: {{ .packages.aoe_plugins | toJson | sha256sum }}
# aoe_plugins_retired: {{ .packages.aoe_plugins_retired | toJson | sha256sum }}
{{- range .packages.aoe_plugins }}
# plugin-present: {{ .id }}={{ if (joinPath $.chezmoi.homeDir ".config/agent-of-empires/plugins" .id | stat) }}1{{ else }}0{{ end }}
{{- end }}

# Deliberately not -e: individual plugin install/update failures (missing
# host capability or incompatible aoe version) must never abort chezmoi apply.
# Every plugin in the managed inventory is updated with --yes. Capability
# grants and approved manifest hashes stay in the local AoE configuration.
set -uo pipefail

{{ template "brewenv" . }}
# Prepend mise shims so the python3 aoe shells out to for its build step is
# the repo-managed mise one, not a stray system Python.
export PATH="$HOME/.local/share/mise/shims:$PATH"
export XDG_CONFIG_HOME="$HOME/.config"

if ! command -v aoe >/dev/null 2>&1; then
  echo "aoe not found on PATH — skipping aoe plugin install/update" >&2
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 not found on PATH — skipping aoe plugin install/update" >&2
  exit 0
fi
plugin_synced=false

# Ids upstream renamed. Remove the old copy so it does not load beside its
# replacement; config.toml.tmpl drops the matching settings entry.
{{ range .packages.aoe_plugins_retired -}}
if [ -d "$XDG_CONFIG_HOME/agent-of-empires/plugins/{{ .id }}" ]; then
  echo "removing retired aoe plugin {{ .id }} (replaced by {{ .replaced_by }})..."
  # uninstall only knows external plugins; a plugin that was dropped into the
  # directory by hand is listed as local and has to be removed directly.
  if aoe plugin uninstall {{ .id }} < /dev/null 2>/dev/null; then
    plugin_synced=true
  elif rm -rf "$XDG_CONFIG_HOME/agent-of-empires/plugins/{{ .id }}"; then
    plugin_synced=true
  else
    echo "WARN: could not remove retired aoe plugin {{ .id }}" >&2
  fi
fi
{{ end -}}

# Install what is missing and nothing more: aoe updates its own plugins under
# updates.auto_update_plugins, applying only the updates that need no new
# consent and leaving the rest for `aoe plugin update`. Re-implementing that here
# forced updates aoe had decided not to make -- including one whose fetched tree
# the embedded featured index does not verify, which the reserved-namespace gate
# refuses.
{{ range .packages.aoe_plugins -}}
PLUGIN_DIR="$XDG_CONFIG_HOME/agent-of-empires/plugins/{{ .id }}"
if [ ! -d "$PLUGIN_DIR" ]; then
  echo "installing aoe plugin {{ .id }} from {{ .source }}..."
  if aoe plugin install {{ .source }} --yes < /dev/null; then
    plugin_synced=true
  else
    echo "WARN: aoe plugin install {{ .source }} failed" >&2
  fi
fi
{{ end -}}

{{ template "aoe-plugin-tree-fix" . }}
# Some plugins carry the provider-native half of their integration alongside the
# AoE manifest. Link it into the provider's own plugin manager so one installer
# owns both halves: OMP loads it from there, and the link survives `aoe plugin
# update` because that replaces the plugin directory the link resolves into.
{{ range .packages.aoe_plugins }}{{ if index . "omp_extension" -}}
if command -v omp >/dev/null 2>&1; then
  omp_extension_dir="$XDG_CONFIG_HOME/agent-of-empires/plugins/{{ .id }}/{{ .omp_extension }}"
  if [ -d "$omp_extension_dir" ]; then
    omp plugin install "$omp_extension_dir" < /dev/null 2>/dev/null ||
      echo "WARN: could not link the OMP extension from aoe plugin {{ .id }}" >&2
  fi
fi
{{ end }}{{ end -}}

# Installing or updating can leave a plugin present but skipped at load, which
# stops its contributions without failing the sync. Say so instead of leaving
# only the install step's "validation:" line as evidence. An unusable listing is
# not evidence of a skip, so stay quiet when it produces nothing.
plugin_list=$(aoe plugin list 2>/dev/null) || plugin_list=
if [ -n "$plugin_list" ]; then
{{ range .packages.aoe_plugins }}  if ! grep -qE '^{{ .id }}[[:space:]]' <<< "$plugin_list"; then
    echo "WARN: aoe plugin {{ .id }} is installed but did not load" >&2
  fi
{{ end }}fi

# A running daemon may have loaded its pane registry before these plugins
# were installed. Reload once, only when its LaunchAgent is already running.
if [ "$plugin_synced" = true ] && aoe serve --status > /dev/null 2>&1; then
  serve_job="gui/$(id -u)/com.$(id -un).aoe-serve"
  if launchctl print "$serve_job" > /dev/null 2>&1; then
    launchctl kickstart -k "$serve_job" ||
      echo "WARN: could not reload AoE Serve after plugin sync" >&2
  fi
fi
