#!/bin/bash
{{- if hasKey . "local_model" }}
# Raise the macOS GPU wired-memory ceiling (iogpu.wired_limit_mb) for
# capacity/headroom only. Default is ~75% of RAM; bump to
# {{ .local_model.gpu_wired_limit_mb | default 40960 }}MB as a cushion against
# ordinary GPU OOM when running local models. This is NOT a fix for the
# IOGPUFamily residency-race kernel panic (IOGPUMemory.cpp:550) seen with
# mlx-server — those mitigations live in the launchd agent config
# (dot_config/launchd-yaml/agents.yaml: wired-limit no-op shim, reduced
# concurrency) — this script just raises the size ceiling. Sized to
# local_model.gpu_wired_limit_mb (.chezmoidata/local.yaml, or
# local.yaml.example for the schema) — this value is machine-RAM-dependent,
# not a portable default.
set -euo pipefail

SYSCTL_CONF="/etc/sysctl.conf"
SYSCTL_LINE="iogpu.wired_limit_mb={{ .local_model.gpu_wired_limit_mb | default 40960 }}"

if ! grep -qxF "$SYSCTL_LINE" "$SYSCTL_CONF" 2>/dev/null; then
  echo "$SYSCTL_LINE" | sudo tee -a "$SYSCTL_CONF" >/dev/null
fi
CURRENT_OWNER_MODE="$(stat -f '%Su:%Sg %OLp' "$SYSCTL_CONF" 2>/dev/null || echo "")"
if [ "$CURRENT_OWNER_MODE" != "root:wheel 644" ]; then
  sudo chown root:wheel "$SYSCTL_CONF"
  sudo chmod 644 "$SYSCTL_CONF"
fi

CURRENT_VALUE="$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo "")"
if [ "$CURRENT_VALUE" != "{{ .local_model.gpu_wired_limit_mb | default 40960 }}" ]; then
  sudo sysctl iogpu.wired_limit_mb={{ .local_model.gpu_wired_limit_mb | default 40960 }}
fi
{{- else }}
# No .local_model configured on this machine (see local.yaml.example) — no
# local model runs here, so there's no GPU wired-memory ceiling to raise.
{{- end }}
