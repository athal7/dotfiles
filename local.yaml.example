# Machine-specific config for chezmoi.
# Copy to ~/.local/share/chezmoi/.chezmoidata/local.yaml and fill in your values.
# This file is never committed — it lives only on the machine.

# Per-org config keyed by GitHub org login. Orgs not listed fall back to defaults
# (GitHub Issues for issue tracking; no automated code review).
#
# Per-org keys:
#   issues           : "linear" if the org uses Linear (anything else → default GitHub Issues)
#   automated_review : config for AI/embedded code review (Copilot, Codex, etc.). Omit if not available.
#     bot_login : the GitHub user.login the bot posts as (used to filter PR review comments)
#   model_class      : per-org default models for coding-agent CLIs (opencode, omp), applied at
#     aoe session-launch time by ~/.local/bin/aoe-model-class. Class names are omp's own native
#     `modelRoles` vocabulary (default/smol/slow/plan) — values are `provider/model` selector
#     strings used verbatim by both tools. `plan` backs the deep-analysis/architecture subagent;
#     it's a recommended class to set alongside the other three. This is a PARTIAL override: any
#     class you omit here falls back to .chezmoidata/agents.yaml's `model_class`. Two common
#     patterns:
orgs:
  your-work-org:
    issues: linear
    automated_review:
      bot_login: copilot-pull-request-reviewer
    # All-cloud: real coding models for every class.
    model_class:
      default: anthropic/claude-sonnet-5
      smol: anthropic/claude-haiku-4-5
      slow: anthropic/claude-opus-5
      plan: anthropic/claude-opus-5
  your-personal-org:
    # All-local: route every class to a locally-hosted model. Not literally
    # zero cloud spend: models.yaml's compaction_model (mlx/default_model's
    # compactionModel) routes context-compaction summarization for these
    # sessions to a real cloud model (currently anthropic/claude-haiku-4-5)
    # instead of competing with real turns for the local server's single
    # decode-concurrency slot — small, cheap, but real API calls.
    model_class:
      default: mlx/default_model
      smol: mlx/default_model
      slow: mlx/default_model
      plan: mlx/default_model

# Locally-hosted mlx model (Apple Silicon only) served by mlx_lm.server,
# consumed by three templates: dot_config/launchd-yaml/agents.yaml.tmpl
# (mlx-server/mlx-watchdog LaunchAgents), dot_omp/private_agent/models.yml.tmpl
# (omp's mlx provider), and dot_config/agentcfg/agentcfg.yaml.tmpl (opencode's
# mlx provider). Omit this key entirely on a machine that shouldn't run a
# local model — all three templates render without any mlx-server/provider
# entries when .local_model is unset, and .chezmoiscripts/run_once_after_mlx-gpu-wired-limit.sh.tmpl
# is a no-op. host/port/provider/api/api_key/id default sensibly in-template
# (127.0.0.1:8091, provider "mlx", OpenAI-compatible protocol, model id
# "default_model") — only override them here if you actually need to.
#
# The tuning fields below (context_window, prompt_cache_size/bytes,
# prefill_step_size, gpu_wired_limit_mb) are sized to THIS machine's RAM —
# they're not portable defaults. Current values assume a 48GB box running the
# 35B-A3B model below; see the comments in agents.yaml.tmpl for the
# measured-memory reasoning (39.77GB peak / 34.8GB swap before these were
# tightened) if retuning for a different model or RAM size.
local_model:
  hf_repo: mlx-community/Qwen3.6-35B-A3B-OptiQ-4bit
  name: qwen3.6-35b-a3b-optiq
  # Client-advertised context window (omp contextWindow / opencode limit.context)
  # AND the upstream trigger for earlier auto-compaction — kept in lockstep
  # with the server's own --max-tokens cap below.
  context_window: 32000
  max_tokens: 8192
  # LRU cache of KV-caches across distinct conversations (mlx-lm#883/#1666
  # mitigation) — bounds memory without disabling the cache outright (a hit
  # skips prompt reprocessing entirely).
  prompt_cache_size: 4
  prompt_cache_bytes: 3221225472 # 3GiB
  # Per-forward-pass token batch during prompt processing (mlx_lm.server
  # default is 2048) — halving it shrinks the transient activation spike
  # that dominates peak memory on long prompts.
  prefill_step_size: 512
  # macOS iogpu.wired_limit_mb ceiling (headroom only, not the IOGPUFamily
  # panic fix — that's the wired-limit no-op shim in
  # mlx-lm-server-launcher.tmpl). Leave enough gap below total RAM for the
  # OS and everything else running.
  gpu_wired_limit_mb: 40960

# Production service → local repo mapping for the daily fix-prod-errors task.
# Keys are Elastic APM service.name values; values are repo directory names under ~/code.
# Used by the /fix-prod-errors command to decide which repo to create a worktree in.
prod_services:
  your-api-service: your-api-repo
  your-worker-service: your-worker-repo

# Knowledge-base collectors to run during /kb-enrich. Each name maps to a recipe
# file at ~/.config/kb/collectors/<name>.md. Only listed collectors run; omit one
# to disable it without deleting its recipe.
kb:
  collectors: [openspec, opencode, omp, slack, zoom, linear, gh, atlassian]
  # Confluence page ID of the Decision Log container page (the page running the
  # Page Properties Report macro that auto-lists its children). Leave unset/empty
  # to skip Decision Log write-back in /kb-enrich entirely — no Confluence write
  # of any kind happens until you fill this in with your own page ID.
  decision_log_container_page_id: ""

runlayer:
  zoom_mcp_url: ""  # Runlayer MCP proxy URL for the Zoom connector
  self_mcp_url: ""  # Runlayer MCP proxy URL for the self/discovery server
  slack_mcp_url: ""  # Runlayer MCP proxy URL for the Slack connector
  atlassian_mcp_url: ""  # Runlayer MCP proxy URL for the Confluence/Jira connector
  gmail_mcp_url: ""  # Runlayer MCP proxy URL for the Gmail connector
  gcalendar_mcp_url: ""  # Runlayer MCP proxy URL for the Google Calendar connector
  gdrive_mcp_url: ""  # Runlayer MCP proxy URL for the Google Drive connector
  gdocs_mcp_url: ""  # Runlayer MCP proxy URL for the Google Docs connector
  gsheets_mcp_url: ""  # Runlayer MCP proxy URL for the Google Sheets connector

# Secrets manifest — each entry declares a name. Values are stored in the macOS
# Keychain under service "chezmoi" with account = the name. Populate them via:
#   security add-generic-password -U -s "chezmoi" -a "<name>" -w "<value>"
# Agents read values via `security find-generic-password -s chezmoi -a <name> -w` —
# this works non-interactively, including from remote sessions, with no biometric prompts.
secrets:
  es_api_key: {}
  es_url: {}
  pagerduty_api_token: {}
# Calendar configuration
calendars:
  personal:
    name: "Personal"
    sync_to:
      - work
  family:
    name: "Family"
    babysitter_check: true
    # Patterns for sync-calendars (events not copied to other calendars)
    ignore_patterns:
      - CSA Delivery
    # Events whose titles match any of these strings (case-insensitive) are
    # skipped by babysitter-check — use for events where you're with the kids
    # and don't need a sitter (e.g. activities you're attending together).
    babysitter_ignore_patterns:
      - Soccer
      - School Play
  work:
    name: "Work"
    attention_check: true
    sync_to:
      - personal
    lunch_guard: true
    inbound_start: 9
    inbound_end: 17
    inbound_days: [mon, tue, wed, thu, fri]
    title_mappings:
      lunch: Lunch
      standup: Standup

# Reminders lists
reminders:
  personal:
    name: "Personal"
  work:
    name: "Work"
    attention_check: true
