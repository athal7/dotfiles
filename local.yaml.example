# Machine-specific config for chezmoi.
# Copy this shape to the private `.chezmoidata/local.yaml` file in your
# chezmoi source directory and fill in your values.
# Private model defaults rendered by OMP templates.
# `lfm2-350m` must be present in OMP's tiny-model cache. Use
# `omp tiny-models download lfm2-350m` if `omp tiny-models list --json`
# reports that it is absent.
model_class:
  default: openai-codex/gpt-5.6-sol
  plan: openai-codex/gpt-5.6-sol
  slow: openai-codex/gpt-5.6-sol
  smol: openai-codex/gpt-5.6-terra
  vision: openai-codex/gpt-5.6-terra
  designer: "@vision"
  commit: openai-codex/gpt-5.6-terra
  tiny: openai-codex/gpt-5.6-terra
  task: openai-codex/gpt-5.6-sol
prewalk:
  enabled: true
  into: openai-codex/gpt-5.6-sol
# Per-org config keyed by GitHub org login. Orgs not listed fall back to defaults
# (GitHub Issues for issue tracking; no automated code review).
#
#   kb_eligible      : whether GitHub activity from the organization may enrich this KB; omit or false to exclude it.
#   issues           : "linear" if the org uses Linear (anything else → default GitHub Issues)
#   automated_review : config for AI/embedded code review (Copilot, Codex, etc.). Omit if not available.
#     bot_login : the GitHub user.login the bot posts as (used to filter PR review comments)
orgs:
  your-work-org:
    kb_eligible: true
    issues: linear
    automated_review:
      bot_login: copilot-pull-request-reviewer
  your-personal-org:
    kb_eligible: false

# Locally-hosted Apple Silicon model. `server` selects the runtime that owns
# the shared OpenAI-compatible endpoint consumed by the OMP provider and the
# local LaunchAgent. Omit this key entirely on machines that should not run a
# local model.
#
# host, port, provider, api, and api_key have template defaults
# (127.0.0.1:8091, provider "gguf", and OpenAI-compatible protocol).
# Set only values that need an override.
local_model:
  server: llama
  provider: gguf
  hf_repo: unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:UD-Q3_K_XL
  name: qwen3-30b-a3b-instruct-2507
  id: Qwen3-30B-A3B-Instruct-2507
  context_window: 32768
  max_tokens: 8192
  agent_max_tokens: 8192
  compaction_keep_recent_tokens: 12288
  compaction_model: openai-codex/gpt-5.6-terra
  cache_ram: 3G

# Production service → local repo mapping for the daily fix-prod-errors task.
# Keys are Elastic APM service.name values; values are repo directory names under ~/code.
# Used by the /fix-prod-errors command to decide which repo to create a worktree in.
prod_services:
  your-api-service: your-api-repo
  your-worker-service: your-worker-repo

# Knowledge routing configuration. KB owns upstream local projection after its
# capability check succeeds. The policy below permits classified records only
# when every local CQ agent is authorized.
kb:
  collectors: [private, omp, slack, zoom, linear, gh, atlassian]
  # Explicit allowlist for the `private` collector. Each entry declares its
  # access classification. Never use a broad path scan.
  private_sources: []
  local_projection:
    # Set true only after confirming every local CQ agent may read classified data.
    all_local_agents_authorized_for_classified_content: false
  # Confluence page ID of the Decision Log container page. Leave empty to skip
  # Decision Log publication. Every publication still requires per-write approval.
  decision_log_container_page_id: ""
runlayer:
  zoom_mcp_url: ""  # Runlayer MCP proxy URL for the Zoom connector
  self_mcp_url: ""  # Runlayer MCP proxy URL for the self/discovery server
  slack_mcp_url: ""  # Runlayer MCP proxy URL for the Slack connector
  atlassian_mcp_url: ""  # Runlayer MCP proxy URL for the Confluence/Jira connector
  gmail_mcp_url: ""  # Runlayer MCP proxy URL for the Gmail connector
  gcalendar_mcp_url: ""  # Runlayer MCP proxy URL for the Google Calendar connector
  gdrive_mcp_url: ""  # Runlayer MCP proxy URL for the Google Drive connector
  gdocs_mcp_url: ""  # Runlayer MCP proxy URL for the Google Docs connector
  gsheets_mcp_url: ""  # Runlayer MCP proxy URL for the Google Sheets connector

# Runlayer-hosted skills synced into ~/.agents/skills/ by
# run_onchange_after_external-skills.sh. Each entry names the Runlayer namespace
# and the skill slug; only used to compute that script's manifest hash.
runlayer_skills:
  - namespace: "your-namespace"
    skill: your-skill

# Secrets manifest — each entry declares a name. Values are stored in the macOS
# Keychain under service "chezmoi" with account = the name. Populate them via:
#   security add-generic-password -U -s "chezmoi" -a "<name>" -w "<value>"
# Agents read values via `security find-generic-password -s chezmoi -a <name> -w` —
# this works non-interactively, including from remote sessions, with no biometric prompts.
secrets:
  aoe_serve_passphrase: {}
  es_api_key: {}
  openrouter_api_key: {}
  es_url: {}
  pagerduty_api_token: {}
# Calendar configuration
calendars:
  personal:
    name: "Personal"
    sync_to:
      - work
  family:
    name: "Family"
    babysitter_check: true
    # Patterns for sync-calendars (events not copied to other calendars)
    ignore_patterns:
      - CSA Delivery
    # Events whose titles match any of these strings (case-insensitive) are
    # skipped by babysitter-check — use for events where you're with the kids
    # and don't need a sitter (e.g. activities you're attending together).
    babysitter_ignore_patterns:
      - Soccer
      - School Play
  work:
    name: "Work"
    attention_check: true
    # Sync OOO events as all-day on destination calendars.
    # Timed OOO events from Work are normalized to full-day on the target.
    # (Detected automatically via EventKit availability='Unavailable')
    ooo_all_day: true
    sync_to:
      - personal
    lunch_guard: true
    inbound_start: 9
    inbound_end: 17
    inbound_days: [mon, tue, wed, thu, fri]
    title_mappings:
      lunch: Lunch
      standup: Standup

# Reminders lists
reminders:
  personal:
    name: "Personal"
  work:
    name: "Work"
    attention_check: true
