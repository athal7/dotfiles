# Machine-specific config for chezmoi.
# Copy this shape to the private `.chezmoidata/local.yaml` file in your
# chezmoi source directory and fill in your values.
#
# Optional shared Rust cache. Omit rust_cache for local-only caching.
# Credentials stay in the named local AWS profile, not in this file.
rust_cache:
  bucket: your-build-cache
  region: us-east-1
  prefix: maintainers
  profile: your-build-cache
  repository: /path/to/agent-of-empires

# Per-org metadata keyed by GitHub org login. Orgs not listed use GitHub
# Issues for issue tracking and do not use automated code review.
#
#   attention       : dashboard group name for this organization's GitHub issues and PRs.
#                    "Work" places them in the Work group; omit for Open source.
# Attention does not select models. OMP uses its global model preferences in
# every organization; this grouping only separates personal and work credentials.
#   automated_review: config for AI/embedded code review (Copilot, Codex, etc.). Omit if not available.
#     bot_login     : the GitHub user.login the bot posts as; merged into AoE's
#                     ignored commenters without hiding unresolved threads.
# Additional logins in AoE's local ignored_commenters setting are preserved.
orgs:
  your-work-org:
    kb_eligible: true
    issues: linear
    attention: Work
    automated_review:
      bot_login: copilot-pull-request-reviewer
  your-personal-org:
    kb_eligible: false

# Attention items no automation rule may act on, by repository-qualified
# identity ("github:owner/repo#123"). Each listed item is dropped before
# rules match, so it neither starts a session nor raises a nudge -- use it
# for a draft pull request, or anything already being handled elsewhere.
# automation.maxWip: 0 remains the switch for all of automation.
attention_automation_skip: []

# Production service to local repo mapping for scheduled maintenance.
# Keys are Elastic APM service.name values; values are repo directory names under ~/code.
prod_services:
  your-api-service: your-api-repo
  your-worker-service: your-worker-repo

# The KB Markdown vault is canonical for collected facts, source evidence, and access classifications.
kb:
  # Explicit allowlist for the private collector. Each entry declares its
  # access classification. Never use a broad path scan.
  private_sources: []
  # Confluence page ID of the Decision Log container page. Leave empty to skip
  # Decision Log publication. Every publication still requires per-write approval.
  decision_log_container_page_id: ""
runlayer:
  zoom_mcp_url: ""  # Runlayer MCP proxy URL for the Zoom connector
  self_mcp_url: ""  # Runlayer MCP proxy URL for the self/discovery server
  bigquery_mcp_url: ""  # Runlayer MCP proxy URL for the BigQuery connector
  pagerduty_mcp_url: ""  # Runlayer MCP proxy URL for the PagerDuty connector
  slack_mcp_url: ""  # Runlayer MCP proxy URL for the Slack connector
  atlassian_mcp_url: ""  # Runlayer MCP proxy URL for the Confluence/Jira connector
  gmail_mcp_url: ""  # Runlayer MCP proxy URL for the Gmail connector
  gcalendar_mcp_url: ""  # Runlayer MCP proxy URL for the Google Calendar connector
  gdrive_mcp_url: ""  # Runlayer MCP proxy URL for the Google Drive connector
  gdocs_mcp_url: ""  # Runlayer MCP proxy URL for the Google Docs connector
  gsheets_mcp_url: ""  # Runlayer MCP proxy URL for the Google Sheets connector

# Runlayer-hosted skills installed into ~/.agents/skills/ by
# run_onchange_after_external-skills.sh. Each entry names a namespace and skill.
runlayer_skills:
  - namespace: "your-namespace"
    skill: your-skill

# Calendar configuration
calendars:
  personal:
    name: "Personal"
    sync_to:
      - work
  family:
    name: "Family"
    babysitter_check: true
    # Patterns for sync-calendars (events not copied to other calendars)
    ignore_patterns:
      - CSA Delivery
    # Events whose titles match any of these strings (case-insensitive) are
    # skipped by babysitter-check — use for events where you're with the kids
    # and don't need a sitter (e.g. activities you're attending together).
    babysitter_ignore_patterns:
      - Soccer
      - School Play
  work:
    name: "Work"
    attention_check: true
    # Sync OOO events as all-day on destination calendars.
    # Timed OOO events from Work are normalized to full-day on the target.
    # (Detected automatically via EventKit availability='Unavailable')
    ooo_all_day: true
    sync_to:
      - personal
    lunch_guard: true
    inbound_start: 9
    inbound_end: 17
    inbound_days: [mon, tue, wed, thu, fri]
    title_mappings:
      lunch: Lunch
      standup: Standup

# Reminders lists
reminders:
  personal:
    name: "Personal"
  work:
    name: "Work"
    attention_check: true

# OMP model roles rendered into ~/.config/omp/agent/config.yml. These are
# machine- and account-specific: the public template ships no model names, and
# roles you omit here stay unset so OMP falls back to its own defaults.
omp_model_roles:
  advisor: your-provider/your-large-model
  commit: "@smol"
  default: your-provider/your-default-model
  plan: your-provider/your-default-model
  slow: your-provider/your-slow-model
  smol: your-provider/your-small-model
  task: your-provider/your-default-model
  tiny: your-provider/your-tiny-model
  vision: your-provider/your-vision-model

# OMP prewalk rendered into the config's `prewalk` block. `from` is the planning
# model (`@default` when unset) and `into` the model that takes over at the first
# edit (`@smol` when unset). Both take a selector or a role.
omp_prewalk:
  enabled: true
  from: "@slow"
  into: your-provider/your-prewalk-model

# Optional OMP extension modules.
omp_approval_extension_paths: []
