{{ template "brewenv" . }}

# XDG Base Directory paths — asserted unconditionally, not defaulted with
# ${VAR:-...}. Sandboxed parent processes can export their own XDG_* overrides
# for subprocess isolation, and those can leak into and persist in long-lived
# shells such as a tmux server after the parent process is gone.
# Always reasserting here means no inherited value can silently redirect
# this user's shells.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
{{- if hasKey . "runlayer" }}
{{- range $key := keys .runlayer | sortAlpha }}
{{- $url := index $.runlayer $key }}
{{- if and (hasSuffix "_mcp_url" $key) (kindIs "string" $url) (ne $url "") }}
export RUNLAYER_{{ upper (trimSuffix "_mcp_url" $key) }}_MCP_URL={{ $url | quote }}
{{- end }}
{{- end }}
{{- end }}
export XDG_STATE_HOME="$HOME/.local/state"
export PI_CONFIG_DIR=".config/omp"
export PI_CODING_AGENT_DIR="$HOME/.config/omp/agent"

# Use Colima's Docker socket even in shells inheriting a stale DOCKER_HOST.
export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"

# GitHub token — always fresh from gh auth, available in all shells including PTY
command -v gh >/dev/null 2>&1 && export GITHUB_TOKEN=$(gh auth token 2>/dev/null)

# Load Keychain-backed secrets in all shells, including agent PTYs.
[[ -r "$HOME/.envrc" ]] && source "$HOME/.envrc"

# Silence direnv load messages (must be set before direnv hook fires)
export DIRENV_LOG_FORMAT=

# Ensure standard macOS system tools are always reachable (path_helper omits
# these when PATH is already set by the parent process)
export PATH="/usr/sbin:/sbin:$PATH"

# mise shims (available in all shells, including non-interactive)
# User-installed CLI wrappers (including 1Password CLI).
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.local/share/mise/shims:$PATH"
