{{- $settings := dict
  "packages" (list "npm:@gotgenes/pi-subagents" "npm:pi-mcp-adapter")
  "defaultTools" (list "read" "bash" "edit" "write")
  "steeringMode" "all"
  "followUpMode" "all"
  "hideThinkingBlock" true
  "showCacheMissNotices" true
  "quietStartup" true
-}}
{{- if hasKey . "local_model" -}}
{{-   $_ := set $settings "defaultProvider" "local-llama" -}}
{{-   $_ := set $settings "defaultModel" .local_model.id -}}
{{- end -}}
{{ $settings | toPrettyJson }}
