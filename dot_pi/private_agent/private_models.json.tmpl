{{- $providers := dict -}}
{{- $mlxModel := dict
  "id" "default_model"
  "name" "qwen3.6-35b-a3b-optiq"
  "reasoning" true
  "input" (list "text")
  "contextWindow" 40960
  "maxTokens" 8192
  "cost" (dict "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0)
-}}
{{- $_ := set $providers "mlx" (dict
  "baseUrl" "http://127.0.0.1:1234/v1"
  "api" "openai-completions"
  "apiKey" "mlx-local"
  "compat" (dict "supportsDeveloperRole" false "supportsReasoningEffort" false)
  "models" (list $mlxModel)
) -}}
{{- if hasKey . "local_model" -}}
{{-   $localModel := dict
    "id" .local_model.id
    "name" .local_model.name
    "reasoning" false
    "input" (list "text")
    "contextWindow" .local_model.context_window
    "maxTokens" ((index .local_model "agent_max_tokens") | default (index .local_model "max_tokens") | default 4096)
    "cost" (dict "input" 0 "output" 0 "cacheRead" 0 "cacheWrite" 0)
  -}}
{{-   $_ := set $providers "local-llama" (dict
    "name" "Local llama.cpp"
    "baseUrl" (printf "http://%s:%v/v1" ((index .local_model "host") | default "127.0.0.1") ((index .local_model "port") | default 8091))
    "apiKey" ((index .local_model "api_key") | default "llama-local")
    "api" "openai-completions"
    "compat" (dict "supportsDeveloperRole" false "supportsReasoningEffort" false)
    "models" (list $localModel)
  ) -}}
{{- end -}}
{{ dict "providers" $providers | toPrettyJson }}
