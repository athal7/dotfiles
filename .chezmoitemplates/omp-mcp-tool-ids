{{- /* Resolve one MCP server's `tools` allowlist (.chezmoidata/mcp.yaml)
       into the exact omp tool ids it exposes under xd://. omp derives each
       id as mcp__<server, hyphens->underscores>_<raw tool name, lowercased,
       hyphens->underscores> — EXCEPT context7, which omp addresses as
       "context" internally (confirmed empirically; not documented). Every
       other server observed (firefox-devtools, github, and 7 runlayer-*
       servers) matched the mechanical rule exactly, camelCase raw names
       included (they're simply lowercased, no separator inserted).

       This is the single place that encodes the id-derivation rule so the
       per-agent frontmatter tool lists (omp-agents generator) and the
       global tools.approval map (omp-settings generator) can never drift
       from each other.

       ctx: server (one entry from .mcp.servers). Emits a JSON array of ids;
       empty when the server has no tools list yet (see runlayer-self in
       mcp.yaml). */ -}}
{{- $prefix := .server.name | replace "-" "_" -}}
{{- if eq .server.name "context7" -}}{{- $prefix = "context" -}}{{- end -}}
{{- $ids := list -}}
{{- range $t := (default (list) (index .server "tools")) -}}
  {{- $ids = append $ids (printf "mcp__%s_%s" $prefix ($t | lower | replace "-" "_")) -}}
{{- end -}}
{{- $ids | toJson -}}
