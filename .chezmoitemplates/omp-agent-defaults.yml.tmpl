{{ range $package := .packages.brews }}
{{ if and (hasKey $package "permissions") (gt (len $package.permissions) (index $packagePermissionCounts $package.name)) }}
{{ range slice $package.permissions (index $packagePermissionCounts $package.name) }}
    - approval: {{ index $approvalByTier .approval }}
