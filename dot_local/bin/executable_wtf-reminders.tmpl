#!/usr/bin/env python3
import json
import subprocess

def main():
    # Load chezmoi reminders lists
    try:
        res = subprocess.run(["chezmoi", "data", "--format", "json"], capture_output=True, text=True, check=True)
        data = json.loads(res.stdout)
        reminders_config = data.get("reminders", {})
    except Exception:
        print("Reminders config unavailable.")
        return

    target_lists = []
    # Fully customizable reminders list filtering via chezmoi data (wtf.reminders.lists)
    {{- if and (hasKey . "wtf") (hasKey .wtf "reminders") (hasKey .wtf.reminders "lists") }}
    {{- range .wtf.reminders.lists }}
    target_lists.append("{{ . }}")
    {{- end }}
    {{- else }}
    for k, v in reminders_config.items():
        if isinstance(v, dict) and v.get("attention_check"):
            target_lists.append(v.get("name"))

    # Fallback to all configured list names if none are explicitly marked for attention check
    if not target_lists:
        for k, v in reminders_config.items():
            if isinstance(v, dict) and "name" in v:
                target_lists.append(v["name"])
    {{- end }}

    if not target_lists:
        print("No reminders lists configured.")
        return

    # Call remindctl show all --json authoritative dump
    try:
        cmd = ["remindctl", "show", "all", "--json"]
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            print("remindctl CLI not available or failed.")
            return
        all_reminders = json.loads(res.stdout or "[]")
    except Exception as e:
        print(f"Could not load reminders: {e}")
        return

    # Filter to incomplete reminders belonging to target lists
    open_reminders = []
    for r in all_reminders:
        if r.get("completed"):
            continue
        list_name = r.get("list")
        if list_name in target_lists:
            open_reminders.append(r)

    if not open_reminders:
        print("No open reminders.")
        return

    priority_order = {"high": 1, "medium": 2, "low": 3, "none": 4}

    def sort_key(rem):
        prio = rem.get("priority", "none").lower()
        due = rem.get("due_date", "") or "9999-12-31"
        return (due, priority_order.get(prio, 4))

    open_reminders.sort(key=sort_key)

    for r in open_reminders:
        title = r.get("title", "Untitled").strip()
        prio = r.get("priority", "none").lower()
        prio_tag = f" [{prio.upper()}]" if prio != "none" else ""
        due = r.get("due_date", "")
        due_tag = f" (Due: {due[:10]})" if due else ""
        print(f"- {title}{prio_tag}{due_tag}")

if __name__ == "__main__":
    main()
