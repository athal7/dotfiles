#!/bin/bash
set -euo pipefail

for variable in LINEAR_ISSUE_IDENTIFIER LINEAR_ISSUE_BRANCH_NAME LINEAR_WORK_DIR LINEAR_PROMPT; do
  if [[ -z "${!variable:-}" ]]; then
    printf '%s must be set by Linear\n' "$variable" >&2
    exit 64
  fi
done

aoe_bin=${AOE_BIN:-/opt/homebrew/bin/aoe}
if [[ ! -x "$aoe_bin" ]]; then
  printf 'AOE executable not found: %s\n' "$aoe_bin" >&2
  exit 69
fi

repo_root=$(/usr/bin/git -C "$LINEAR_WORK_DIR" rev-parse --show-toplevel 2>/dev/null) || {
  printf 'Linear work directory is not in a Git repository: %s\n' "$LINEAR_WORK_DIR" >&2
  exit 65
}

if [[ -f "$repo_root/.git" ]]; then
  printf 'Linear work directory must be the primary checkout, not a Git worktree: %s\n' "$repo_root" >&2
  exit 65
fi

if ! /usr/bin/git check-ref-format --branch "$LINEAR_ISSUE_BRANCH_NAME" >/dev/null 2>&1; then
  printf 'Linear supplied an invalid Git branch name: %s\n' "$LINEAR_ISSUE_BRANCH_NAME" >&2
  exit 65
fi

new_branch=false
if ! /usr/bin/git -C "$repo_root" show-ref --verify --quiet "refs/heads/$LINEAR_ISSUE_BRANCH_NAME"; then
  new_branch=true
fi

prompt_file=$(mktemp "${TMPDIR:-/tmp}/linear-task.XXXXXXXX")
trap 'rm -f "$prompt_file"' EXIT
printf '%s\n' "$LINEAR_PROMPT" > "$prompt_file"
scheduled_bin=${AOE_SCHEDULED_SESSION_BIN:-"$HOME/.local/bin/aoe-scheduled-session"}
AOE_BIN="$aoe_bin" AOE_TOOL=omp AOE_SESSION_GROUP=Linear \
  AOE_WORKTREE_BRANCH="$LINEAR_ISSUE_BRANCH_NAME" AOE_NEW_BRANCH="$new_branch" \
  "$scheduled_bin" "$LINEAR_ISSUE_IDENTIFIER" "$prompt_file" "$repo_root"
printf 'Started session for %s\n' "$LINEAR_ISSUE_IDENTIFIER"
