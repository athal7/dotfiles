#!/bin/sh
PATH="/opt/homebrew/bin:$PATH"; export PATH
CHEZMOI=${CHEZMOI:-chezmoi}
MARKER=.omp/.aoe-model-class
CONFIG=.omp/config.yml
MCP=.omp/mcp.json
WROTE_CONFIG=false
WROTE_MCP=false

warn() {
  printf 'aoe-model-class: WARN: %s\n' "$*" >&2
}

exclude_omp() {
  [ -d .git ] || return 0
  mkdir -p .git/info 2>/dev/null || return 0
  touch .git/info/exclude 2>/dev/null || return 0
  grep -qxF '.omp/' .git/info/exclude 2>/dev/null && return 0
  printf '.omp/\n' >> .git/info/exclude 2>/dev/null || return 0
}

managed_file() {
  [ -f "$MARKER" ] || return 1
  jq -e --arg file "$1" '.files | index($file)' "$MARKER" >/dev/null 2>&1
}

write_marker() {
  mkdir -p .omp || return 0
  tmp=$(mktemp "${MARKER}.XXXXXX") || return 0
  jq -n --argjson files "$1" '{owner:"aoe-model-class", files:$files}' > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$MARKER" 2>/dev/null || rm -f "$tmp"
}

clear_marker_if_empty() {
  [ -e "$CONFIG" ] || [ -e "$MCP" ] || rm -f "$MARKER" 2>/dev/null || true
  rmdir .omp 2>/dev/null || true
}

legacy_config() {
  [ -f "$CONFIG" ] || return 1
  yq -o=json '.' "$CONFIG" 2>/dev/null | jq -e '
    type == "object"
    and ((keys | sort) as $keys | ($keys == ["modelRoles"] or $keys == ["compaction", "modelRoles"]))
    and (.modelRoles | type == "object")
    and (.modelRoles | keys | sort == ["default", "plan", "slow", "smol"])
    and ([.modelRoles.default, .modelRoles.plan, .modelRoles.slow, .modelRoles.smol] | all(type == "string" and startswith("gguf/")))
    and ([.modelRoles.default, .modelRoles.plan, .modelRoles.slow, .modelRoles.smol] | unique | length == 1)
    and ((has("compaction") | not) or (.compaction | type == "object" and keys == ["keepRecentTokens"] and (.keepRecentTokens | type == "number")))
  ' >/dev/null 2>&1
}

legacy_mcp() {
  names=${1:-[]}
  [ -f "$MCP" ] || return 1
  jq -e --argjson names "$names" '
    type == "object"
    and (keys == ["mcpServers"])
    and (.mcpServers | type == "object")
    and (.mcpServers | length > 0)
    and ($names | length > 0)
    and ((.mcpServers | keys) as $keys | all($keys[]; . as $name | $names | index($name)))
    and (.mcpServers | to_entries | all((.value | type == "object") and (.value.enabled == false)))
  ' "$MCP" >/dev/null 2>&1
}

cleanup_router_state() {
  names=${1:-[]}
  if [ -f "$CONFIG" ]; then
    if managed_file config.yml || legacy_config; then
      rm -f "$CONFIG"
    else
      warn "preserving user-owned $CONFIG"
    fi
  fi
  if [ -f "$MCP" ]; then
    if managed_file mcp.json || legacy_mcp "$names"; then
      rm -f "$MCP"
    else
      warn "preserving user-owned $MCP"
    fi
  fi
  clear_marker_if_empty
}

write_config() {
  roles=$1
  needs_gguf=$2
  keep_recent=$3
  if [ -f "$CONFIG" ] && ! managed_file config.yml && ! legacy_config; then
    warn "preserving user-owned $CONFIG"
    return 0
  fi
  mkdir -p .omp || return 0
  tmp=$(mktemp "${CONFIG}.XXXXXX") || return 0
  if [ "$needs_gguf" = true ]; then
    jq -n --argjson roles "$roles" --argjson keep "$keep_recent" '{modelRoles:$roles, compaction:{keepRecentTokens:$keep}}' \
      | yq -p=json -o=yaml '.' > "$tmp" || { rm -f "$tmp"; return 0; }
  else
    jq -n --argjson roles "$roles" '{modelRoles:$roles}' \
      | yq -p=json -o=yaml '.' > "$tmp" || { rm -f "$tmp"; return 0; }
  fi
  if mv "$tmp" "$CONFIG" 2>/dev/null; then
    WROTE_CONFIG=true
  else
    rm -f "$tmp"
  fi
}

write_mcp() {
  names=$1
  if [ "$(printf '%s' "$names" | jq 'length' 2>/dev/null)" = 0 ]; then
    if [ -f "$MCP" ]; then
      if managed_file mcp.json || legacy_mcp "$names"; then
        rm -f "$MCP"
      else
        warn "preserving user-owned $MCP"
      fi
    fi
    return 0
  fi
  if [ -f "$MCP" ] && ! managed_file mcp.json && ! legacy_mcp "$names"; then
    warn "preserving user-owned $MCP"
    return 0
  fi
  global_mcp="$HOME/.omp/agent/mcp.json"
  [ -f "$global_mcp" ] || return 0
  mkdir -p .omp || return 0
  tmp=$(mktemp "${MCP}.XXXXXX") || return 0
  jq -n --argjson names "$names" --slurpfile global "$global_mcp" '
    reduce $names[] as $name
      ({mcpServers:{}};
        if $global[0].mcpServers[$name] then
          .mcpServers[$name] = ($global[0].mcpServers[$name] | del(.headers, .env, .environment) + {enabled:false})
        else . end)
  ' > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  if [ "$(jq '.mcpServers | length' "$tmp" 2>/dev/null)" = 0 ]; then
    rm -f "$tmp" "$MCP"
    return 0
  fi
  if mv "$tmp" "$MCP" 2>/dev/null; then
    WROTE_MCP=true
  else
    rm -f "$tmp"
  fi
}

main() {
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  cd "$root" || return 0
  data=$($CHEZMOI data --format=json 2>/dev/null) || return 0
  all_names=$(printf '%s' "$data" | jq -c '[.mcp_servers[]? | select((.exclude_for_models // []) | length > 0) | .name] | unique' 2>/dev/null) || all_names='[]'
  remote=$(git remote get-url origin 2>/dev/null) || { cleanup_router_state "$all_names"; return 0; }
  owner=$(printf '%s\n' "$remote" | sed -E 's#.*[:/]([^/]+)/[^/]+(\.git)?$#\1#')
  roles=$(printf '%s' "$data" | jq -cer --arg owner "$owner" '
    (.model_class // {}) as $global
    | (.orgs[$owner].model_class // empty) as $org
    | $global * $org
  ' 2>/dev/null) || { cleanup_router_state "$all_names"; return 0; }
  if [ -z "$roles" ] || [ "$roles" = "null" ]; then
    cleanup_router_state "$all_names"
    return 0
  fi
  selectors=$(printf '%s' "$roles" | jq -c '
    def resolve($roles):
      . as $value
      | if ($value | type == "string" and startswith("@")) then
          ($roles[$value[1:]] // empty | resolve($roles))
        else $value end;
    . as $roles | [.[] | resolve($roles)] | unique
  ' 2>/dev/null) || return 0
  needs_gguf=$(printf '%s' "$selectors" | jq -r 'any(.[]; type == "string" and startswith("gguf/"))')
  keep_recent=8192
  names=$(printf '%s' "$data" | jq -c --argjson selectors "$selectors" '
    [.mcp_servers[]? | select((.exclude_for_models // []) as $excluded | any($selectors[]; . as $selector | $excluded | index($selector))) | .name] | unique
  ' 2>/dev/null) || names='[]'
  exclude_omp
  write_config "$roles" "$needs_gguf" "$keep_recent"
  write_mcp "$names"
  files=$(jq -n --argjson wrote_config "$WROTE_CONFIG" --argjson wrote_mcp "$WROTE_MCP" '
    [] + (if $wrote_config then ["config.yml"] else [] end) + (if $wrote_mcp then ["mcp.json"] else [] end)
  ')
  if [ "$(printf '%s' "$files" | jq 'length')" -gt 0 ]; then
    write_marker "$files"
  else
    clear_marker_if_empty
  fi
}

main
exit 0
