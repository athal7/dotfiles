#!/bin/sh
# omp-billed — aoe-scoped wrapper around `omp` (@oh-my-pi/pi-coding-agent).
#
# WHY: opencode and omp each need to bill against their own Anthropic API key
# so usage shows up separately in the Anthropic console. omp has no
# persistent non-OAuth credential storage (`auth-broker import` only accepts
# OAuth-shaped JSON; `--api-key` is session-only), so the only way to point
# omp at its own key is exporting ANTHROPIC_API_KEY right before it launches.
#
# SCOPE: this script is wired in only via aoe's `session.agent_command_override`
# (dot_agent-of-empires/modify_config.toml), so it applies to aoe-dispatched
# omp sessions only — bare terminal `omp` invocations are untouched and keep
# using whatever env/OAuth they'd otherwise fall through to.
#
# Never blocks a launch: if the Keychain read fails for any reason (locked,
# item missing, ACL denial), just skip the export and let omp fall through.

key=$(security find-generic-password -s chezmoi -a omp_anthropic_api_key -w 2>/dev/null)
if [ -n "$key" ]; then
  ANTHROPIC_API_KEY="$key"
  export ANTHROPIC_API_KEY
fi

exec omp "$@"
