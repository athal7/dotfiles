#!/bin/sh
# omp-billed — aoe-scoped wrapper around `omp` (@oh-my-pi/pi-coding-agent).
#
# WHY: opencode and omp each need to bill against their own Anthropic API key
# so usage shows up separately in the Anthropic console. omp has no
# persistent non-OAuth credential storage (`auth-broker import` only accepts
# OAuth-shaped JSON; `--api-key` is session-only), so the only way to point
# omp at its own key is exporting ANTHROPIC_API_KEY right before it launches.
#
# SCOPE: this script is wired in only via aoe's `session.agent_command_override`
# (dot_agent-of-empires/modify_config.toml), so it applies to aoe-dispatched
# omp sessions only — bare terminal `omp` invocations are untouched and keep
# using whatever env/OAuth they'd otherwise fall through to.
#
# BLOCKS THE LAUNCH ON FAILURE: a failed keychain read used to be silently
# swallowed, letting omp launch key-less and quietly fall back to whatever
# local model was configured — indistinguishable from a model-routing bug.
# Now a failed read refuses to launch omp at all: it logs to
# ~/Library/Logs/omp-billed.error.log (picked up by check-error-logs' daily
# scan) and exits nonzero, so the aoe session fails loudly instead of
# quietly misrouting.

key=$(security find-generic-password -s chezmoi -a omp_anthropic_api_key -w 2>/dev/null)
status=$?
if [ -z "$key" ]; then
  mkdir -p "$HOME/Library/Logs" 2>/dev/null
  printf '%s omp-billed: keychain read failed (exit %s) — refusing to launch omp without ANTHROPIC_API_KEY\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$status" >> "$HOME/Library/Logs/omp-billed.error.log" 2>/dev/null
  printf 'omp-billed: keychain read for chezmoi/omp_anthropic_api_key failed (security exit %s) — refusing to launch omp without ANTHROPIC_API_KEY. Unlock the login keychain and retry.\n' "$status" >&2
  exit 1
fi

ANTHROPIC_API_KEY="$key"
export ANTHROPIC_API_KEY
exec omp "$@"
