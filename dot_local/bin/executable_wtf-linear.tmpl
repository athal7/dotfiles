#!/usr/bin/env python3
import json
import os
import subprocess
import urllib.request
import urllib.error

def get_token():
    try:
        res = subprocess.run(
            ["security", "find-generic-password", "-s", "chezmoi", "-a", "linear_api_token", "-w"],
            capture_output=True, text=True, check=True, timeout=10
        )
        return res.stdout.strip()
    except subprocess.TimeoutExpired:
        return os.environ.get("LINEAR_API_TOKEN") or os.environ.get("LINEAR_TOKEN")
    except Exception:
        return os.environ.get("LINEAR_API_TOKEN") or os.environ.get("LINEAR_TOKEN")

def find_issue_nodes(data):
    if isinstance(data, list):
        for item in data:
            yield from find_issue_nodes(item)
    elif isinstance(data, dict):
        if "identifier" in data and "title" in data:
            yield data
        else:
            for val in data.values():
                yield from find_issue_nodes(val)

def main():
    token = get_token()
    if not token:
        print("Linear token not set in keychain or env.")
        return

    # Fully customizable GraphQL query via chezmoi data (wtf.linear.query)
    {{- if and (hasKey . "wtf") (hasKey .wtf "linear") (hasKey .wtf.linear "query") }}
    query = {{ .wtf.linear.query | toJson }}
    {{- else }}
    query = """
    query {
      viewer {
        assignedIssues(filter: { state: { name: { neq: "Done" } } }) {
          nodes {
            identifier
            title
            state {
              name
            }
          }
        }
      }
    }
    """
    {{- end }}

    req = urllib.request.Request(
        "https://api.linear.app/graphql",
        data=json.dumps({"query": query}).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": token
        },
        method="POST"
    )

    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            res_data = json.loads(response.read().decode("utf-8"))
            if "errors" in res_data:
                print("Linear API Error:", res_data["errors"][0].get("message"))
                return

            # Recursively find any issue nodes in the response payload
            nodes = list(find_issue_nodes(res_data.get("data", {})))
            if not nodes:
                print("No active Linear issues found.")
                return
            for node in nodes:
                identifier = node.get("identifier")
                title = node.get("title")
                state = node.get("state", {}).get("name", "Unknown") if isinstance(node.get("state"), dict) else "Unknown"
                print(f"[{identifier}] {title} ({state})")
    except urllib.error.URLError as e:
        print(f"Linear service unavailable: {e.reason}")
    except Exception as e:
        print(f"Error querying Linear: {e}")

if __name__ == "__main__":
    main()
