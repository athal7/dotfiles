#!/bin/sh
set -eu

usage() {
  echo "Usage: aoe-cmd [-d DIR | -s] -n NAME [-w WORKTREE_BRANCH] [-b] [-t omp] MESSAGE..." >&2
}

dir=""
scratch=0
name=""
worktree=""
new_branch=0

while getopts "d:sn:w:bt:" opt; do
  case "$opt" in
    d) dir="$OPTARG" ;;
    s) scratch=1 ;;
    n) name="$OPTARG" ;;
    w) worktree="$OPTARG" ;;
    b) new_branch=1 ;;
    t)
      if [ "$OPTARG" != "omp" ]; then
        echo "aoe-cmd: only the OMP tool is supported" >&2
        exit 1
      fi
      ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

message="$*"

if [ -z "$name" ] || [ -z "$message" ] || { [ "$scratch" -eq 0 ] && [ -z "$dir" ]; } || { [ "$scratch" -eq 1 ] && [ -n "$dir" ]; } || { [ "$scratch" -eq 1 ] && { [ -n "$worktree" ] || [ "$new_branch" -eq 1 ]; }; }; then
  usage
  exit 1
fi

title="${name}-$(date +%Y%m%d-%H%M%S)"

if [ "$scratch" -eq 1 ]; then
  set -- --scratch --title "$title" --tool omp
else
  set -- "$dir" --title "$title" --tool omp
fi
if [ -n "$worktree" ]; then
  set -- "$@" --worktree "$worktree"
fi
if [ "$new_branch" -eq 1 ]; then
  set -- "$@" --new-branch
fi

if ! add_output=$(aoe add "$@"); then
  echo "aoe-cmd: 'aoe add' failed for session '$title'" >&2
  exit 1
fi

id=$(printf '%s\n' "$add_output" | awk '/^  ID:/ {print $2}')

if [ -z "$id" ]; then
  echo "aoe-cmd: could not parse session ID from 'aoe add' output for '$title':" >&2
  printf '%s\n' "$add_output" >&2
  exit 1
fi
sleep 2

printf '%s\n' "$add_output"

if ! start_output=$(aoe session start "$id" 2>&1); then
  echo "aoe-cmd: 'aoe session start' failed for session '$title' (id $id)" >&2
  printf '%s\n' "$start_output" >&2
  exit 1
fi

ready_timeout="${AOE_CMD_READY_TIMEOUT:-30}"
poll_interval="${AOE_CMD_POLL_INTERVAL:-1}"
waited=0
ready=0
pane=""
while [ "$waited" -lt "$ready_timeout" ]; do
  sleep "$poll_interval"
  waited=$((waited + poll_interval + (poll_interval == 0)))
  pane=$(aoe session capture "$id" --lines 50 --strip-ansi 2>/dev/null) || pane=""
  case "$pane" in
    *"⬢"*) ready=1; break ;;
  esac
done

if [ "$ready" -ne 1 ]; then
  echo "aoe-cmd: OMP TUI never became ready after ${ready_timeout}s for session '$title' (id $id); not sending" >&2
  printf '%s\n' "$pane" >&2
  exit 1
fi

if ! send_output=$(aoe send "$id" "$message" 2>&1); then
  echo "aoe-cmd: 'aoe send' failed for session '$title' (id $id)" >&2
  printf '%s\n' "$send_output" >&2
  exit 1
fi

echo "aoe-cmd: dispatched '$title' (id $id)"
