#!/bin/sh
# Run AoE behind the node's private Tailscale Serve proxy.
set -eu

# Use AoE's native token auth even if launchd inherited an old passphrase.
unset AOE_SERVE_PASSPHRASE

# The full Linear plugin resolves LINEAR_API_KEY only from this daemon's
# environment, so supply it here before the daemon (and its plugin workers)
# inherit it. The item is service "chezmoi", account "linear_api_key"; a
# failed lookup is logged instead of silently leaving the plugin unauthenticated.
if [ -z "${LINEAR_API_KEY:-}" ] && [ -z "${LINEAR_TOKEN:-}" ]; then
  linear_ok=
  if [ -r "$HOME/.config/direnv/lib/keychain.sh" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.config/direnv/lib/keychain.sh"
    if keychain_env LINEAR_API_KEY linear_api_key 2>/dev/null && [ -n "${LINEAR_API_KEY:-}" ]; then
      linear_ok=1
    fi
  fi
  if [ -z "$linear_ok" ]; then
    linear_key=$(/usr/bin/security find-generic-password -s chezmoi -a linear_api_key -w 2>/dev/null) || linear_key=
    if [ -n "${linear_key:-}" ]; then
      LINEAR_API_KEY=$linear_key
      export LINEAR_API_KEY
      linear_ok=1
    fi
  fi
  if [ -z "$linear_ok" ]; then
    printf 'aoe-serve: no LINEAR_API_KEY in the environment or Keychain (service chezmoi, account linear_api_key)\n' >&2
  fi
fi

# Supply baseline credentials to the daemon for workers without project-specific
# overrides. Structured OMP workers also run before_session for their own cwd.
if [ -x "$HOME/.local/bin/aoe-omp-environment" ]; then
  omp_environment=$(AOE_TOOL=omp "$HOME/.local/bin/aoe-omp-environment" 2>/dev/null) || omp_environment=
  while IFS= read -r assignment; do
    key=${assignment%%=*}
    case $key in
      ANTHROPIC_API_KEY|OTARI_API_KEY|SPACELIFT_MCP_URL) export "$key=${assignment#*=}" ;;
    esac
  done <<EOF
$omp_environment
EOF
fi

dns_name=$(/opt/homebrew/bin/tailscale status --json | /opt/homebrew/bin/jq -er '.Self.DNSName')
dns_name=${dns_name%.}

if [ -z "$dns_name" ]; then
  mkdir -p "$HOME/Library/Logs" 2>/dev/null
  printf '%s aoe-serve: tailscale DNS name is empty — refusing to start with --allowed-host ""\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" >> "$HOME/Library/Logs/aoe-serve.error.log" 2>/dev/null
  printf 'aoe-serve: tailscale DNS name is empty — check Tailscale connectivity and retry.\n' >&2
  exit 1
fi

# AoE keeps one daemon per app dir, and a served daemon inherits the environment
# of whatever started it. This script is the only starter that carries
# LINEAR_API_KEY and the Tailscale proxy flags, so it must own that daemon.
#
# AoE can restart itself into a detached daemon (e.g. after an update); that one
# keeps this port, so wait for it rather than fighting over a second server. A
# daemon on any other port came from a TUI, CLI, or agent that needed one first:
# it has no Linear credential, so retire it instead of waiting on it forever.
serve_port=4097
retiring=
# Probe with --no-autostart: a plain `serve --status` starts a daemon when none
# is running, which would keep this loop waiting on the server it looks for.
while status=$("$HOME/.local/bin/aoe" serve --status --no-autostart 2>/dev/null); do
  port=$(printf '%s\n' "$status" \
    | sed -n 's|^URL: *http://[^/:]*:\([0-9][0-9]*\)/.*|\1|p' | head -n 1)
  if [ "$port" = "$serve_port" ]; then
    sleep 5
    continue
  fi
  if [ -z "$retiring" ]; then
    printf 'aoe-serve: retiring the daemon on port %s to take ownership\n' \
      "${port:-unknown}" >&2
    retiring=1
  fi
  # `aoe serve --stop` refuses a daemon it holds no launch record for, so signal
  # the PID the status reports; it is the same SIGTERM its own stop sends.
  daemon_pid=$(printf '%s\n' "$status" \
    | sed -n 's|^Daemon: *running (PID \([0-9][0-9]*\)).*|\1|p' | head -n 1)
  if [ -n "$daemon_pid" ]; then
    kill -TERM "$daemon_pid" 2>/dev/null || true
  fi
  sleep 5
done
exec "$HOME/.local/bin/aoe" serve \
  --host 127.0.0.1 \
  --port "$serve_port" \
  --allowed-host "$dns_name" \
  --behind-proxy \
  --allowed-origin "https://$dns_name:$serve_port" \
  --auth token
