#!/bin/sh
# Run AoE behind the node's private Tailscale Serve proxy.
set -eu

# Use AoE's native token auth even if launchd inherited an old passphrase.
unset AOE_SERVE_PASSPHRASE

# The full Linear plugin resolves LINEAR_API_KEY only from this daemon's
# environment, so supply it here before the daemon (and its plugin workers)
# inherit it. The item is service "chezmoi", account "linear_api_key"; a
# failed lookup is logged instead of silently leaving the plugin unauthenticated.
if [ -z "${LINEAR_API_KEY:-}" ] && [ -z "${LINEAR_TOKEN:-}" ]; then
  linear_ok=
  if [ -r "$HOME/.config/direnv/lib/keychain.sh" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.config/direnv/lib/keychain.sh"
    if keychain_env LINEAR_API_KEY linear_api_key 2>/dev/null && [ -n "${LINEAR_API_KEY:-}" ]; then
      linear_ok=1
    fi
  fi
  if [ -z "$linear_ok" ]; then
    linear_key=$(/usr/bin/security find-generic-password -s chezmoi -a linear_api_key -w 2>/dev/null) || linear_key=
    if [ -n "${linear_key:-}" ]; then
      LINEAR_API_KEY=$linear_key
      export LINEAR_API_KEY
      linear_ok=1
    fi
  fi
  if [ -z "$linear_ok" ]; then
    printf 'aoe-serve: no LINEAR_API_KEY in the environment or Keychain (service chezmoi, account linear_api_key)\n' >&2
  fi
fi

# Structured (ACP) workers inherit this daemon's environment instead of running
# the before_session hook, so export the credentials that hook gives terminal
# OMP sessions. The OMP config roots already arrive from the launchd environment.
if [ -x "$HOME/.local/bin/aoe-omp-environment" ]; then
  omp_environment=$(AOE_TOOL=omp "$HOME/.local/bin/aoe-omp-environment" 2>/dev/null) || omp_environment=
  while IFS= read -r assignment; do
    key=${assignment%%=*}
    case $key in
      ANTHROPIC_API_KEY|OTARI_API_KEY|GITHUB_TOKEN|SPACELIFT_MCP_URL) export "$key=${assignment#*=}" ;;
    esac
  done <<EOF
$omp_environment
EOF
fi

dns_name=$(/opt/homebrew/bin/tailscale status --json | /opt/homebrew/bin/jq -er '.Self.DNSName')
dns_name=${dns_name%.}

if [ -z "$dns_name" ]; then
  mkdir -p "$HOME/Library/Logs" 2>/dev/null
  printf '%s aoe-serve: tailscale DNS name is empty — refusing to start with --allowed-host ""\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" >> "$HOME/Library/Logs/aoe-serve.error.log" 2>/dev/null
  printf 'aoe-serve: tailscale DNS name is empty — check Tailscale connectivity and retry.\n' >&2
  exit 1
fi

# AoE can restart itself into a detached daemon (e.g. after an update). Keep
# launchd from repeatedly starting a second server while that daemon is alive;
# take ownership again when it stops.
while /opt/homebrew/bin/aoe serve --status >/dev/null 2>&1; do
  sleep 5
done
exec /opt/homebrew/bin/aoe serve \
  --host 127.0.0.1 \
  --port 4097 \
  --allowed-host "$dns_name" \
  --behind-proxy \
  --allowed-origin "https://$dns_name:4097" \
  --auth token
