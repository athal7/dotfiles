#!/bin/sh
# Run AoE behind the node's private Tailscale Serve proxy.
set -eu

# A non-loopback allowed host requires a persistent passphrase. Store it in
# the login keychain rather than in the public dotfiles repository.
if passphrase=$(security find-generic-password -s chezmoi -a aoe_serve_passphrase -w 2>/dev/null); then
  status=0
else
  status=$?
fi
if [ -z "$passphrase" ]; then
  mkdir -p "$HOME/Library/Logs" 2>/dev/null
  printf '%s aoe-serve: keychain read failed (exit %s) — refusing to start remote AoE Serve without AOE_SERVE_PASSPHRASE\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$status" >> "$HOME/Library/Logs/aoe-serve.error.log" 2>/dev/null
  printf 'aoe-serve: keychain read for chezmoi/aoe_serve_passphrase failed (security exit %s) — unlock the login keychain and retry.\n' "$status" >&2
  exit 1
fi

dns_name=$(/opt/homebrew/bin/tailscale status --json | /opt/homebrew/bin/jq -er '.Self.DNSName')
dns_name=${dns_name%.}

if [ -z "$dns_name" ]; then
  mkdir -p "$HOME/Library/Logs" 2>/dev/null
  printf '%s aoe-serve: tailscale DNS name is empty — refusing to start with --allowed-host ""\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" >> "$HOME/Library/Logs/aoe-serve.error.log" 2>/dev/null
  printf 'aoe-serve: tailscale DNS name is empty — check Tailscale connectivity and retry.\n' >&2
  exit 1
fi

exec /opt/homebrew/bin/aoe serve \
  --host 127.0.0.1 \
  --port 4097 \
  --allowed-host "$dns_name" \
  --passphrase "$passphrase"
