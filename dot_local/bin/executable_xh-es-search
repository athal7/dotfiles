#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  printf 'usage: xh-es-search <index-expression>\n' >&2
  exit 2
fi

index=$1
case "$index" in
  ""|-*|*[!A-Za-z0-9._,*-]*)
    printf 'xh-es-search: invalid index expression\n' >&2
    exit 2
    ;;
esac

if [ "${ES_URL+x}" != x ]; then
  host=$(chezmoi data --format=json 2>/dev/null | jq -er '.esHost | select(type == "string" and length > 0)' 2>/dev/null) || {
    printf 'xh-es-search: ES_URL is required; configure chezmoi esHost\n' >&2
    exit 2
  }
  case $host in
    *[!A-Za-z0-9.-]*|[-.]*|*[-.]|*..*|*.-*|*-.*)
      printf 'xh-es-search: invalid chezmoi esHost\n' >&2
      exit 2
      ;;
  esac
  export ES_URL="https://$host"
fi
if [ -z "$ES_URL" ]; then
  printf 'xh-es-search: ES_URL is required\n' >&2
  exit 2
fi

if [ -z "${PAYLOAD:-}" ]; then
  printf 'xh-es-search: PAYLOAD is required\n' >&2
  exit 2
fi

base_url=${ES_URL%/}
exec xh --ignore-stdin --session-read-only=agent POST "$base_url/$index/_search" 'Content-Type:application/json' --raw "$PAYLOAD"
