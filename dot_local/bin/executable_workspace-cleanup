#!/usr/bin/env python3
"""Reclaim idle worktrees, stale Chrome clones, and development/test databases."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

CODE = Path(os.environ.get("WORKSPACE_CLEANUP_CODE_ROOT", Path.home() / "code"))
DATABASE_NAME = re.compile(r"(?:^|_)(?:development|test)(?:_|$)")
TARGET_STALE_DAYS = 30
CHROME_CLONE_STALE_SECONDS = 24 * 60 * 60


def run(*args, check=True):
    return subprocess.run(args, text=True, capture_output=True, check=check)


def registered_sessions():
    result = run("aoe", "list", "--all", "--json")
    return {str(Path(entry["path"]).resolve()) for entry in json.loads(result.stdout) if entry.get("path")}


def worktrees(dry_run):
    try:
        sessions = registered_sessions()
    except (OSError, subprocess.CalledProcessError, ValueError, KeyError) as error:
        print(f"Skipping worktrees: cannot read AOE sessions: {error}", file=sys.stderr)
        return

    for repo in CODE.iterdir():
        repo = repo.resolve()
        if not (repo / ".git").exists():
            continue
        try:
            entries = run("git", "-C", str(repo), "worktree", "list", "--porcelain").stdout
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"Skipping {repo}: {error}", file=sys.stderr)
            continue
        for entry in entries.strip().split("\n\n"):
            fields = entry.splitlines()
            path = Path(fields[0].removeprefix("worktree ")).resolve() if fields else repo
            head = next((line[5:] for line in fields if line.startswith("HEAD ")), None)
            if path == repo or not path.is_dir() or not head or str(path) in sessions:
                continue
            if any(line.startswith("locked") for line in fields):
                continue
            if run("git", "-C", str(path), "status", "--porcelain=v1", check=False).stdout.strip():
                continue
            merged = any(
                run("git", "-C", str(repo), "merge-base", "--is-ancestor", head, ref, check=False).returncode == 0
                for ref in ("main", "origin/main")
            )
            target = path / "target"
            if not merged:
                if not (path / "Cargo.toml").is_file():
                    continue
                if target.is_symlink() or not target.is_dir():
                    continue
                if run("git", "-C", str(path), "check-ignore", "-q", "--", "target", check=False).returncode != 0:
                    continue
                tracked = run("git", "-C", str(path), "ls-files", "-z", "--", "target", check=False)
                if tracked.returncode or tracked.stdout:
                    continue
                recent = run("find", str(target), "-mtime", f"-{TARGET_STALE_DAYS}", "-print", "-quit", check=False)
                if recent.returncode or recent.stdout:
                    continue
            opened = run("lsof", "-nP", "+D", str(path), check=False)
            if opened.returncode not in (0, 1) or opened.stdout.strip():
                continue
            if merged:
                print(f"worktree: {path}")
                if not dry_run:
                    removed = run("git", "-C", str(repo), "worktree", "remove", str(path), check=False)
                    if removed.returncode:
                        print(f"Cannot remove {path}: {removed.stderr.strip()}", file=sys.stderr)
            else:
                print(f"build artifacts: {target}")
                if not dry_run:
                    try:
                        shutil.rmtree(target)
                    except OSError as error:
                        print(f"Cannot remove {target}: {error}", file=sys.stderr)


def databases(dry_run):
    try:
        result = run("psql", "-At", "-d", "postgres", "-c", "SELECT datname FROM pg_database WHERE datistemplate = false ORDER BY datname")
        names = (name for name in result.stdout.splitlines() if DATABASE_NAME.search(name))
        for name in names:
            # A concurrent connection makes dropdb fail; never terminate sessions.
            active = run("psql", "-At", "-d", "postgres", "-v", "name=" + name,
                         "-c", "SELECT 1 FROM pg_stat_activity WHERE datname = :'name' LIMIT 1", check=False)
            if active.returncode or active.stdout.strip():
                continue
            print(f"database: {name}")
            if not dry_run:
                dropped = run("dropdb", "--if-exists", "--", name, check=False)
                if dropped.returncode:
                    print(f"Cannot drop {name}: {dropped.stderr.strip()}", file=sys.stderr)
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"Skipping databases: {error}", file=sys.stderr)


def chrome_clone_root():
    try:
        temp = Path(run("/usr/bin/getconf", "DARWIN_USER_TEMP_DIR").stdout.strip()).resolve()
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"Skipping Chrome clones: cannot locate macOS temp directory: {error}", file=sys.stderr)
        return None
    if temp.name != "T" or temp.parent.parent.parent.name != "folders":
        print(f"Skipping Chrome clones: unexpected macOS temp directory {temp}", file=sys.stderr)
        return None
    return temp.parent / "X" / "com.google.Chrome.code_sign_clone"


def chrome_clones(dry_run):
    root = chrome_clone_root()
    if root is None or root.is_symlink() or not root.is_dir():
        return
    cutoff = time.time() - CHROME_CLONE_STALE_SECONDS
    try:
        candidates = [
            path
            for path in root.iterdir()
            if path.name.startswith("code_sign_clone.")
            and not path.is_symlink()
            and path.is_dir()
            and path.lstat().st_mtime <= cutoff
        ]
    except OSError as error:
        print(f"Skipping Chrome clones: cannot inspect {root}: {error}", file=sys.stderr)
        return
    if not candidates:
        return
    try:
        processes = run("pgrep", "-fl", "Google Chrome", check=False)
        if processes.returncode == 0 and processes.stdout.strip():
            print("Skipping Chrome clones: Google Chrome is running", file=sys.stderr)
            return
        if processes.returncode != 1 or processes.stdout.strip() or processes.stderr.strip():
            print("Skipping Chrome clones: cannot establish that Google Chrome is stopped", file=sys.stderr)
            return
        opened = run("lsof", "-nP", "+D", str(root), check=False)
    except OSError as error:
        print(f"Skipping Chrome clones: cannot check for active use: {error}", file=sys.stderr)
        return
    if opened.returncode not in (0, 1) or opened.stdout.strip() or opened.stderr.strip():
        print("Skipping Chrome clones: cannot establish that the clone tree is unused", file=sys.stderr)
        return
    for path in candidates:
        print(f"Chrome signing clone: {path}")
        if not dry_run:
            try:
                shutil.rmtree(path)
            except OSError as error:
                print(f"Cannot remove {path}: {error}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="remove eligible resources (default: dry-run)")
    parser.add_argument("--database-only", action="store_true", help="skip worktree and Chrome clone cleanup")
    args = parser.parse_args()
    state = Path.home() / ".local/state"
    state.mkdir(parents=True, exist_ok=True)
    with (state / "workspace-cleanup.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Cleanup already running", file=sys.stderr)
            return 0
        if not args.database_only:
            worktrees(not args.apply)
            chrome_clones(not args.apply)
        databases(not args.apply)
    return 0


if __name__ == "__main__":
    sys.exit(main())
