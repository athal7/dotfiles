#!/usr/bin/env python3
import json
import subprocess
from datetime import date, datetime, timedelta
from pathlib import Path

def get_ical_path():
    try:
        which = subprocess.run(["which", "ical"], capture_output=True, text=True)
        if which.returncode == 0 and which.stdout.strip():
            return which.stdout.strip()
    except Exception:
        pass
    local_path = Path.home() / ".local/bin/ical"
    return str(local_path) if local_path.exists() else "ical"

def main():
    # Load chezmoi calendars
    try:
        res = subprocess.run(["chezmoi", "data", "--format", "json"], capture_output=True, text=True, check=True)
        data = json.loads(res.stdout)
        calendars = data.get("calendars", {})
    except Exception:
        print("Calendar config unavailable.")
        return

    cal_names = []
    for k, v in calendars.items():
        if isinstance(v, dict) and "name" in v:
            cal_names.append(v["name"])

    if not cal_names:
        print("No calendars configured.")
        return

    ical_bin = get_ical_path()
    today_str = str(date.today())
    tomorrow_str = str(date.today() + timedelta(days=1))

    events = []
    for cal in cal_names:
        try:
            cmd = [ical_bin, "list", "-c", cal, "--from", today_str, "--to", tomorrow_str, "-o", "json"]
            res = subprocess.run(cmd, capture_output=True, text=True)
            if res.returncode == 0 and res.stdout.strip():
                cal_events = json.loads(res.stdout)
                for e in cal_events:
                    # Avoid duplicate instances
                    if e.get("status") == "cancelled" or e.get("availability") == "free":
                        continue
                    events.append(e)
        except Exception:
            continue

    if not events:
        print("No events scheduled for today.")
        return

    # Sort events by start date
    events.sort(key=lambda x: x.get("start_date", ""))

    for e in events:
        title = e.get("title", "Untitled").strip()
        all_day = e.get("all_day", False)
        if all_day:
            time_str = "All Day"
        else:
            start_str = e.get("start_date", "")
            # e.g., "2026-03-28T10:00:00Z"
            try:
                dt = datetime.fromisoformat(start_str.replace("Z", "+00:00"))
                time_str = dt.strftime("%H:%M")
            except Exception:
                time_str = start_str[:16].replace("T", " ")

        print(f"[{time_str}] {title}")

if __name__ == "__main__":
    main()
