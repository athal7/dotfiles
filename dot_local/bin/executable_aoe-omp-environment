#!/bin/sh
# Emit OMP paths and only its named credentials for AoE sessions.
set -u

[ "${AOE_TOOL:-}" = omp ] || exit 0

if [ -r "$HOME/.envrc" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.envrc"
  keychain_env ANTHROPIC_API_KEY anthropic_api_key 2>/dev/null || :
  keychain_env OTARI_API_KEY otari_api_key 2>/dev/null || :
fi

printf 'PI_CONFIG_DIR=.config/omp\nPI_CODING_AGENT_DIR=%s\nXDG_DATA_HOME=%s\n' \
  "$HOME/.config/omp/agent" "$HOME/.local/share"

[ -z "${ANTHROPIC_API_KEY:-}" ] || printf 'ANTHROPIC_API_KEY=%s\n' "$ANTHROPIC_API_KEY"
[ -z "${OTARI_API_KEY:-}" ] || printf 'OTARI_API_KEY=%s\n' "$OTARI_API_KEY"
# AoE starts OMP without a login shell; request gh auth only for this process.
if command -v gh >/dev/null 2>&1; then
  github_token=$(gh auth token 2>/dev/null) || github_token=
  [ -z "$github_token" ] || printf 'GITHUB_TOKEN=%s\n' "$github_token"
fi
if command -v spacectl >/dev/null 2>&1 && command -v spacelift-mcp-url >/dev/null 2>&1; then
  spacelift_mcp_url=$(spacelift-mcp-url 2>/dev/null) || spacelift_mcp_url=
  [ -z "$spacelift_mcp_url" ] || printf 'SPACELIFT_MCP_URL=%s\n' "$spacelift_mcp_url"
fi
