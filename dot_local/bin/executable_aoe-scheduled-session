#!/bin/bash
set -euo pipefail

if [[ $# -lt 2 || $# -gt 3 ]]; then
  printf 'usage: %s <title> <prompt> [project-path]\n' "$0" >&2
  exit 64
fi

title=$1
prompt=$2
project_path=${3:-}

if [[ -n "$project_path" ]]; then
  session_output=$(/opt/homebrew/bin/aoe add "$project_path" --tool omp --title "$title" --group Scheduled --launch)
else
  session_output=$(/opt/homebrew/bin/aoe add --scratch --tool omp --title "$title" --group Scheduled --launch)
fi
session_id=$(sed -n 's/^[[:space:]]*ID:[[:space:]]*//p' <<<"$session_output")
if [[ -z "$session_id" ]]; then
  printf '%s\n' "$session_output" >&2
  printf 'aoe add did not return a session ID\n' >&2
  exit 1
fi

sleep 30
/opt/homebrew/bin/aoe send --no-revive "$session_id" "$prompt"
