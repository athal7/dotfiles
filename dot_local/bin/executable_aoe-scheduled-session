#!/bin/bash
set -euo pipefail

if [[ $# -lt 2 || $# -gt 3 ]]; then
  printf 'usage: %s <title> <prompt> [project-path]\n' "$0" >&2
  exit 64
fi

title=$1
prompt=$2
project_path=${3:-}
omp_extra_args=()
if [[ -n ${AOE_OMP_PROFILE:-} ]]; then
  if [[ ! $AOE_OMP_PROFILE =~ ^[[:alnum:]_-]+$ ]]; then
    printf 'AOE_OMP_PROFILE must contain only letters, digits, underscores, and hyphens\n' >&2
    exit 64
  fi
  omp_extra_args=(--extra-args "--profile $AOE_OMP_PROFILE")
fi
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/aoe/omp-session-map"
correlation_id=$(/usr/bin/uuidgen)
session_title="${title}-${correlation_id%%-*}"

if [[ -n "$project_path" ]]; then
  session_output=$(/opt/homebrew/bin/aoe add "$project_path" --tool omp --title "$session_title" --group Scheduled "${omp_extra_args[@]}")
else
  session_output=$(/opt/homebrew/bin/aoe add --scratch --tool omp --title "$session_title" --group Scheduled "${omp_extra_args[@]}")
fi
session_id=$(sed -n 's/^[[:space:]]*ID:[[:space:]]*//p' <<<"$session_output")
if [[ ! "$session_id" =~ ^[[:alnum:]-]+$ ]]; then
  printf '%s\n' "$session_output" >&2
  printf 'aoe add did not return a valid session ID\n' >&2
  exit 1
fi

umask 077
mkdir -p "$state_dir"
created_at=$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)
mapping_path="$state_dir/$session_id.json"
mapping_temp=$(mktemp "$state_dir/.${session_id}.XXXXXX")
printf '{"aoeSessionId":"%s","correlationId":"%s","createdAt":"%s"}\n' \
  "$session_id" "$correlation_id" "$created_at" >"$mapping_temp"
mv "$mapping_temp" "$mapping_path"

for attempt in 1 2 3; do
  if /opt/homebrew/bin/aoe session start "$session_id"; then
    break
  fi
  if [[ "$attempt" -eq 3 ]]; then
    printf 'aoe session failed to start after %s attempts\n' "$attempt" >&2
    exit 1
  fi
  sleep 5
done
sleep 30
/opt/homebrew/bin/aoe send --no-revive "$session_id" \
  "$prompt"$'\n\n'"AOE_CORRELATION=$correlation_id"
