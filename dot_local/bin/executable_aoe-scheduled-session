#!/bin/bash
# Start an AoE session that works a prompt file unattended.
#
# `aoe session start` returns once the agent process is up, so the prompt can
# be sent straight after it: no startup sleep, liveness polling or retry loop.

set -euo pipefail

if [[ $# -lt 2 || $# -gt 3 ]]; then
  printf 'usage: %s <title> <prompt-file> [project-path]\n' "$0" >&2
  exit 64
fi

title=$1
prompt_file=$2
if [[ ! -f "$prompt_file" || ! -r "$prompt_file" ]]; then
  printf 'prompt file is not readable: %s\n' "$prompt_file" >&2
  exit 66
fi
prompt=$(/bin/cat "$prompt_file")
project_path=${3:-}
aoe_bin=${AOE_BIN:-/opt/homebrew/bin/aoe}
project_mcp_config=${AOE_OMP_PROJECT_MCP_CONFIG:-}
omp_model=${AOE_OMP_MODEL:-}
session_group=${AOE_SESSION_GROUP:-Scheduled}
agent_tool=${AOE_TOOL:-omp}
worktree_branch=${AOE_WORKTREE_BRANCH:-}
new_branch=${AOE_NEW_BRANCH:-false}
if [[ ! -x "$aoe_bin" ]]; then
  printf 'AOE_BIN is not executable: %s\n' "$aoe_bin" >&2
  exit 69
fi
if [[ ! "$agent_tool" =~ ^[[:alnum:]_.-]+$ ]]; then
  printf 'AOE_TOOL must name a single agent (e.g. omp or freebuff)\n' >&2
  exit 64
fi
if [[ -n "$omp_model" && ! "$omp_model" =~ ^[@[:alnum:]_./:-]+$ ]]; then
  printf 'AOE_OMP_MODEL contains unsupported characters\n' >&2
  exit 64
fi
case "$session_group" in
  ""|*[![:alnum:]_.\ /-]*)
    printf 'AOE_SESSION_GROUP contains unsupported characters\n' >&2
    exit 64
    ;;
esac
if [[ "$new_branch" != true && "$new_branch" != false ]]; then
  printf 'AOE_NEW_BRANCH must be true or false\n' >&2
  exit 64
fi
if [[ -n "$worktree_branch" ]]; then
  if [[ -z "$project_path" ]] || ! git -C "$project_path" check-ref-format --branch "$worktree_branch" >/dev/null 2>&1; then
    printf 'AOE_WORKTREE_BRANCH requires a valid project path and branch name\n' >&2
    exit 64
  fi
elif [[ "$new_branch" == true ]]; then
  printf 'AOE_NEW_BRANCH requires AOE_WORKTREE_BRANCH\n' >&2
  exit 64
fi
if [[ -n "$project_mcp_config" ]]; then
  if [[ -n "$project_path" ]]; then
    printf 'AOE_OMP_PROJECT_MCP_CONFIG is supported only for scratch sessions\n' >&2
    exit 64
  fi
  if [[ "$project_mcp_config" != /* || ! -f "$project_mcp_config" ]]; then
    printf 'AOE_OMP_PROJECT_MCP_CONFIG must name an absolute regular file\n' >&2
    exit 66
  fi
fi

# The session title carries a short unique suffix so repeated dispatches of the
# same title stay distinguishable, and a re-dispatch can find its own session.
session_title="${title}-$(/usr/bin/uuidgen | /usr/bin/cut -c1-8)"
aoe_args=(add)
if [[ -n "$project_path" ]]; then
  aoe_args+=("$project_path")
else
  aoe_args+=(--scratch)
fi
if [[ -n "$worktree_branch" ]]; then
  aoe_args+=(--worktree "$worktree_branch")
  if [[ "$new_branch" == true ]]; then
    aoe_args+=(--new-branch)
  fi
fi
aoe_args+=(--tool "$agent_tool" --title "$session_title" --group "$session_group")
if [[ -n "$omp_model" && "$agent_tool" == omp ]]; then
  aoe_args+=(--extra-args "--model $omp_model")
fi
session_output=$("$aoe_bin" "${aoe_args[@]}")
session_id=$(/usr/bin/sed -n 's/^[[:space:]]*ID:[[:space:]]*//p' <<<"$session_output")
if [[ ! "$session_id" =~ ^[[:alnum:]-]+$ ]]; then
  printf '%s\n' "$session_output" >&2
  printf 'aoe add did not return a valid session ID\n' >&2
  exit 1
fi

# The project MCP overlay lives in the session directory and is read when the
# agent starts, so it has to be in place before the session is started.
umask 077
if [[ -n "$project_mcp_config" ]]; then
  session_path=$(/usr/bin/sed -n 's/^[[:space:]]*Path:[[:space:]]*//p' <<<"$session_output")
  if [[ "$session_path" != /* || ! -d "$session_path" ]]; then
    printf '%s\n' "$session_output" >&2
    printf 'aoe add did not return a valid scratch path\n' >&2
    exit 1
  fi
  mkdir -p "$session_path/.omp"
  cp "$project_mcp_config" "$session_path/.omp/mcp.json"
  chmod 600 "$session_path/.omp/mcp.json"
fi

"$aoe_bin" session start "$session_id"
"$aoe_bin" send --no-revive "$session_id" "$prompt"
