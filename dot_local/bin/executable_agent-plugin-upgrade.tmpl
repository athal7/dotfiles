#!/bin/bash
# Upgrade package managers and OMP plugins. AoE plugins are left to aoe's own
# updates.auto_update_plugins sweep, which applies only the updates that need no
# new consent; this script has no business approving the rest.
set -uo pipefail
status=0
export XDG_CONFIG_HOME="$HOME/.config"
export PI_CONFIG_DIR=".config/omp"
export PI_CODING_AGENT_DIR="$HOME/.config/omp/agent"

if ! brew update; then
  echo "Homebrew update failed; skipping Homebrew upgrade" >&2
  status=1
elif ! brew upgrade --no-ask; then
  echo "Homebrew upgrade failed" >&2
  status=1
fi
if ! mise upgrade --yes -x node; then
  echo "mise upgrade failed" >&2
  status=1
fi

{{ range .packages.omp_plugins -}}
if ! omp plugin upgrade {{ . | quote }}; then
  echo "Failed to upgrade OMP plugin {{ . }}" >&2
  status=1
fi
{{ end }}
{{ template "aoe-plugin-tree-fix" . }}

exit "$status"
