#!/usr/bin/env python3
import json
import os
import re
import sys
import subprocess
import urllib.request
import urllib.error
from datetime import datetime, date, timedelta, timezone
from pathlib import Path

# Helper to find ical path
def get_ical_path():
    try:
        which = subprocess.run(["which", "ical"], capture_output=True, text=True)
        if which.returncode == 0 and which.stdout.strip():
            return which.stdout.strip()
    except Exception:
        pass
    local_path = Path.home() / ".local/bin/ical"
    return str(local_path) if local_path.exists() else "ical"

# Helper to load chezmoi data
def load_chezmoi_data():
    try:
        res = subprocess.run(["chezmoi", "data", "--format", "json"], capture_output=True, text=True, check=True, timeout=10)
        return json.loads(res.stdout)
    except Exception:
        return {}

# Linear token retrieval
def get_linear_token():
    try:
        res = subprocess.run(
            ["security", "find-generic-password", "-s", "chezmoi", "-a", "linear_api_token", "-w"],
            capture_output=True, text=True, check=True
        )
        return res.stdout.strip()
    except Exception:
        return os.environ.get("LINEAR_API_TOKEN") or os.environ.get("LINEAR_TOKEN")

# Parallel/Sequential data fetching
def fetch_calendar(calendars_config):
    cal_names = []
    # Fully customizable calendars via chezmoi data (wtf.calendar.names)
{{- if hasKey . "wtf" }}
  {{- if hasKey .wtf "calendar" }}
    {{- if hasKey .wtf.calendar "names" }}
      {{- range .wtf.calendar.names }}
    cal_names.append("{{ . }}")
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}

    # Fallback if not custom configured
    if not cal_names:
        for k, v in calendars_config.items():
            if isinstance(v, dict) and "name" in v:
                cal_names.append(v["name"])

    if not cal_names:
        return []

    ical_bin = get_ical_path()
    today_str = str(date.today())
    tomorrow_str = str(date.today() + timedelta(days=1))

    events = []
    for cal in cal_names:
        try:
            cmd = [ical_bin, "list", "-c", cal, "--from", today_str, "--to", tomorrow_str, "-o", "json"]
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
            if res.returncode == 0 and res.stdout.strip():
                cal_events = json.loads(res.stdout)
                for e in cal_events:
                    if e.get("status") == "cancelled" or e.get("availability") == "free":
                        continue
                    events.append(e)
        except Exception:
            continue
    return events

def fetch_reminders(reminders_config):
    target_lists = []
    # Fully customizable reminders list filtering via chezmoi data (wtf.reminders.lists)
{{- if hasKey . "wtf" }}
  {{- if hasKey .wtf "reminders" }}
    {{- if hasKey .wtf.reminders "lists" }}
      {{- range .wtf.reminders.lists }}
    target_lists.append("{{ . }}")
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}

    # Fallback if not custom configured
    if not target_lists:
        for k, v in reminders_config.items():
            if isinstance(v, dict) and v.get("attention_check") and "name" in v:
                target_lists.append(v["name"])

        # Fallback to all configured list names if none are explicitly marked for attention check
        if not target_lists:
            for k, v in reminders_config.items():
                if isinstance(v, dict) and "name" in v:
                    target_lists.append(v["name"])

    if not target_lists:
        return []

    try:
        cmd = ["remindctl", "show", "all", "--json"]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        if res.returncode != 0:
            return []
        all_reminders = json.loads(res.stdout or "[]")
        return [r for r in all_reminders if not r.get("completed") and r.get("list") in target_lists]
    except Exception:
        return []

def fetch_github():
    try:
        # Fetch PRs where review is requested
        pr_res = subprocess.run(
            ["gh", "search", "prs", "review-requested:@me", "--json", "number,title,repository,url"],
            capture_output=True, text=True, timeout=10
        )
        prs = json.loads(pr_res.stdout) if pr_res.returncode == 0 else []
        for p in prs:
            p["type"] = "review_request"

        # Fetch assigned issues
        issue_res = subprocess.run(
            ["gh", "search", "issues", "assignee:@me", "--json", "number,title,repository,url"],
            capture_output=True, text=True, timeout=10
        )
        issues = json.loads(issue_res.stdout) if issue_res.returncode == 0 else []
        for i in issues:
            i["type"] = "assigned_issue"

        return prs + issues
    except Exception:
        return []

def fetch_linear():
    token = get_linear_token()
    if not token:
        return []

    # Fully customizable GraphQL query via chezmoi data (wtf.linear.query)
    # Correct template logic with fallback to default query even if .wtf is present
    query = """
{{- if hasKey . "wtf" }}
  {{- if hasKey .wtf "linear" }}
    {{- if hasKey .wtf.linear "query" }}
{{ .wtf.linear.query }}
    {{- else }}
query {
  viewer {
    assignedIssues(filter: { state: { name: { neq: "Done" } } }) {
      nodes {
        id
        identifier
        title
        url
        state {
          name
        }
      }
    }
  }
}
    {{- end }}
  {{- else }}
query {
  viewer {
    assignedIssues(filter: { state: { name: { neq: "Done" } } }) {
      nodes {
        id
        identifier
        title
        url
        state {
          name
        }
      }
    }
  }
}
  {{- end }}
{{- else }}
query {
  viewer {
    assignedIssues(filter: { state: { name: { neq: "Done" } } }) {
      nodes {
        id
        identifier
        title
        url
        state {
          name
        }
      }
    }
  }
}
{{- end }}
"""

    req = urllib.request.Request(
        "https://api.linear.app/graphql",
        data=json.dumps({"query": query}).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": token
        },
        method="POST"
    )

    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            res_data = json.loads(response.read().decode("utf-8"))
            if "errors" in res_data:
                return []

            # Helper to recursively extract Linear issues
            def extract(data):
                if isinstance(data, list):
                    for item in data:
                        yield from extract(item)
                elif isinstance(data, dict):
                    if "identifier" in data and "title" in data:
                        yield data
                    else:
                        for val in data.values():
                            yield from extract(val)

            return list(extract(res_data.get("data", {})))
    except Exception:
        return []

# Prioritization and output generation
def get_list():
    data = load_chezmoi_data()
    calendars_config = data.get("calendars", {})
    reminders_config = data.get("reminders", {})

    items = []

    # 1. Calendar
    for e in fetch_calendar(calendars_config):
        title = e.get("title", "Untitled").strip()
        all_day = e.get("all_day", False)
        start_str = e.get("start_date", "")

        weight = 50
        time_tag = "All Day"
        if not all_day and start_str:
            try:
                dt = datetime.fromisoformat(start_str.replace("Z", "+00:00"))
                now = datetime.now(timezone.utc)
                diff_mins = (dt - now).total_seconds() / 60.0
                time_tag = dt.strftime("%H:%M")
                if 0 <= diff_mins <= 30:
                    weight = 100
                elif 0 <= diff_mins <= 120:
                    weight = 80
                elif diff_mins < 0:
                    weight = 20 # past
            except Exception:
                time_tag = start_str[:16].replace("T", " ")

        items.append({
            "type": "CAL",
            "weight": weight,
            "title": title,
            "details": f"Time: {time_tag}",
            "id": e.get("id", ""),
            "database_id": "",
            "url": "",
            "repo_path": ""
        })

    # 2. Reminders
    priority_order = {"high": 1, "medium": 2, "low": 3, "none": 4}
    for r in fetch_reminders(reminders_config):
        title = r.get("title", "Untitled").strip()
        prio = r.get("priority", "none").lower()
        due = r.get("due_date", "")

        weight = 50
        if due:
            try:
                due_date = date.fromisoformat(due[:10])
                if due_date < date.today():
                    weight = 95 # overdue
                elif due_date == date.today():
                    weight = 85 # due today
            except Exception:
                pass
        else:
            if prio == "high":
                weight = 70
            elif prio == "medium":
                weight = 50
            elif prio == "low":
                weight = 30
            else:
                weight = 15

        items.append({
            "type": "REM",
            "weight": weight,
            "title": title,
            "details": f"List: {r.get('list')} | Prio: {prio.upper()}" + (f" | Due: {due[:10]}" if due else ""),
            "id": r.get("id", ""),
            "database_id": "",
            "url": "",
            "repo_path": ""
        })

    # 3. GitHub
    for g in fetch_github():
        title = g.get("title", "Untitled").strip()
        repo_name = g.get("repository", {}).get("nameWithOwner", "unknown")

        weight = 60
        gtype = g.get("type", "")
        if gtype == "review_request":
            weight = 90
            details = f"Review Requested | Repo: {repo_name}"
        else:
            weight = 75
            details = f"Assigned Issue | Repo: {repo_name}"

        # Resolve Repo Path if configured in chezmoi
        repo_path = ""
        code_dir = data.get("codeDir", str(Path.home() / "code"))
        if repo_name:
            guessed_path = os.path.join(code_dir, repo_name.split("/")[-1])
            if os.path.isdir(guessed_path):
                repo_path = guessed_path

        items.append({
            "type": "GH",
            "weight": weight,
            "title": f"#{g.get('number')} {title}",
            "details": details,
            "id": str(g.get("number")),
            "database_id": "",
            "url": g.get("url", ""),
            "repo_path": repo_path,
            "subtype": gtype
        })

    # 4. Linear
    for l in fetch_linear():
        title = l.get("title", "Untitled").strip()
        identifier = l.get("identifier", "unknown")
        state = l.get("state", {}).get("name", "Unknown") if isinstance(l.get("state"), dict) else "Unknown"

        weight = 65
        if state.lower() == "in progress":
            weight = 80

        items.append({
            "type": "LIN",
            "weight": weight,
            "title": f"[{identifier}] {title}",
            "details": f"State: {state}",
            "id": identifier,
            "database_id": l.get("id", ""),
            "url": l.get("url", ""),
            "repo_path": ""
        })

    # Sort items by weight descending
    items.sort(key=lambda x: x["weight"], reverse=True)

    # Format for fzf
    # Format: [TYPE] (WEIGHT) Title | DETAILS: <details> | ID:<id> | DATABASE_ID:<database_id> | URL:<url> | REPO_PATH:<path> | SUBTYPE:<subtype>
    for item in items:
        # Use simple icons for terminal beauty
        icon = "📅" if item["type"] == "CAL" else "📝" if item["type"] == "REM" else "🐙" if item["type"] == "GH" else "🎯"
        subtype = item.get("subtype", "")
        line = f"{icon} [{item['type']}] ({item['weight']}) {item['title']} - {item['details']} \t| ID:{item['id']} | DATABASE_ID:{item['database_id']} | URL:{item['url']} | REPO_PATH:{item['repo_path']} | SUBTYPE:{subtype}"
        print(line)

# Action execution
def act(line):
    # Parse the line to retrieve metadata
    match_id = re.search(r"\| ID:([^\s|]*)", line)
    match_db_id = re.search(r"\| DATABASE_ID:([^\s|]*)", line)
    match_url = re.search(r"\| URL:([^\s|]*)", line)
    match_path = re.search(r"\| REPO_PATH:([^\s|]*)", line)
    match_subtype = re.search(r"\| SUBTYPE:([^\s|]*)", line)

    item_id = match_id.group(1) if match_id else ""
    db_id = match_db_id.group(1) if match_db_id else ""
    item_url = match_url.group(1) if match_url else ""
    repo_path = match_path.group(1) if match_path else ""
    subtype = match_subtype.group(1) if match_subtype else ""

    item_type = ""
    if "[CAL]" in line:
        item_type = "CAL"
    elif "[REM]" in line:
        item_type = "REM"
    elif "[GH]" in line:
        item_type = "GH"
    elif "[LIN]" in line:
        item_type = "LIN"

    # Hoist split expression for Python <3.12 compatibility
    line_display = line.split('\t')[0]

    print("\n" + "=" * 50)
    print(f"Selected Item Type: {item_type}")
    print(f"Details: {line_display}")
    print("=" * 50)

    options = []
    if item_type == "CAL":
        options = [
            ("Copy event details to clipboard", lambda: copy_to_clipboard(line_display))
        ]
    elif item_type == "REM":
        options = [
            ("Complete reminder", lambda: run_cmd(["remindctl", "complete", item_id]))
        ]
    elif item_type == "GH":
        options = [
            ("Open in Browser", lambda: run_cmd(["open", item_url]) if item_url else print("No URL.")),
            ("Start Agent session (aoe-cmd)", lambda: run_cmd(["aoe-cmd", "-d", repo_path, "-n", f"issue-{item_id}", "-b", "-w", f"issue-{item_id}", f"Work on issue {item_id} in this repo"]) if repo_path else print("No local repo path mapped."))
        ]

        # Add PR-specific actions for review_request items
        if subtype == "review_request":
            options.extend([
                ("Review with Lumen", lambda: run_cmd(["lumen", "review", "--repo", get_repo_from_url(item_url), "--pr", item_id]) if item_url else print("No URL.")),
                ("Approve PR", lambda: run_cmd(["gh", "pr", "review", "--approve", item_id, "--repo", get_repo_from_url(item_url)]) if item_url else print("No URL.")),
                ("Merge PR (Squash)", lambda: run_cmd(["gh", "pr", "merge", "--squash", "--delete-branch", item_id, "--repo", get_repo_from_url(item_url)]) if item_url else print("No URL.")),
                ("Comment on PR", lambda: run_cmd(["gh", "pr", "comment", item_id, "-R", get_repo_from_url(item_url), "-b", input("\nEnter comment body: ").strip()]) if item_url else print("No URL.")),
                ("Add Label to PR", lambda: run_cmd(["gh", "pr", "edit", item_id, "-R", get_repo_from_url(item_url), "--add-label", input("\nEnter label name: ").strip()]) if item_url else print("No URL."))
            ])
        # Add issue-specific actions for assigned_issue items
        elif subtype == "assigned_issue":
            options.extend([
                ("Comment on Issue", lambda: run_cmd(["gh", "issue", "comment", item_id, "-R", get_repo_from_url(item_url), "-b", input("\nEnter comment body: ").strip()]) if item_url else print("No URL.")),
                ("Add Label to Issue", lambda: run_cmd(["gh", "issue", "edit", item_id, "-R", get_repo_from_url(item_url), "--add-label", input("\nEnter label name: ").strip()]) if item_url else print("No URL."))
            ])
    elif item_type == "LIN":
        options = [
            ("Open in Browser", lambda: run_cmd(["open", item_url]) if item_url else print("No URL.")),
            ("Start Agent session (aoe-cmd)", lambda: run_cmd(["aoe-cmd", "-d", os.getcwd(), "-n", f"linear-{item_id}", f"Work on Linear issue {item_id}"])),
            ("Comment on Issue", lambda: linear_comment(db_id)),
            ("Transition Issue (Change State)", lambda: linear_transition(db_id))
        ]

    options.append(("Exit", lambda: sys.exit(0)))

    for idx, (desc, _) in enumerate(options, 1):
        print(f"{idx}) {desc}")

    try:
        choice = input("\nSelect action [1-%d]: " % len(options)).strip()
        if choice.isdigit() and 1 <= int(choice) <= len(options):
            options[int(choice) - 1][1]()
        else:
            print("Invalid choice. Exiting.")
    except (KeyboardInterrupt, EOFError):
        print("\nExiting.")

def copy_to_clipboard(text):
    try:
        p = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"))
        print("Copied to clipboard!")
    except Exception as e:
        print(f"Failed to copy: {e}")

def run_cmd(cmd):
    try:
        print(f"Running: {' '.join(cmd)}")
        subprocess.run(cmd, check=True)
    except Exception as e:
        print(f"Command failed: {e}")

def get_repo_from_url(url):
    # e.g., https://github.com/athal7/kb/pull/40 -> athal7/kb
    m = re.search(r"github\.com/([^/]+/[^/]+)", url)
    return m.group(1) if m else ""

# Linear API Helper mutations
def query_linear_graphql(query, variables=None):
    token = get_linear_token()
    if not token:
        print("Linear token not available.")
        return None
    req = urllib.request.Request(
        "https://api.linear.app/graphql",
        data=json.dumps({"query": query, "variables": variables or {}}).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": token
        },
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read().decode("utf-8"))
    except Exception as e:
        print(f"Linear query failed: {e}")
        return None

def linear_comment(issue_uuid):
    if not issue_uuid:
        print("No issue database ID available to comment.")
        return
    body = input("\nEnter comment body: ").strip()
    if not body:
        print("Empty comment. Canceled.")
        return
    query = """
    mutation($issueId: String!, $body: String!) {
      commentCreate(input: { issueId: $issueId, body: $body }) {
        success
      }
    }
    """
    res = query_linear_graphql(query, {"issueId": issue_uuid, "body": body})
    if res and not res.get("errors"):
        print("Comment created successfully!")
    else:
        print("Failed to create comment.")

def linear_transition(issue_uuid):
    if not issue_uuid:
        print("No issue database ID available to transition.")
        return
    # First, fetch workflow states
    query_states = """
    query {
      workflowStates {
        nodes {
          id
          name
        }
      }
    }
    """
    res_states = query_linear_graphql(query_states)
    if not res_states or res_states.get("errors"):
        print("Could not retrieve states.")
        return
    states = res_states.get("data", {}).get("workflowStates", {}).get("nodes", [])
    if not states:
        print("No workflow states found.")
        return

    print("\nAvailable States:")
    for idx, s in enumerate(states, 1):
        print(f"{idx}) {s['name']}")

    try:
        choice = input("\nSelect state to transition to [1-%d]: " % len(states)).strip()
        if choice.isdigit() and 1 <= int(choice) <= len(states):
            target_state_id = states[int(choice) - 1]["id"]
            target_state_name = states[int(choice) - 1]["name"]
            # Perform transition
            query_update = """
            mutation($id: String!, $stateId: String!) {
              issueUpdate(id: $id, input: { stateId: $stateId }) {
                success
              }
            }
            """
            res_update = query_linear_graphql(query_update, {"id": issue_uuid, "stateId": target_state_id})
            if res_update and not res_update.get("errors"):
                print(f"Issue transitioned successfully to '{target_state_name}'!")
            else:
                print("Failed to transition issue.")
        else:
            print("Invalid choice.")
    except (KeyboardInterrupt, EOFError):
        print("\nCanceled.")

if __name__ == "__main__":
    if len(sys.argv) > 2 and sys.argv[1] == "act":
        act(sys.argv[2])
    else:
        get_list()
