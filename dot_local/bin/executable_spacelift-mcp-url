#!/usr/bin/env bash
set -euo pipefail

current_profile=$(spacectl profile current)
profiles=$(spacectl profile list)

# spacectl renders `profile list` as a box-drawn table:
#   Current │ Alias   │ Endpoint                        │ Type
#   ─────────────────────────────────────────────────────────────
#   *       │ alias   │ https://alias.app.spacelift.io  │ API Token
# Fold every character that cannot appear in a cell value (separator glyphs and
# spaces alike) into a space, then split on whitespace. Neither the separator
# character nor the column padding has to be assumed.
while IFS= read -r line; do
  read -r -a cells <<<"$(printf '%s' "$line" | tr -c '[:alnum:].:/_+@*-' ' ')"
  [[ ${#cells[@]} -gt 0 ]] || continue
  [[ ${cells[0]} == '*' ]] || continue
  alias='' endpoint=''
  for cell in "${cells[@]:1}"; do
    if [[ -z $alias ]]; then
      alias=$cell
    else
      endpoint=$cell
      break
    fi
  done
  [[ $alias == "$current_profile" && -n $endpoint ]] || continue
  case "$endpoint" in
    https://*.app.spacelift.io|https://*.app.us.spacelift.io)
      printf '%s/mcp\n' "${endpoint%/}"
      exit 0
      ;;
    *)
      printf 'spacelift-mcp-url: unexpected current profile endpoint\n' >&2
      exit 1
      ;;
  esac
done <<<"$profiles"

printf 'spacelift-mcp-url: current profile endpoint not found\n' >&2
exit 1
