#!/usr/bin/env bash
# attention-session — start a deterministic AoE session from an attention action.
set -euo pipefail

DISPATCHER=${AOE_SESSION_DISPATCHER:-"$HOME/.local/bin/aoe-scheduled-session"}
GH_BIN=${GH_BIN:-gh}
GIT_BIN=${GIT_BIN:-git}
AOE_BIN=${AOE_BIN:-/opt/homebrew/bin/aoe}
JQ_BIN=${JQ_BIN:-/opt/homebrew/bin/jq}

usage() {
  printf 'usage: %s scratch <title> <prompt>\n' "$0" >&2
  printf '       %s github <repo-path> <issue-or-pr> <worktree-branch> <title> <prompt> <additional-prompt> <owner/repo>\n' "$0" >&2
  exit 64
}

fail() {
  printf 'attention-session: %s\n' "$*" >&2
  exit 1
}

dispatch() {
  local title=$1 prompt=$2
  [ -x "$DISPATCHER" ] || fail "dispatcher is not executable: $DISPATCHER"
  shift 2
  umask 077
  prompt_file=$(mktemp "${TMPDIR:-/tmp}/attention-session.XXXXXX")
  trap 'rm -f "$prompt_file"' EXIT
  printf '%s' "$prompt" >"$prompt_file"
  env AOE_SESSION_GROUP=Attention AOE_TOOL="${AOE_TOOL:-omp}" "$DISPATCHER" "$title" "$prompt_file" "$@"
}

# Reuse by live checkout identity, not titles or AoE's creation-time branch.
# A user-initiated Attention action may wake a session, but must not type into
# its editor or answer a pending approval.
existing_session() {
  local kind=$1 title=$2 repo=$3 branch=$4 expected_head=${5:-} pr_number=${6:-} sessions candidates
  local id profile lifecycle path snoozed actual common expected_common matched=
  sessions=$("$AOE_BIN" list --all --json) || fail "cannot list AoE sessions"
  # jq variables are expanded by jq, not by the shell.
  # shellcheck disable=SC2016
  candidates=$(printf '%s' "$sessions" | "$JQ_BIN" -sr \
    --arg kind "$kind" --arg title "$title" --arg tool "${AOE_TOOL:-omp}" '
    if length != 1 or (.[0] | type) != "array" then error("invalid AoE list")
    else .[0] end |
    .[] | select(.state == "live" or .state == "archived") |
    select(if $kind == "scratch" then
      .group == "Attention" and .tool == $tool and .worktree == null and
      (.title | startswith($title + "-")) and
      (.title[($title | length) + 1:] | test("^[0-9a-fA-F]{8}$")) and
      (.id as $id | .path | rtrimstr("/") | endswith("/scratch/" + $id))
    else true end) |
    [.id, (.profile // "main"), .state, .path, (if .snoozed_until != null then "yes" else "no" end)] | @tsv') || fail "cannot select AoE sessions"
  if [ "$kind" != scratch ]; then
    expected_common=$("$GIT_BIN" -C "$repo" rev-parse --path-format=absolute --git-common-dir) || \
      fail "cannot identify repository $repo"
  fi
  while IFS=$'\t' read -r id profile lifecycle path snoozed; do
    [ -n "$id" ] || continue
    [ -d "$path" ] || continue
    if [ "$kind" != scratch ]; then
      actual=$("$GIT_BIN" -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null) || continue
      [ "$actual" = "$branch" ] || continue
      common=$("$GIT_BIN" -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
      [ "$common" = "$expected_common" ] || continue
      if [ -n "$expected_head" ]; then
        matches_pr_checkout "$path" "$expected_head" "$pr_number" || \
          fail "existing checkout does not match PR head repository"
      fi
    fi
    [ -z "$matched" ] || fail "multiple sessions match this Attention item"
    matched=$(printf '%s\t%s\t%s\t%s' "$id" "$profile" "$lifecycle" "$snoozed")
  done <<<"$candidates"
  printf '%s' "$matched"
}

resume_existing() {
  local match id profile lifecycle runtime state snoozed substrate
  match=$(existing_session "$1" "$2" "$3" "$4" "${5:-}" "${6:-}")
  [ -n "$match" ] || return 0
  IFS=$'\t' read -r id profile lifecycle snoozed <<<"$match"
  [[ "$id" =~ ^[[:alnum:]-]+$ ]] || fail "invalid AoE session ID"
  runtime=$("$AOE_BIN" -p "$profile" session show "$id" --json) || fail "cannot inspect AoE session $id"
  state=$(printf '%s' "$runtime" | "$JQ_BIN" -er '.status | ascii_downcase') || fail "invalid AoE runtime state"
  case "$state" in
    running|idle|waiting) ;;
    stopped)
      runtime=$("$AOE_BIN" -p "$profile" ps --json "$id") || fail "cannot inspect AoE runtime $id"
      substrate=$(printf '%s' "$runtime" | "$JQ_BIN" -er '.substrate') || fail "invalid AoE runtime substrate"
      [ "$substrate" = tmux ] || fail "open stopped structured session $id in AoE"
      ;;
    *) fail "cannot reuse AoE session $id (state: $state)" ;;
  esac
  if [ "$lifecycle" = archived ]; then
    "$AOE_BIN" -p "$profile" session unarchive "$id" || fail "cannot unarchive AoE session $id"
  fi
  if [ "$snoozed" = yes ]; then
    "$AOE_BIN" -p "$profile" session unsnooze "$id" || fail "cannot wake AoE session $id"
  fi
  if [ "$state" = stopped ]; then
    "$AOE_BIN" -p "$profile" session start "$id" || fail "cannot start AoE session $id"
  fi
  printf 'Reusing AoE session %s (profile %s); no prompt was sent.\n' "$id" "$profile"
  exit 0
}

existing_worktree() {
  "$GIT_BIN" -C "$1" worktree list --porcelain -z |
    while IFS= read -r -d '' field; do
      case "$field" in
        "worktree "*) checkout=${field#worktree } ;;
        "branch refs/heads/$2") printf '%s\n' "$checkout" ;;
      esac
    done
}

matches_origin() {
  local remote expected
  remote=$("$GIT_BIN" -C "$1" remote get-url origin 2>/dev/null) || return 1
  remote=$(printf '%s' "${remote%.git}" | tr '[:upper:]' '[:lower:]')
  expected=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
  case "$remote" in
    "https://github.com/$expected"|"git@github.com:$expected"|"ssh://git@github.com/$expected") return 0 ;;
    *) return 1 ;;
  esac
}

matches_github_remote() {
  local expected remotes _name remote direction
  expected=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
  remotes=$("$GIT_BIN" -C "$1" remote -v 2>/dev/null) || return 1
  while read -r _name remote direction; do
    [ "$direction" = '(fetch)' ] || continue
    remote=$(printf '%s' "$remote" | tr '[:upper:]' '[:lower:]')
    remote=${remote%.git}
    case "$remote" in
      "https://github.com/$expected"|"git@github.com:$expected"|"ssh://git@github.com/$expected")
        return 0
        ;;
    esac
  done <<<"$remotes"
  return 1
}

# A fork head can be checked out in the upstream repository. Accept it only
# when the locally fetched PR ref is an ancestor of the checkout.
matches_pr_checkout() {
  matches_origin "$1" "$2" && return 0
  [ -n "$3" ] && matches_github_remote "$1" "$2" &&
    "$GIT_BIN" -C "$1" merge-base --is-ancestor "refs/remotes/origin/attention-pr-$3" HEAD
}

registered_repo_path() {
  local projects paths candidate resolved=
  projects=$("$AOE_BIN" project list --json) || fail "cannot list registered AoE projects"
  paths=$(printf '%s' "$projects" | "$JQ_BIN" -r '.[] | .path // empty') || \
    fail "cannot parse registered AoE projects"
  while IFS= read -r candidate; do
    [ -d "$candidate" ] || continue
    matches_github_remote "$candidate" "$1" || continue
    if [ -n "$resolved" ] && [ "$resolved" != "$candidate" ]; then
      fail "multiple registered AoE projects match $1"
    fi
    resolved=$candidate
  done <<<"$paths"
  [ -n "$resolved" ] || fail "no registered AoE project matches $1"
  printf '%s\n' "$resolved"
}

[ -n "${1:-}" ] || usage

case "$1" in
  scratch)
    if [ "$#" -ne 3 ]; then
      usage
    fi
    if [ -z "$2" ] || [ -z "$3" ]; then
      fail "title and prompt must not be empty"
    fi
    resume_existing scratch "$2" '' ''
    dispatch "$2" "$3"
    ;;
  github)
    if [ "$#" -ne 8 ]; then
      usage
    fi
    repo_path=$2
    reference=$3
    requested_branch=$4
    title=$5
    prompt=$6
    additional_prompt=$7
    github_repo=$8

    if [ -z "$reference" ] || [ -z "$requested_branch" ] || [ -z "$title" ] || [ -z "$prompt" ] || ! [[ "$github_repo" =~ ^[[:alnum:]_.-]+/[[:alnum:]_.-]+$ ]]; then
      fail "GitHub action arguments are invalid"
    fi
    if [ ! -d "$repo_path" ]; then
      repo_path=$(registered_repo_path "$github_repo")
    fi
    repo_root=$("$GIT_BIN" -C "$repo_path" rev-parse --show-toplevel 2>/dev/null) || \
      fail "repository path is not a Git repository: $repo_path"
    matches_github_remote "$repo_root" "$github_repo" || \
      fail "repository remotes do not match $github_repo"

    "$GIT_BIN" check-ref-format --branch "$requested_branch" >/dev/null || \
      fail "worktree branch is not valid: $requested_branch"
    if [ -n "$additional_prompt" ]; then
      prompt+=$'\n\nAdditional session content:\n'
      prompt+=$additional_prompt
    fi
    if pr_info=$(cd "$repo_root" && "$GH_BIN" pr view "$reference" --repo "$github_repo" --json number,headRefName,headRepositoryOwner,headRepository --jq '[.number, .headRefName, .headRepositoryOwner.login, .headRepository.name] | @tsv' 2>/dev/null); then
      IFS=$'\t' read -r pr_number head_branch head_owner head_repo <<<"$pr_info"
      if ! [[ "$pr_number" =~ ^[0-9]+$ && -n "$head_branch" && -n "$head_owner" && -n "$head_repo" ]]; then
        fail "pull request metadata is incomplete for: $reference"
      fi
      "$GIT_BIN" check-ref-format --branch "$head_branch" >/dev/null || \
        fail "pull request head is not a valid branch: $head_branch"
      worktree_branch="$head_branch"
      resume_existing github "$title" "$repo_root" "$head_branch" "$head_owner/$head_repo" "$pr_number"
      checkout=$(existing_worktree "$repo_root" "$head_branch") || fail "cannot list worktrees"
      if [ -n "$checkout" ]; then
        matches_pr_checkout "$checkout" "$head_owner/$head_repo" "$pr_number" || \
          fail "existing worktree does not match PR head repository"
        # AoE adopts the branch's existing checkout. Do not fetch/reset an
        # in-progress worktree just because its local commits differ from GitHub.
        AOE_WORKTREE_BRANCH="$head_branch" AOE_NEW_BRANCH=false \
          dispatch "$title" "$prompt" "$repo_root"
        exit 0
      fi
      pr_ref="refs/remotes/origin/attention-pr-$pr_number"
      head_remote="https://github.com/$head_owner/$head_repo.git"
      "$GIT_BIN" -C "$repo_root" fetch --no-tags "$head_remote" \
        "+refs/heads/$head_branch:$pr_ref" || \
        fail "cannot fetch pull request head: $reference"
      head_sha=$("$GIT_BIN" -C "$repo_root" rev-parse "$pr_ref")
      if "$GIT_BIN" -C "$repo_root" show-ref --verify --quiet "refs/heads/$worktree_branch"; then
        existing_sha=$("$GIT_BIN" -C "$repo_root" rev-parse "refs/heads/$worktree_branch")
        if [ "$existing_sha" != "$head_sha" ]; then
          "$GIT_BIN" -C "$repo_root" merge-base --is-ancestor "$existing_sha" "$head_sha" || \
            fail "existing worktree branch does not point to pull request head: $worktree_branch"
          "$GIT_BIN" -C "$repo_root" branch -f "$worktree_branch" "$head_sha" || \
            fail "cannot fast-forward worktree branch: $worktree_branch"
        fi
      else
        "$GIT_BIN" -C "$repo_root" branch "$worktree_branch" "$pr_ref" || \
          fail "cannot create worktree branch: $worktree_branch"
      fi
      new_branch=false
    else
      (cd "$repo_root" && "$GH_BIN" issue view "$reference" --repo "$github_repo" --json number --jq .number >/dev/null) || \
        fail "reference is not an accessible GitHub issue or pull request: $reference"
      worktree_branch=$requested_branch
      resume_existing github "$title" "$repo_root" "$worktree_branch"
      new_branch=true
    fi

    AOE_WORKTREE_BRANCH="$worktree_branch" AOE_NEW_BRANCH="$new_branch" \
      dispatch "$title" "$prompt" "$repo_root"
    ;;
  *)
    usage
    ;;
esac
