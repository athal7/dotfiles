#!/usr/bin/env bash
# attention-session — start a deterministic OMP session from an attention action.
set -euo pipefail

DISPATCHER=${AOE_SESSION_DISPATCHER:-"$HOME/.local/bin/aoe-scheduled-session"}
GH_BIN=${GH_BIN:-gh}
GIT_BIN=${GIT_BIN:-git}
AOE_BIN=${AOE_BIN:-/opt/homebrew/bin/aoe}
JQ_BIN=${JQ_BIN:-/opt/homebrew/bin/jq}

usage() {
  printf 'usage: %s scratch <title> <prompt>\n' "$0" >&2
  printf '       %s github <repo-path> <issue-or-pr> <worktree-branch> <title> <prompt> <additional-prompt> <owner/repo>\n' "$0" >&2
  exit 64
}

fail() {
  printf 'attention-session: %s\n' "$*" >&2
  exit 1
}

dispatch() {
  local title=$1 prompt=$2
  [ -x "$DISPATCHER" ] || fail "dispatcher is not executable: $DISPATCHER"
  shift 2
  umask 077
  prompt_file=$(mktemp "${TMPDIR:-/tmp}/attention-session.XXXXXX")
  trap 'rm -f "$prompt_file"' EXIT
  printf '%s' "$prompt" >"$prompt_file"
  env AOE_SESSION_GROUP=Attention "$DISPATCHER" "$title" "$prompt_file" "$@"
}

existing_session() {
  local kind=$1 title=$2 repo=$3 branch=$4 sessions
  sessions=$("$AOE_BIN" list --json) || fail "cannot list AoE sessions"
  # AoE titles carry a correlation suffix; worktree identity survives title renames.
  # shellcheck disable=SC2016
  printf '%s' "$sessions" | "$JQ_BIN" -sr --arg kind "$kind" --arg title "$title" \
    --arg repo "$repo" --arg branch "$branch" '
    if length != 1 or (.[0] | type) != "array" then error("invalid AoE list")
    else .[0] end
    | [ .[]
      | select(.group == "Attention" and .tool == "omp" and .state == "live")
      | select(if $kind == "scratch" then
                 (.title | startswith($title + "-")) and
                 (.title[($title | length) + 1:] | test("^[0-9a-fA-F]{8}$")) and
                 .worktree == null and
                 (.id as $id | .path | rtrimstr("/") | endswith("/scratch/" + $id))
               else
                 .worktree.branch == $branch and
                 (((.worktree.main_repo_path // "") | rtrimstr("/")) == ($repo | rtrimstr("/")))
               end)
      | .id ]
    | if length > 1 then error("ambiguous Attention sessions")
      elif length == 1 then .[0] else "" end
  ' || fail "cannot select a unique Attention session"
}

resume_existing() {
  local id
  id=$(existing_session "$1" "$2" "$3" "$4")
  if [ -n "$id" ]; then
    [[ "$id" =~ ^[[:alnum:]-]+$ ]] || fail "invalid AoE session ID"
    "$AOE_BIN" send "$id" $'Continue working on this Attention item in the existing session. Current request:\n\n'"$5" || \
      fail "cannot send to AoE session $id"
    exit 0
  fi
}

registered_repo_path() {
  local expected=${1,,} projects paths candidate remote resolved=
  projects=$("$AOE_BIN" project list --json) || fail "cannot list registered AoE projects"
  paths=$(printf '%s' "$projects" | "$JQ_BIN" -r '.[] | .path // empty') || \
    fail "cannot parse registered AoE projects"
  while IFS= read -r candidate; do
    [ -d "$candidate" ] || continue
    remote=$("$GIT_BIN" -C "$candidate" remote get-url origin 2>/dev/null) || continue
    remote=${remote,,}
    remote=${remote%.git}
    case "$remote" in
      "https://github.com/$expected"|"git@github.com:$expected"|"ssh://git@github.com/$expected")
        if [ -n "$resolved" ] && [ "$resolved" != "$candidate" ]; then
          fail "multiple registered AoE projects match $1"
        fi
        resolved=$candidate
        ;;
    esac
  done <<<"$paths"
  [ -n "$resolved" ] || fail "no registered AoE project matches $1"
  printf '%s\n' "$resolved"
}

verify_github_origin() {
  local expected=${2,,} remote
  remote=$("$GIT_BIN" -C "$1" remote get-url origin 2>/dev/null) || \
    fail "cannot read repository origin: $1"
  remote=${remote,,}
  remote=${remote%.git}
  case "$remote" in
    "https://github.com/$expected"|"git@github.com:$expected"|"ssh://git@github.com/$expected") ;;
    *) fail "repository origin does not match $2" ;;
  esac
}

[ -n "${1:-}" ] || usage

case "$1" in
  scratch)
    if [ "$#" -ne 3 ]; then
      usage
    fi
    if [ -z "$2" ] || [ -z "$3" ]; then
      fail "title and prompt must not be empty"
    fi
    resume_existing scratch "$2" '' '' "$3"
    dispatch "$2" "$3"
    ;;
  github)
    if [ "$#" -ne 8 ]; then
      usage
    fi
    repo_path=$2
    reference=$3
    requested_branch=$4
    title=$5
    prompt=$6
    additional_prompt=$7
    github_repo=$8

    if [ -z "$reference" ] || [ -z "$requested_branch" ] || [ -z "$title" ] || [ -z "$prompt" ] || ! [[ "$github_repo" =~ ^[[:alnum:]_.-]+/[[:alnum:]_.-]+$ ]]; then
      fail "GitHub action arguments are invalid"
    fi
    if [ ! -d "$repo_path" ]; then
      repo_path=$(registered_repo_path "$github_repo")
    fi
    repo_root=$("$GIT_BIN" -C "$repo_path" rev-parse --show-toplevel 2>/dev/null) || \
      fail "repository path is not a Git repository: $repo_path"
    verify_github_origin "$repo_root" "$github_repo"

    "$GIT_BIN" check-ref-format --branch "$requested_branch" >/dev/null || \
      fail "worktree branch is not valid: $requested_branch"
    if [ -n "$additional_prompt" ]; then
      prompt+=$'\n\nAdditional session content:\n'
      prompt+=$additional_prompt
    fi
    resume_existing github "$title" "$repo_root" "$requested_branch" "$prompt"
    if pr_info=$(cd "$repo_root" && "$GH_BIN" pr view "$reference" --json number,headRefName,headRepositoryOwner,headRepository --jq '[.number, .headRefName, .headRepositoryOwner.login, .headRepository.name] | @tsv' 2>/dev/null); then
      IFS=$'\t' read -r pr_number head_branch head_owner head_repo <<<"$pr_info"
      if ! [[ "$pr_number" =~ ^[0-9]+$ && -n "$head_branch" && -n "$head_owner" && -n "$head_repo" ]]; then
        fail "pull request metadata is incomplete for: $reference"
      fi
      "$GIT_BIN" check-ref-format --branch "$head_branch" >/dev/null || \
        fail "pull request head is not a valid branch: $head_branch"
      pr_ref="refs/remotes/origin/attention-pr-$pr_number"
      head_remote="https://github.com/$head_owner/$head_repo.git"
      "$GIT_BIN" -C "$repo_root" fetch --no-tags "$head_remote" \
        "+refs/heads/$head_branch:$pr_ref" || \
        fail "cannot fetch pull request head: $reference"
      head_sha=$("$GIT_BIN" -C "$repo_root" rev-parse "$pr_ref")
      if "$GIT_BIN" -C "$repo_root" show-ref --verify --quiet "refs/heads/$requested_branch"; then
        existing_sha=$("$GIT_BIN" -C "$repo_root" rev-parse "refs/heads/$requested_branch")
        [ "$existing_sha" = "$head_sha" ] || \
          fail "existing worktree branch does not point to pull request head: $requested_branch"
      else
        "$GIT_BIN" -C "$repo_root" branch "$requested_branch" "$pr_ref" || \
          fail "cannot create worktree branch: $requested_branch"
      fi
      worktree_branch=$requested_branch
      new_branch=false
    else
      (cd "$repo_root" && "$GH_BIN" issue view "$reference" --json number --jq .number >/dev/null) || \
        fail "reference is not an accessible GitHub issue or pull request: $reference"
      worktree_branch=$requested_branch
      new_branch=true
    fi

    AOE_WORKTREE_BRANCH="$worktree_branch" AOE_NEW_BRANCH="$new_branch" \
      dispatch "$title" "$prompt" "$repo_root"
    ;;
  *)
    usage
    ;;
esac
