{{- /* linear-tui (roeyazroel/linear-tui) reads its config from ~/.linear-tui/config.json.
       default_team scopes the dashboard to the org whose issue tracker is Linear, rather
       than opening the unscoped "All Issues" view. Sorting/filtering have no config-file
       equivalent in this tool (v0.10.0) — they're runtime-only via the `:` command palette. */ -}}
{{- $linearTeam := "" -}}
{{- range $org := .orgs -}}
  {{- if and (eq (index $org "issues") "linear") (not $linearTeam) -}}
    {{- $linearTeam = index $org "linear_team" -}}
  {{- end -}}
{{- end -}}
{
  "api_endpoint": "https://api.linear.app/graphql",
  "timeout": "30s",
  "page_size": 50,
  "cache_ttl": "5m0s",
  "search_debounce": "300ms",
  "log_file": {{ printf "%s/.linear-tui/app.log" .chezmoi.homeDir | quote }},
  "log_level": "warning",
  "theme": "linear",
  "density": "comfortable",
  "agent_provider": "cursor",
  "agent_sandbox": "enabled",
  "agent_model": "",
  "agent_workspace": "",
  "default_team": {{ $linearTeam | quote }},
  "default_project": ""
}
