{{- $agentMaxTokens := (index .local_model "agent_max_tokens") | default (index .local_model "max_tokens") | default 4096 -}}
providers:
  openrouter:
    baseUrl: https://openrouter.ai/api/v1
    api: openai-completions
    apiKey: {{ env "OPENROUTER_API_KEY" | default "" }}
    compat:
      supportsDeveloperRole: false
      supportsReasoningEffort: true
    models:
      - id: openrouter/free
        name: openrouter/free
        reasoning: false
        input: [text]
        contextWindow: 131072
        maxTokens: 8192
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
{{- if hasKey . "local_model" }}
  {{ (index .local_model "provider") | default "mlx" }}:
    baseUrl: http://{{ (index .local_model "host") | default "127.0.0.1" }}:{{ (index .local_model "port") | default 8091 }}/v1
    api: {{ (index .local_model "api") | default "openai-completions" }}
    apiKey: {{ if hasKey .local_model "api_key" }}{{ .local_model.api_key }}{{ else if eq ((index .local_model "server") | default "mlx-lm") "optiq" }}sk-optiq-local{{ else }}mlx-local{{ end }}
    compat:
      supportsDeveloperRole: false
      supportsReasoningEffort: false
    models:
      - id: {{ (index .local_model "id") | default "default_model" }}
        name: {{ .local_model.name }}
        reasoning: true
        input: [text]
        contextWindow: {{ .local_model.context_window }}
        maxTokens: {{ $agentMaxTokens }}
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
{{- if hasKey .local_model "compaction_model" }}
        compactionModel: {{ .local_model.compaction_model }}
{{- end }}
{{- end }}
