{{- $localModel := dict -}}
{{- if hasKey . "local_model" -}}
{{- $localModel = .local_model -}}
{{- end -}}
{{- $agentMaxTokens := (index $localModel "agent_max_tokens") | default (index $localModel "max_tokens") | default 4096 -}}
{{- $openRouterKeychainKey := output "/bin/sh" "-c" "security find-generic-password -s chezmoi -a openrouter_api_key -w 2>/dev/null || true" | trim -}}
{{- $openRouterEnvKey := env "OPENROUTER_API_KEY" -}}
{{- $openRouterLocalKey := index . "openrouter_api_key" | default "" -}}
{{- $openRouterApiKey := $openRouterEnvKey | default $openRouterKeychainKey | default $openRouterLocalKey -}}
{{- if or $openRouterApiKey (hasKey . "local_model") }}
providers:
{{- if $openRouterApiKey }}
  openrouter:
    baseUrl: https://openrouter.ai/api/v1
    api: openai-completions
    apiKey: {{ $openRouterApiKey | quote }}
    compat:
      supportsDeveloperRole: false
      supportsReasoningEffort: true
    models:
      - id: openrouter/free
        name: openrouter/free
        reasoning: false
        input: [text]
        contextWindow: 131072
        maxTokens: 8192
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
{{- end }}
{{- if hasKey . "local_model" }}
  {{ (index $localModel "provider") | default "mlx" }}:
    baseUrl: http://{{ (index $localModel "host") | default "127.0.0.1" }}:{{ (index $localModel "port") | default 8091 }}/v1
    api: {{ (index $localModel "api") | default "openai-completions" }}
    apiKey: {{ if hasKey $localModel "api_key" }}{{ $localModel.api_key }}{{ else if eq ((index $localModel "server") | default "mlx-lm") "optiq" }}sk-optiq-local{{ else }}mlx-local{{ end }}
    compat:
      supportsDeveloperRole: false
      supportsReasoningEffort: false
    models:
      - id: {{ (index $localModel "id") | default "default_model" }}
        name: {{ $localModel.name }}
        reasoning: true
        input: [text]
        contextWindow: {{ $localModel.context_window }}
        maxTokens: {{ $agentMaxTokens }}
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
{{- if hasKey $localModel "compaction_model" }}
        compactionModel: {{ $localModel.compaction_model }}
{{- end }}
{{- end }}
{{- end }}
